---
import ParentCounselingService from "../components/services/ParentCounselingService.astro";
import BottomNav from "../components/layout/BottomNav.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../components/home/Contact.astro";
---

<Layout
    seoTitle="Asesoramiento para padres en Castellón | PsicoInfantil"
    image="/og/asesoramiento_padres.jpg"
    imageAlt="Asesoramiento a padres y familias en PsicoInfantil Castellón"
    title="Asesoramiento a Padres en Castellón | PsicoInfantil Castellón"
    description="Orientación cercana y pautas para padres en Castellón. Disciplina positiva, gestión de normas y límites, resolución de conflictos y calma familiar."
>
    <Header />
    <MobileMenu />
    <ParentCounselingService />
    <Contact servicio="Asesoramiento a padres" heading="¿Necesitáis pautas para afrontar el día a día en familia?" />
    <Footer />
    <BottomNav />
</Layout>
