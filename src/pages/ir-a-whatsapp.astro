---
import { whatsappDestination } from "../data/contact-links";
---

<!-- Redirección estática sin Layout, Analytics, cookies ni parámetros del visitante. -->
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="referrer" content="no-referrer" />
        <meta http-equiv="refresh" content={`0;url=${whatsappDestination}`} />
        <title>Continuar en WhatsApp</title>
    </head>
    <body>
        <a href={whatsappDestination} rel="noreferrer">Continuar en WhatsApp</a>
    </body>
</html>
