---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import Hero from "../components/home/Hero.astro";
import Problems from "../components/home/Problems.astro";
import Process from "../components/home/Process.astro";
import Services from "../components/home/Services.astro";
import About from "../components/home/About.astro";
import Reviews from "../components/home/Reviews.astro";
import FAQ from "../components/home/FAQ.astro";
import BlogSection from "../components/blog/BlogSection.astro";
import Contact from "../components/home/Contact.astro";
import ContactMap from "../components/contact/ContactMap.astro";
import Footer from "../components/layout/Footer.astro";
import BottomNav from "../components/layout/BottomNav.astro";
import { homeSchema } from "../data/home-schema";
---

<Layout
	seoTitle="Psicóloga infantil en Castellón | Ana Díaz Berbel"
	title="Psicóloga infantil y juvenil en Castellón | Ana Díaz Berbel"
	description="Ana Díaz Berbel, psicóloga infantil y juvenil en Castellón con más de 20 años de experiencia. Evaluación y orientación para niños, adolescentes y familias."
	image="/og/home.jpg"
	imageAlt="PsicoInfantil Castellón: psicología infantil y juvenil en Castellón"
	jsonLd={homeSchema}
>
	<Header />
	<MobileMenu />
	<main class="site-main">
		<Hero />
		<Problems />
		<Process />
		<Services />
		<BlogSection />
		<About />
		<Reviews />
		<FAQ />
		<ContactMap />
		<Contact />
	</main>
	<Footer />
	<BottomNav />
</Layout>
