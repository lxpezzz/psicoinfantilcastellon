---
import ChildhoodEmotionsService from "../components/services/ChildhoodEmotionsService.astro";
import BottomNav from "../components/layout/BottomNav.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import Layout from "../layouts/Layout.astro";
import Contact from "../components/home/Contact.astro";
import { getServiceSchema } from "../data/service-schema";
import { siteUrl } from "../data/site.mjs";

const seoTitle = "Miedos, rabietas y sueño infantil en Castellón | PsicoInfantil";
const serviceSchema = getServiceSchema(Astro.url.pathname);
const jsonLd = {
    ...serviceSchema,
    "@graph": [
        ...serviceSchema["@graph"],
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", siteUrl).href },
                { "@type": "ListItem", position: 2, name: "Servicios", item: new URL("/#servicios", siteUrl).href },
                { "@type": "ListItem", position: 3, name: "Psicología infantil", item: new URL("/emociones-y-habitos-infantiles/", siteUrl).href },
            ],
        },
    ],
};
---

<Layout
    jsonLd={jsonLd}
    seoTitle={seoTitle}
    title={seoTitle}
    image="/og/emociones_habitos_infantiles.jpg"
    imageAlt="Una adulta abraza a dos niños en un sofá junto a una ventana"
    description="Acompañamiento psicológico infantil en Castellón ante miedos, rabietas, dificultades de sueño y hábitos cotidianos. Orientación adaptada a cada familia."
>
    <Header />
    <MobileMenu />
    <ChildhoodEmotionsService />
    <Contact servicio="Psicología infantil: emociones y hábitos" heading="Hablemos de lo que os preocupa" />
    <Footer />
    <BottomNav />
</Layout>

<style>
    :global(#contacto) {
        scroll-margin-top: 104px;
    }
</style>
