---
import {
    Cookie,
    ShieldCheck,
    SlidersHorizontal,
    CheckCircle2,
    ExternalLink,
    Lock,
    Info,
    Phone,
    Mail,
} from "lucide-astro";
---

<article class="pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(4rem,7vw,6.5rem)] bg-[var(--color-bg)] text-[var(--color-text)]">
    <div class="section-container">
        <!-- 1. Cabecera Hero con Breadcrumbs y Título -->
        <header class="max-w-[860px] mx-auto text-center max-sm:text-left mb-[clamp(3rem,5vw,4.5rem)]">
            <nav class="inline-flex items-center gap-2 text-[0.85rem] text-[var(--color-text-soft)] mb-6" aria-label="Miga de pan">
                <a href="/" class="text-[var(--color-primary)] no-underline hover:text-[var(--color-primary-dark)] hover:underline transition-colors">
                    Inicio
                </a>
                <span class="opacity-40" aria-hidden="true">/</span>
                <span class="font-semibold text-[var(--color-primary-dark)]" aria-current="page">
                    Política de Cookies
                </span>
            </nav>

            <h1 class="text-[clamp(2.35rem,4.5vw,3.5rem)] font-extrabold leading-[1.1] tracking-[-0.035em] text-[var(--color-primary-dark)] m-0 mb-5 [text-wrap:balance]">
                Política de Cookies
            </h1>

            <p class="text-[clamp(1.05rem,1.3vw,1.2rem)] leading-[1.7] text-[var(--color-text-soft)] m-0 mb-8 [text-wrap:pretty]">
                En <strong class="text-[var(--color-primary-dark)] font-semibold">PsicoInfantil Castellón</strong> entendemos que la confianza de las familias comienza por el respeto más riguroso a su intimidad. Te explicamos de forma transparente, cercana y sin tecnicismos innecesarios qué cookies utilizamos, con qué finalidad y cómo puedes administrarlas libremente.
            </p>

            <div class="flex flex-wrap items-center justify-center max-sm:items-start max-sm:flex-col gap-3 sm:gap-6 py-3.5 px-6 bg-white/70 backdrop-blur-[8px] border border-[rgba(23,54,97,0.07)] rounded-full max-sm:rounded-2xl text-[0.82rem] text-[var(--color-text-soft)] w-fit mx-auto max-sm:w-full">
                <span class="inline-flex items-center gap-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
                    Última actualización: Noviembre de 2026
                </span>
                <span class="inline-flex items-center gap-2 font-medium">
                    <Lock size={14} aria-hidden="true" />
                    Conforme a RGPD (UE 2016/679) y LSSI-CE
                </span>
                <span class="inline-flex items-center gap-2 font-medium">
                    <ShieldCheck size={14} aria-hidden="true" />
                    Sin publicidad invasiva ni venta de datos
                </span>
            </div>
        </header>

        <!-- 2. Bento de Resumen: Claves de un vistazo -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]" aria-label="Aspectos esenciales de nuestra política">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Tarjeta 1: Highlight -->
                <div class="bg-gradient-to-br from-white to-[#f4f8fc] border border-[rgba(36,79,158,0.16)] rounded-[1.4rem] p-7 sm:p-8 shadow-[0_8px_24px_rgba(23,54,97,0.04)] hover:shadow-[0_12px_32px_rgba(23,54,97,0.07)] hover:-translate-y-0.5 transition-all flex flex-col gap-3.5">
                    <div class="w-[46px] h-[46px] rounded-xl bg-[rgba(36,79,158,0.07)] flex items-center justify-center text-[var(--color-primary)] mb-1">
                        <Cookie size={22} />
                    </div>
                    <h2 class="text-[1.2rem] font-[750] text-[var(--color-primary-dark)] m-0 leading-snug">
                        ¿Qué es una cookie?
                    </h2>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Es un pequeño fichero que se almacena en tu navegador al visitar una web. Puede recordar preferencias o, si lo autorizas, ayudar a elaborar estadísticas de uso. No es un programa ejecutable ni accede a tus archivos personales.
                    </p>
                </div>

                <!-- Tarjeta 2 -->
                <div class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.4rem] p-7 sm:p-8 shadow-[0_8px_24px_rgba(23,54,97,0.04)] hover:shadow-[0_12px_32px_rgba(23,54,97,0.07)] hover:-translate-y-0.5 transition-all flex flex-col gap-3.5">
                    <div class="w-[46px] h-[46px] rounded-xl bg-[rgba(36,79,158,0.07)] flex items-center justify-center text-[var(--color-primary)] mb-1">
                        <ShieldCheck size={22} />
                    </div>
                    <h2 class="text-[1.2rem] font-[750] text-[var(--color-primary-dark)] m-0 leading-snug">
                        Privacidad en consulta y web
                    </h2>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Como consulta de psicología infantil y juvenil, el secreto profesional y la protección del menor son pilares inviolables. <strong class="text-[var(--color-primary-dark)]">Nunca</strong> registramos historiales clínicos, motivos de consulta, evaluaciones diagnósticas ni datos de menores a través de cookies.
                    </p>
                </div>

                <!-- Tarjeta 3 -->
                <div class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.4rem] p-7 sm:p-8 shadow-[0_8px_24px_rgba(23,54,97,0.04)] hover:shadow-[0_12px_32px_rgba(23,54,97,0.07)] hover:-translate-y-0.5 transition-all flex flex-col gap-3.5">
                    <div class="w-[46px] h-[46px] rounded-xl bg-[rgba(36,79,158,0.07)] flex items-center justify-center text-[var(--color-primary)] mb-1">
                        <SlidersHorizontal size={22} />
                    </div>
                    <h2 class="text-[1.2rem] font-[750] text-[var(--color-primary-dark)] m-0 leading-snug">
                        Control total en tu mano
                    </h2>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Tú decides en todo momento. Puedes permitir, restringir o eliminar las cookies en cualquier instante desde las opciones de tu navegador web o rechazar las analíticas no esenciales sin perder acceso a ninguno de nuestros contenidos informativos ni de contacto.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Inventario detallado de Cookies -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]" aria-labelledby="inventory-heading">
            <div class="text-center max-w-[780px] mx-auto mb-[clamp(2rem,4vw,3rem)]">
                <h2 id="inventory-heading" class="text-[clamp(1.85rem,3.2vw,2.6rem)] font-extrabold text-[var(--color-primary-dark)] leading-[1.18] tracking-[-0.03em] m-0 mb-3.5 [text-wrap:balance]">
                    ¿Qué cookies utiliza este sitio web?
                </h2>
                <p class="text-[clamp(0.96rem,1.1vw,1.05rem)] leading-[1.65] text-[var(--color-text-soft)] m-0 [text-wrap:pretty]">
                    Clasificamos las cookies según su finalidad para que conozcas con exactitud quién las emite, cuánto tiempo permanecen y cuál es su función técnica.
                </p>
            </div>

            <!-- Bloque 1: Cookies Técnicas y Necesarias -->
            <div class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.5rem] p-[clamp(1.25rem,3.5vw,2.5rem)] shadow-[0_8px_26px_rgba(23,54,97,0.035)] mb-8">
                <div class="mb-7">
                    <div class="flex flex-wrap items-center gap-3 mb-2.5">
                        <span class="inline-block text-[0.72rem] font-[750] uppercase tracking-[0.05em] py-1 px-2.5 rounded-full bg-[rgba(36,79,158,0.09)] text-[var(--color-primary)]">
                            Siempre activas
                        </span>
                        <h3 class="text-[1.3rem] font-[750] text-[var(--color-primary-dark)] m-0">
                            1. Almacenamiento técnico de preferencias
                        </h3>
                    </div>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Guardamos tu elección en el almacenamiento local de tu navegador (localStorage), no en una cookie. Esta preferencia permite recordar si autorizas la analítica y no se envía a Google. Si el navegador bloquea este almacenamiento, la elección solo se conserva en la página actual.
                    </p>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-[rgba(23,54,97,0.07)]">
                    <table class="w-full border-collapse text-left text-[0.88rem]">
                        <thead class="bg-slate-50 text-[var(--color-primary-dark)] font-bold border-b border-[rgba(23,54,97,0.08)] whitespace-nowrap">
                            <tr>
                                <th scope="col" class="py-3.5 px-4.5">Cookie</th>
                                <th scope="col" class="py-3.5 px-4.5">Titular</th>
                                <th scope="col" class="py-3.5 px-4.5">Finalidad</th>
                                <th scope="col" class="py-3.5 px-4.5">Duración</th>
                                <th scope="col" class="py-3.5 px-4.5">Tipo</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[rgba(23,54,97,0.05)]">
                            <tr class="hover:bg-[rgba(36,79,158,0.02)] transition-colors">
                                <td class="py-4 px-4.5 align-top">
                                    <code class="font-mono text-[0.84rem] bg-[rgba(23,54,97,0.05)] text-[var(--color-primary-dark)] py-0.5 px-2 rounded-md font-semibold">
                                        psico_cookie_consent<br />psico_cookie_consent_updated_at
                                    </code>
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)]">PsicoInfantil (Propia)</td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] leading-relaxed">
                                    Recuerda la aceptación o el rechazo y la fecha de tu elección. Transcurridos 180 días desde la fecha guardada volvemos a solicitarla. Las elecciones del banner anterior sin fecha se conservan por compatibilidad; la fecha se guarda cuando cambias tu elección, no por visitar la web.
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] whitespace-nowrap">180 días</td>
                                <td class="py-4 px-4.5 align-top">
                                    <span class="inline-block text-[0.74rem] font-semibold py-0.5 px-2.5 rounded-md bg-[rgba(23,54,97,0.06)] text-[var(--color-primary-dark)] whitespace-nowrap">
                                        Técnica
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bloque 2: Cookies de Rendimiento y Analítica -->
            <div class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.5rem] p-[clamp(1.25rem,3.5vw,2.5rem)] shadow-[0_8px_26px_rgba(23,54,97,0.035)] mb-8">
                <div class="mb-7">
                    <div class="flex flex-wrap items-center gap-3 mb-2.5">
                        <span class="inline-block text-[0.72rem] font-[750] uppercase tracking-[0.05em] py-1 px-2.5 rounded-full bg-[rgba(141,199,168,0.2)] text-[#1e6e4a]">
                            Solo con tu permiso
                        </span>
                        <h3 class="text-[1.3rem] font-[750] text-[var(--color-primary-dark)] m-0">
                            2. Cookies analíticas y de rendimiento
                        </h3>
                    </div>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Google Analytics 4 (GA4) permite medir visitas, desplazamientos y clics en enlaces de salida revisados, además de clics de contacto por WhatsApp o teléfono y confirmaciones de envío del formulario. Utilizamos Consent Mode v2 básico: la etiqueta de Google no se descarga ni transmite datos de Analytics antes de aceptar las cookies analíticas. Al rechazar las opcionales no se activa GA4. La publicidad y la personalización publicitaria permanecen desactivadas.
                    </p>
                    <!-- Pendiente de validación legal por la responsable: proveedor, garantías y plazos de conservación. -->
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] mt-4 mb-0">
                        Los eventos se limitan a páginas públicas y acciones genéricas. No enviamos campos del formulario, teléfonos, mensajes, datos sobre menores ni motivos de consulta. La URL de página se envía sin parámetros ni fragmentos y se suprime el enlace de procedencia. Los enlaces de salida medidos se limitan a destinos públicos revisados, incluidos sus parámetros fijos de idioma o identificación de la consulta; WhatsApp utiliza un salto local sin Analytics para no enviar su número. No se miden búsquedas, vídeos, descargas ni interacciones automáticas con formularios. Los identificadores de Analytics son seudónimos; esto no equivale a una anonimización completa. Google recibe datos técnicos de la conexión, incluida la dirección IP, aunque GA4 no registra ni almacena direcciones IP individuales, según su documentación.
                    </p>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] mt-4 mb-0">
                        El proveedor es Google Ireland Limited. Se obtiene información de ubicación aproximada y características del dispositivo y navegador, sin solicitar la ubicación precisa. Google Signals y la recopilación de datos proporcionados por usuarios están desactivados. La base del tratamiento es tu consentimiento (art. 6.1.a RGPD). Los plazos de las cookies indicados abajo no son los plazos de conservación en los servidores de Google. Puedes consultar la información sobre conservación, transferencias internacionales y ejercicio de derechos en nuestra <a href="/politica-de-privacidad/" class="text-[var(--color-primary)] underline font-medium">Política de Privacidad</a>.
                    </p>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-[rgba(23,54,97,0.07)]">
                    <table class="w-full border-collapse text-left text-[0.88rem]">
                        <thead class="bg-slate-50 text-[var(--color-primary-dark)] font-bold border-b border-[rgba(23,54,97,0.08)] whitespace-nowrap">
                            <tr>
                                <th scope="col" class="py-3.5 px-4.5">Cookie</th>
                                <th scope="col" class="py-3.5 px-4.5">Titular</th>
                                <th scope="col" class="py-3.5 px-4.5">Finalidad</th>
                                <th scope="col" class="py-3.5 px-4.5">Duración</th>
                                <th scope="col" class="py-3.5 px-4.5">Tipo</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[rgba(23,54,97,0.05)]">
                            <tr class="hover:bg-[rgba(36,79,158,0.02)] transition-colors">
                                <td class="py-4 px-4.5 align-top">
                                    <code class="font-mono text-[0.84rem] bg-[rgba(23,54,97,0.05)] text-[var(--color-primary-dark)] py-0.5 px-2 rounded-md font-semibold">
                                        _ga
                                    </code>
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)]">Google Analytics (Google Ireland Ltd.)</td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] leading-relaxed">
                                    Identificador seudónimo del navegador para distinguir visitas. Solo se instala tras aceptar la analítica.
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] whitespace-nowrap">Hasta 180 días</td>
                                <td class="py-4 px-4.5 align-top">
                                    <span class="inline-block text-[0.74rem] font-semibold py-0.5 px-2.5 rounded-md bg-[rgba(141,199,168,0.2)] text-[#1e6e4a] whitespace-nowrap">
                                        Analítica
                                    </span>
                                </td>
                            </tr>
                            <tr class="hover:bg-[rgba(36,79,158,0.02)] transition-colors">
                                <td class="py-4 px-4.5 align-top">
                                    <code class="font-mono text-[0.84rem] bg-[rgba(23,54,97,0.05)] text-[var(--color-primary-dark)] py-0.5 px-2 rounded-md font-semibold">
                                        _ga_*
                                    </code>
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)]">Google Analytics (Google Ireland Ltd.)</td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] leading-relaxed">
                                    Conserva el estado de la sesión de GA4. No incluye el contenido de los formularios ni de las conversaciones de contacto.
                                </td>
                                <td class="py-4 px-4.5 align-top text-[var(--color-text)] whitespace-nowrap">Hasta 180 días</td>
                                <td class="py-4 px-4.5 align-top">
                                    <span class="inline-block text-[0.74rem] font-semibold py-0.5 px-2.5 rounded-md bg-[rgba(141,199,168,0.2)] text-[#1e6e4a] whitespace-nowrap">
                                        Analítica
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bloque 3: Servicios Externos Interactivos -->
            <div class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.5rem] p-[clamp(1.25rem,3.5vw,2.5rem)] shadow-[0_8px_26px_rgba(23,54,97,0.035)]">
                <div class="mb-6">
                    <div class="flex flex-wrap items-center gap-3 mb-2.5">
                        <span class="inline-block text-[0.72rem] font-[750] uppercase tracking-[0.05em] py-1 px-2.5 rounded-full bg-[rgba(223,162,170,0.25)] text-[#8c3b47]">
                            Servicios de terceros
                        </span>
                        <h3 class="text-[1.3rem] font-[750] text-[var(--color-primary-dark)] m-0">
                            3. Herramientas externas integradas
                        </h3>
                    </div>
                    <p class="text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] m-0">
                        Para ofrecerte la máxima facilidad al contactar o ubicar la consulta presencial en Castellón de la Plana, integramos enlaces a plataformas externas reconocidas:
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="bg-[#fbfbfd] border border-[rgba(23,54,97,0.06)] rounded-2xl p-5 sm:p-6">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[1.02rem] font-bold text-[var(--color-primary-dark)]">Google Maps</span>
                            <span class="inline-block text-[0.74rem] font-semibold py-0.5 px-2.5 rounded-md bg-[rgba(23,54,97,0.06)] text-[var(--color-primary-dark)]">
                                Ubicación
                            </span>
                        </div>
                        <p class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0">
                            El mapa no se conecta con Google hasta que pulsas «Autorizar y cargar Google Maps». Es un permiso independiente de la analítica, limitado a la página actual; aceptar las cookies estadísticas no carga el mapa. Al autorizarlo, Google recibe datos de conexión, incluida tu IP, y puede utilizar cookies según su <a href="https://policies.google.com/privacy?hl=es" class="text-[var(--color-primary)] underline font-medium">Política de privacidad</a>. Puedes retirar el permiso con «Desactivar mapa» o «Rechazar opcionales» desde «Configurar cookies». Se retira el iframe, pero no se borran datos ya enviados ni cookies de Google, que puedes gestionar en tu navegador. La dirección y el enlace externo «Cómo llegar» siguen disponibles sin cargar el mapa. Las cookies de terceros, sus finalidades y duración pueden variar según tu sesión de Google y tu navegador; su inventario efectivo requiere comprobación antes de publicar.
                        </p>
                    </div>

                    <div class="bg-[#fbfbfd] border border-[rgba(23,54,97,0.06)] rounded-2xl p-5 sm:p-6">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[1.02rem] font-bold text-[var(--color-primary-dark)]">WhatsApp Directo</span>
                            <span class="inline-block text-[0.74rem] font-semibold py-0.5 px-2.5 rounded-md bg-[rgba(23,54,97,0.06)] text-[var(--color-primary-dark)]">
                                Contacto
                            </span>
                        </div>
                        <p class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0">
                            Facilita escribirnos por WhatsApp con un solo clic. El enlace te redirige a los servidores seguros de WhatsApp (Meta Platforms), sin instalar cookies en tu navegador hasta que tú decides acceder voluntariamente a la aplicación.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. Compromiso Ético: Lo que NUNCA hacemos -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]" aria-labelledby="ethics-heading">
            <div class="bg-[var(--color-primary-dark)] rounded-[1.75rem] p-[clamp(2rem,5vw,3.5rem)] text-white shadow-[0_16px_40px_rgba(23,54,97,0.15)]">
                <div class="mb-8">
                    <span class="inline-block text-[0.76rem] font-[750] uppercase tracking-[0.08em] bg-[rgba(223,162,170,0.2)] text-[#dfa2aa] py-1.5 px-3.5 rounded-full mb-3.5">
                        Compromiso Deontológico
                    </span>
                    <h2 id="ethics-heading" class="text-[clamp(1.75rem,3vw,2.35rem)] font-extrabold leading-[1.15] tracking-[-0.03em] text-white m-0 mb-3.5">
                        Lo que NUNCA hacemos con las cookies
                    </h2>
                    <p class="text-[1rem] leading-[1.65] text-[#d1dced] max-w-[680px] m-0">
                        La psicología infantil y juvenil exige el más riguroso estándar de ética y respeto a la intimidad. En este sitio web no encontrarás prácticas comerciales opacas:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-9 border-t border-white/12 pt-8">
                    <div class="flex gap-4 items-start">
                        <CheckCircle2 size={20} class="text-[var(--color-accent)] shrink-0 mt-0.5" />
                        <div>
                            <strong class="block text-[1.02rem] font-bold text-white mb-1.5">
                                Sin venta de datos personales
                            </strong>
                            <p class="text-[0.88rem] leading-[1.6] text-[#cbd7e6] m-0">
                                No comercializamos tus identificadores de navegación con corredores de información (data brokers) ni plataformas publicitarias.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <CheckCircle2 size={20} class="text-[var(--color-accent)] shrink-0 mt-0.5" />
                        <div>
                            <strong class="block text-[1.02rem] font-bold text-white mb-1.5">
                                Sin publicidad programática ni retargeting
                            </strong>
                            <p class="text-[0.88rem] leading-[1.6] text-[#cbd7e6] m-0">
                                No te perseguiremos con anuncios comerciales ni banners en otras webs tras consultar nuestros servicios o artículos.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <CheckCircle2 size={20} class="text-[var(--color-accent)] shrink-0 mt-0.5" />
                        <div>
                            <strong class="block text-[1.02rem] font-bold text-white mb-1.5">
                                Protección reforzada para la infancia
                            </strong>
                            <p class="text-[0.88rem] leading-[1.6] text-[#cbd7e6] m-0">
                                Jamás elaboramos perfiles conductuales ni comerciales sobre menores de edad en ninguna circunstancia.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
