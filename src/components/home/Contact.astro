---
import { MapPin, Phone } from "lucide-astro";
---

<section class="contact" id="contacto">
    <div class="contact__container">
        <div class="contact__grid">
            <div class="contact__info">
                <p class="contact__eyebrow">Contacto</p>
                <h2 class="contact__title">Pide tu primera consulta</h2>
                <p class="contact__desc">
                    Cuéntame brevemente qué está ocurriendo y me pondré en contacto contigo para valorar cómo enfocar el caso.
                </p>

                <div class="contact__channels">
                    <a href="tel:+34614992148" class="contact__channel">
                        <div class="contact__channel-icon" aria-hidden="true">
                            <Phone size={20} />
                        </div>
                        <div class="contact__channel-text">
                            <span class="contact__channel-label">Teléfono / WhatsApp</span>
                            <span class="contact__channel-value">614 99 21 48</span>
                        </div>
                    </a>

                    <div class="contact__channel">
                        <div class="contact__channel-icon" aria-hidden="true">
                            <MapPin size={20} />
                        </div>
                        <div class="contact__channel-text">
                            <span class="contact__channel-label">Consulta</span>
                            <span class="contact__channel-value">Castellón de la Plana</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact__card">
                <form class="contact__form" action="https://formspree.io/f/placeholder" method="POST">
                    <div class="contact__field">
                        <label for="contact-name">Nombre de los padres o tutor</label>
                        <input type="text" id="contact-name" name="name" required placeholder="Tu nombre y apellidos" />
                    </div>

                    <div class="contact__row">
                        <div class="contact__field">
                            <label for="contact-phone">Teléfono de contacto</label>
                            <input type="tel" id="contact-phone" name="phone" required placeholder="614 00 00 00" />
                        </div>
                        <div class="contact__field">
                            <label for="contact-age">Edad del hijo/a</label>
                            <input type="text" id="contact-age" name="age" placeholder="Ej: 9 años" />
                        </div>
                    </div>

                    <div class="contact__field">
                        <label for="contact-message">¿Qué os preocupa o qué necesitáis?</label>
                        <textarea id="contact-message" name="message" rows="4" required placeholder="Cuéntame brevemente qué dificultades estáis detectando..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary contact__submit">
                        Enviar mensaje y pedir cita
                    </button>

                    <p class="contact__privacy-note">
                        Tus datos se tratan con estricta confidencialidad médica y profesional.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    .contact {
        padding-block: clamp(5rem, 8vw, 7.5rem);
        background-color: #ffffff;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
    }

    .contact__container {
        width: min(100% - 2.5rem, 1220px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: minmax(320px, 5fr) minmax(380px, 7fr);
        gap: clamp(2.5rem, 5vw, 5rem);
        align-items: start;
    }

    .contact__info {
        display: flex;
        flex-direction: column;
    }

    .contact__eyebrow {
        margin: 0 0 0.85rem;
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .contact__title {
        margin: 0 0 1rem;
        color: var(--color-primary-dark);
        font-size: clamp(2.1rem, 3.5vw, 2.9rem);
        font-weight: 750;
        line-height: 1.15;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .contact__desc {
        margin: 0 0 2rem;
        color: var(--color-text-soft);
        font-size: clamp(1rem, 1.15vw, 1.12rem);
        line-height: 1.65;
        text-wrap: pretty;
    }

    .contact__channels {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contact__channel {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: #f7f6f2;
        border: 1px solid rgba(23, 54, 97, 0.08);
        border-radius: 1rem;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .contact__channel:hover {
        border-color: rgba(36, 79, 158, 0.2);
        transform: translateY(-2px);
    }

    .contact__channel-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-primary-dark);
        color: #ffffff;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .contact__channel-text {
        display: flex;
        flex-direction: column;
    }

    .contact__channel-label {
        font-size: 0.78rem;
        color: var(--color-text-soft);
        font-weight: 500;
    }

    .contact__channel-value {
        font-size: 1.05rem;
        color: var(--color-primary-dark);
        font-weight: 700;
    }

    .contact__card {
        background: #faf9f6;
        border: 1px solid rgba(23, 54, 97, 0.09);
        border-radius: 1.5rem;
        padding: clamp(1.75rem, 3.5vw, 2.75rem);
        box-shadow: 0 12px 36px rgba(23, 54, 97, 0.04);
    }

    .contact__form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .contact__row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .contact__field {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .contact__field label {
        font-size: 0.88rem;
        font-weight: 650;
        color: var(--color-primary-dark);
    }

    .contact__field input,
    .contact__field textarea {
        width: 100%;
        padding: 0.8rem 1rem;
        border-radius: 0.65rem;
        border: 1px solid rgba(23, 54, 97, 0.15);
        background: #ffffff;
        font-size: 0.96rem;
        color: var(--color-text);
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .contact__field input:focus,
    .contact__field textarea:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(45, 121, 199, 0.18);
    }

    .contact__submit {
        width: 100%;
        min-height: 50px;
        font-size: 1.02rem;
        font-weight: 700;
        border-radius: 0.75rem;
    }

    .contact__privacy-note {
        margin: 0;
        font-size: 0.78rem;
        color: var(--color-text-soft);
        text-align: center;
        line-height: 1.4;
    }

    @media (max-width: 900px) {
        .contact__grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .contact__row {
            grid-template-columns: 1fr;
        }
    }
</style>
