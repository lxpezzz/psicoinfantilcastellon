---
import { Image } from "astro:assets";
import { ArrowRight, Check, Phone } from "lucide-astro";
import cuadroContacto from "../../images/contact/cuadro_contacto.webp";

const labelClass = "text-[0.88rem] font-[650] text-[var(--color-primary-dark)]";

const inputClass =
    "w-full box-border min-h-[48px] px-4 py-[0.78rem] rounded-[0.75rem] border border-[rgba(23,54,97,0.14)] bg-[#fbfaf7] text-[var(--color-text)] text-base min-[821px]:text-[0.96rem] font-inherit placeholder:text-[#8b99aa] placeholder:text-[0.92rem] transition-[border-color,box-shadow,background-color] duration-200 hover:border-[rgba(36,79,158,0.3)] focus:outline-none focus:bg-white focus:border-[var(--color-primary)] focus:ring-[3px] focus:ring-[rgba(36,79,158,0.14)]";
---

<section
    class="relative overflow-x-clip bg-[#faf9f5] border-t border-[rgba(23,54,97,0.08)] py-[clamp(3.75rem,8vw,4.75rem)] min-[821px]:py-[clamp(4.5rem,7.5vw,6.75rem)]"
    id="contacto"
    aria-labelledby="contact-heading"
>
    <div
        class="w-[min(100%-2rem,100%)] max-[400px]:px-1 px-2 min-[821px]:w-[min(100%-2.5rem,1220px)] min-[821px]:px-0 mx-auto box-border"
    >
        <!-- Layout Principal: 42% Izquierda / 58% Derecha en Desktop -->
        <div
            class="flex flex-col gap-[2.75rem] min-[821px]:grid min-[821px]:items-center min-[821px]:max-[1020px]:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] min-[821px]:max-[1020px]:gap-[2.25rem] min-[1021px]:grid-cols-[minmax(0,4.2fr)_minmax(0,5.8fr)] min-[1021px]:gap-[clamp(2.5rem,5vw,4.75rem)]"
        >
            <!-- Columna Izquierda en Desktop / Posición 5 en Móvil: Fotografía Editorial de Ana -->
            <div
                class="relative w-full flex justify-center order-2 min-[821px]:order-1"
            >
                <div class="contact__portrait-halo" aria-hidden="true"></div>
                <div
                    class="relative z-[1] w-full max-w-[420px] mx-auto rounded-[8px] overflow-hidden shadow-[0_12px_32px_rgb(65_48_30_/_12%)]"
                >
                    <Image
                        src={cuadroContacto}
                        alt="Ana Díaz Berbel junto a sus hijos"
                        class="contact__portrait-img"
                        widths={[320, 420, 640, 840, 1086]}
                        sizes="(max-width: 459px) calc(100vw - 40px), (max-width: 820px) 420px, (max-width: 1020px) calc((100vw - 80px) * 0.4), 420px"
                        loading="lazy"
                    />
                </div>
            </div>

            <!-- Columna Derecha en Desktop / Posiciones 1-4 en Móvil: Encabezado, Formulario y Contacto -->
            <div class="flex flex-col w-full order-1 min-[821px]:order-2">
                <!-- 1 y 2: Titular H2 y Texto -->
                <header class="mb-6 min-[821px]:mb-7 text-left">
                    <h2
                        class="m-0 mb-[0.85rem] text-[var(--color-primary-dark)] font-[750] leading-[1.16] tracking-[-0.035em] [text-wrap:balance] text-[1.7rem] min-[401px]:text-[clamp(1.75rem,6.5vw,2.25rem)] min-[821px]:text-[clamp(1.95rem,3.2vw,2.65rem)]"
                        id="contact-heading"
                    >
                        ¿Te preocupa algo de tu hijo?<br />
                        <span
                            class="block text-[var(--color-primary)] font-bold"
                            >Empecemos por entender qué está pasando.</span
                        >
                    </h2>

                    <p
                        class="m-0 text-[#506176] leading-[1.6] [text-wrap:pretty] max-w-[580px] text-[0.98rem] min-[401px]:text-[clamp(1.02rem,1.2vw,1.12rem)]"
                    >
                        Cuéntame brevemente vuestra situación y me pondré en
                        contacto contigo para valorar cómo puedo ayudaros.
                    </p>
                </header>

                <!-- 3: Formulario -->
                <div
                    class="bg-white border border-[rgba(23,54,97,0.08)] rounded-[1.25rem] min-[821px]:rounded-[1.5rem] shadow-[0_12px_36px_-16px_rgba(23,54,97,0.06)] p-[1.2rem_0.95rem] min-[401px]:p-[1.35rem_1.15rem] min-[821px]:p-[clamp(1.5rem,3.5vw,2.35rem)]"
                >
                    <!-- Banner de Notificación de Error (Redirección desde backend PHP) -->
                    <div
                        id="contact-error"
                        class="contact__error flex items-start gap-[0.85rem] p-4 min-[821px]:p-[1rem_1.25rem] rounded-[0.85rem] bg-[rgba(239,68,68,0.08)] border border-[rgba(239,68,68,0.25)] text-[#991b1b] mb-5"
                        hidden
                        role="alert"
                        aria-live="assertive"
                    >
                        <div
                            class="w-7 h-7 rounded-full bg-[#dc2626] text-white grid place-items-center shrink-0 mt-0.5 text-xs font-bold"
                            aria-hidden="true"
                        >
                            !
                        </div>
                        <div class="text-[0.88rem] leading-[1.45]">
                            <strong
                                class="block mb-[0.2rem] text-[#7f1d1d]"
                                id="contact-error-title"
                                >No se ha podido enviar el mensaje</strong
                            >
                            <p class="m-0" id="contact-error-desc">
                                Por favor, revisa los campos requeridos e inténtalo de nuevo.
                            </p>
                        </div>
                    </div>

                    <noscript>
                        <p class="mb-5 text-[0.88rem] leading-[1.45] text-[#991b1b]">
                            Si has vuelto aquí tras enviar el formulario, revisa los datos e inténtalo de nuevo. Si el problema continúa, llama al 614 99 21 48.
                        </p>
                    </noscript>

                    <form
                        class="flex flex-col gap-[1.15rem]"
                        id="formulario"
                        action="/api/contacto.php"
                        method="POST"
                    >
                        <!-- Campo Honeypot antispam invisible para usuarios humanos -->
                        <div class="contact__honeypot" aria-hidden="true">
                            <label for="contact-empresa">Empresa</label>
                            <input
                                type="text"
                                id="contact-empresa"
                                name="empresa"
                                tabindex="-1"
                                autocomplete="off"
                            />
                        </div>

                        <!-- Nombre y apellidos -->
                        <div class="flex flex-col gap-[0.42rem]">
                            <label for="contact-name" class={labelClass}>
                                Nombre y apellidos
                            </label>
                            <input
                                type="text"
                                id="contact-name"
                                name="nombre"
                                required
                                maxlength="100"
                                autocomplete="name"
                                placeholder="Tu nombre y apellidos"
                                class={inputClass}
                            />
                        </div>

                        <!-- Teléfono y Email en 2 columnas (1 en móvil) -->
                        <div
                            class="grid grid-cols-1 min-[821px]:grid-cols-2 gap-[1.15rem] min-[821px]:gap-4"
                        >
                            <div class="flex flex-col gap-[0.42rem]">
                                <label for="contact-phone" class={labelClass}>
                                    Teléfono
                                </label>
                                <input
                                    type="tel"
                                    id="contact-phone"
                                    name="telefono"
                                    required
                                    maxlength="30"
                                    inputmode="tel"
                                    autocomplete="tel"
                                    placeholder="614 99 21 48"
                                    class={inputClass}
                                />
                            </div>

                            <div class="flex flex-col gap-[0.42rem]">
                                <label for="contact-email" class={labelClass}>
                                    Email
                                </label>
                                <input
                                    type="email"
                                    id="contact-email"
                                    name="email"
                                    required
                                    maxlength="150"
                                    autocomplete="email"
                                    placeholder="tuemail@ejemplo.com"
                                    class={inputClass}
                                />
                            </div>
                        </div>

                        <!-- Edad del niño/a (opcional) -->
                        <div class="flex flex-col gap-[0.42rem]">
                            <label for="contact-age" class={labelClass}>
                                Edad del niño/a <span class="font-normal text-[#7b8b9f] text-[0.82rem]">(opcional)</span>
                            </label>
                            <input
                                type="text"
                                id="contact-age"
                                name="edad"
                                maxlength="20"
                                placeholder="Ej: 8 años"
                                class={inputClass}
                            />
                        </div>

                        <!-- ¿Qué os preocupa? (textarea) -->
                        <div class="flex flex-col gap-[0.42rem]">
                            <label for="contact-concern" class={labelClass}>
                                ¿Qué os preocupa?
                            </label>
                            <textarea
                                id="contact-concern"
                                name="mensaje"
                                rows="3"
                                required
                                maxlength="2000"
                                placeholder="Cuéntame brevemente qué dificultades estáis observando en casa, en el colegio o en su día a día..."
                                class={`${inputClass} min-h-[105px] leading-[1.5] resize-y`}
                            ></textarea>
                        </div>

                        <!-- Aceptación de política de privacidad -->
                        <div class="mt-[0.15rem]">
                            <label
                                class="flex items-start gap-3 cursor-pointer select-none py-[0.35rem] min-h-[44px] box-border"
                            >
                                <input
                                    type="checkbox"
                                    id="contact-privacy"
                                    name="privacidad"
                                    value="1"
                                    required
                                    class="contact__checkbox-native"
                                />
                                <span
                                    class="contact__checkbox-custom"
                                    aria-hidden="true"
                                >
                                    <Check
                                        size={13}
                                        stroke-width={2.5}
                                        class="contact__check-icon"
                                    />
                                </span>
                                <span
                                    class="text-[0.85rem] text-[#506176] leading-[1.45]"
                                >
                                    He leído y acepto la <a
                                        href="/privacidad/"
                                        class="text-[var(--color-primary)] font-semibold underline underline-offset-[3px] transition-colors duration-200 hover:text-[var(--color-primary-dark)]"
                                        >Política de privacidad</a
                                    >.
                                </span>
                            </label>
                        </div>

                        <!-- Botón CTA Principal -->
                        <button
                            type="submit"
                            class="group w-full min-h-[52px] px-[1.6rem] py-[0.9rem] bg-[var(--color-primary)] text-white font-bold text-[1.02rem] rounded-[0.85rem] border-0 cursor-pointer inline-flex items-center justify-center gap-[0.6rem] shadow-[0_10px_24px_-8px_rgba(36,79,158,0.45)] transition-[background-color,transform,box-shadow] duration-200 mt-1.5 hover:bg-[var(--color-primary-dark)] hover:-translate-y-0.5 hover:shadow-[0_14px_28px_-8px_rgba(23,54,97,0.35)] active:translate-y-0"
                        >
                            <span>Cuéntame vuestro caso</span>
                            <ArrowRight
                                size={18}
                                aria-hidden="true"
                                class="transition-transform duration-200 group-hover:translate-x-1"
                            />
                        </button>
                    </form>

                    <!-- 4: Teléfono alternativo y Microgarantías -->
                    <div
                        class="mt-5 flex flex-col min-[821px]:flex-row items-center justify-center flex-wrap gap-1 min-[821px]:gap-[0.45rem_0.55rem] text-[0.94rem] text-[#506176] text-center"
                    >
                        <span>También puedes llamarme al</span>
                        <a
                            href="tel:+34614992148"
                            class="inline-flex items-center justify-center gap-1.5 text-[var(--color-primary)] font-bold no-underline px-2 py-1 rounded-[6px] min-h-[48px] min-[821px]:min-h-[38px] text-[1.05rem] min-[821px]:text-[0.94rem] transition-colors duration-200 hover:text-[var(--color-primary-dark)] hover:bg-[rgba(36,79,158,0.08)] hover:underline hover:underline-offset-[3px]"
                        >
                            <Phone size={15} aria-hidden="true" />
                            <span>614 99 21 48</span>
                        </a>
                    </div>

                    <!-- Microgarantías discretas -->
                    <p
                        class="m-0 mt-[0.85rem] text-center text-[#7b8b9f] text-[0.78rem] min-[401px]:text-[0.82rem] tracking-[0.01em] leading-[1.45]"
                    >
                        Respuesta personal · Sin compromiso · Consulta en
                        Castellón de la Plana
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* --------------------------------------------------------------------------
       CSS Local imprescindible: Halo orgánico, Astro Image y Checkbox custom
       -------------------------------------------------------------------------- */

    /* Halo suave orgánico con acentos dusty rose y sage (coherente con About.astro) */
    .contact__portrait-halo {
        position: absolute;
        top: -5%;
        left: 50%;
        transform: translateX(-50%);
        width: 104%;
        height: 108%;
        border-radius: 44% 56% 62% 38% / 46% 40% 60% 54%;
        background: linear-gradient(
            135deg,
            rgba(223, 162, 170, 0.22) 0%,
            rgba(141, 199, 168, 0.2) 100%
        );
        filter: blur(28px);
        pointer-events: none;
    }

    :global(.contact__portrait-img) {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        object-position: center bottom;
    }

    /* Checkbox accesible con estados combinados */
    .contact__checkbox-native {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .contact__checkbox-custom {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        border: 1px solid rgba(23, 54, 97, 0.25);
        background: #fbfaf7;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        margin-top: 2px;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .contact__check-icon {
        color: #ffffff;
        opacity: 0;
        transform: scale(0.6);
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .contact__checkbox-native:checked + .contact__checkbox-custom {
        background: var(--color-primary);
        border-color: var(--color-primary);
    }

    .contact__checkbox-native:checked
        + .contact__checkbox-custom
        .contact__check-icon {
        opacity: 1;
        transform: scale(1);
    }

    .contact__checkbox-native:focus-visible + .contact__checkbox-custom {
        outline: none;
        box-shadow: 0 0 0 3px rgba(36, 79, 158, 0.2);
        border-color: var(--color-primary);
    }

    /* Honeypot antispam: fuera de pantalla accesible y sin display:none */
    .contact__honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
        opacity: 0;
        pointer-events: none;
    }

    /* Animación del banner de error */
    .contact__error:not([hidden]) {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    function checkContactUrlStatus() {
        const errorBanner = document.getElementById("contact-error");
        const errorDesc = document.getElementById("contact-error-desc");
        if (!errorBanner || !errorDesc) return;

        const params = new URLSearchParams(window.location.search);
        const errorType = params.get("error");

        if (errorType === "1") {
            errorDesc.textContent =
                "Por favor, revisa que todos los campos requeridos estén completos y acepta la política de privacidad.";
            errorBanner.hidden = false;
        } else if (errorType === "envio") {
            errorDesc.textContent =
                "No ha sido posible enviar el mensaje en este momento debido a un problema temporal en el servidor. Por favor, llámanos directamente al 614 99 21 48.";
            errorBanner.hidden = false;
        }
    }

    // Comportamiento en desarrollo local: Astro dev no ejecuta scripts PHP.
    // Esta lógica solo está activa en 'npm run dev' para facilitar el testing visual y desaparece en el build de producción.
    if (import.meta.env.DEV) {
        function setupDevFormNotice() {
            const form = document.getElementById("formulario") as HTMLFormElement | null;
            if (!form || form.dataset.devNoticeBound) return;
            form.dataset.devNoticeBound = "true";

            form.addEventListener("submit", (e) => {
                if (
                    window.confirm(
                        "Aviso de desarrollo (Astro dev):\n\nEl backend PHP (/api/contacto.php) se ejecuta en el hosting final (LucusHost), no en el servidor local de desarrollo de Astro.\n\n¿Deseas simular la navegación a la página /gracias/ para comprobar el flujo visual?"
                    )
                ) {
                    e.preventDefault();
                    window.location.href = "/gracias/";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", setupDevFormNotice);
        document.addEventListener("astro:page-load", setupDevFormNotice);
    }

    document.addEventListener("DOMContentLoaded", checkContactUrlStatus);
    document.addEventListener("astro:page-load", checkContactUrlStatus);
</script>
