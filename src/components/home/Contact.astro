---
import { Image } from "astro:assets";
import { ArrowRight, Check, Phone } from "lucide-astro";
import cuadroContacto from "../../images/contact/cuadro_contacto.webp";
---

<section class="contact" id="contacto" aria-labelledby="contact-heading">
    <div class="contact__container">
        <div class="contact__layout">
            <!-- Columna Izquierda en Desktop / Posición 5 en Móvil: Placeholder para futura fotografía -->
            <div class="contact__visual">
                <div class="contact__portrait-halo" aria-hidden="true"></div>
                <div class="contact__portrait-frame">
                    <Image
                        src={cuadroContacto}
                        alt="Ana Díaz Berbel en consulta de psicología infantil en Castellón"
                        class="contact__portrait-img"
                        format="webp"
                        loading="lazy"
                    />                   
                </div>
            </div>

            <!-- Columna Derecha en Desktop / Posiciones 1-4 en Móvil: Encabezado, Formulario y Contacto -->
            <div class="contact__main">
                <header class="contact__header">
                    <h2 class="contact__title" id="contact-heading">
                        ¿Te preocupa algo de tu hijo?<br />
                        <span class="contact__title-sub"
                            >Empecemos por entender qué está pasando.</span
                        >
                    </h2>

                    <p class="contact__lead">
                        Cuéntame brevemente vuestra situación y me pondré en
                        contacto contigo para valorar cómo puedo ayudaros.
                    </p>
                </header>

                <!-- Formulario -->
                <div class="contact__form-card">
                    <div
                        id="contact-feedback"
                        class="contact__feedback"
                        hidden
                        role="status"
                        aria-live="polite"
                    >
                        <div class="contact__feedback-badge" aria-hidden="true">
                            <Check size={18} />
                        </div>
                        <div class="contact__feedback-text">
                            <strong>¡Mensaje recibido con éxito!</strong>
                            <p>
                                Gracias por escribirme. Me pondré en contacto
                                contigo lo antes posible para valorar vuestro
                                caso de forma personalizada.
                            </p>
                        </div>
                    </div>

                    <form
                        class="contact__form"
                        id="home-contact-form"
                        novalidate
                    >
                        <!-- Nombre y apellidos -->
                        <div class="contact__field">
                            <label for="contact-name" class="contact__label">
                                Nombre y apellidos
                            </label>
                            <input
                                type="text"
                                id="contact-name"
                                name="name"
                                required
                                autocomplete="name"
                                placeholder="Tu nombre y apellidos"
                                class="contact__input"
                            />
                        </div>

                        <!-- Teléfono y Email en 2 columnas (1 en móvil) -->
                        <div class="contact__row">
                            <div class="contact__field">
                                <label
                                    for="contact-phone"
                                    class="contact__label"
                                >
                                    Teléfono
                                </label>
                                <input
                                    type="tel"
                                    id="contact-phone"
                                    name="phone"
                                    required
                                    autocomplete="tel"
                                    placeholder="614 99 21 48"
                                    class="contact__input"
                                />
                            </div>

                            <div class="contact__field">
                                <label
                                    for="contact-email"
                                    class="contact__label"
                                >
                                    Email
                                </label>
                                <input
                                    type="email"
                                    id="contact-email"
                                    name="email"
                                    required
                                    autocomplete="email"
                                    placeholder="tuemail@ejemplo.com"
                                    class="contact__input"
                                />
                            </div>
                        </div>

                        <!-- Edad del niño/a (opcional) -->
                        <div class="contact__field">
                            <div class="contact__label-wrapper">
                                <label
                                    for="contact-child-age"
                                    class="contact__label"
                                >
                                    Edad del niño/a
                                </label>
                                <span class="contact__optional-tag"
                                    >opcional</span
                                >
                            </div>
                            <input
                                type="text"
                                id="contact-child-age"
                                name="child_age"
                                placeholder="Ej: 7 años, 14 años..."
                                class="contact__input"
                            />
                        </div>

                        <!-- ¿Qué os preocupa? (textarea) -->
                        <div class="contact__field">
                            <label for="contact-concern" class="contact__label">
                                ¿Qué os preocupa?
                            </label>
                            <textarea
                                id="contact-concern"
                                name="concern"
                                rows="3"
                                required
                                placeholder="Cuéntame brevemente qué dificultades estáis detectando en casa o en el colegio..."
                                class="contact__textarea"></textarea>
                        </div>

                        <!-- Aceptación de política de privacidad -->
                        <div class="contact__field contact__field--checkbox">
                            <label class="contact__checkbox-label">
                                <input
                                    type="checkbox"
                                    id="contact-privacy"
                                    name="privacy"
                                    required
                                    class="contact__checkbox-native"
                                />
                                <span
                                    class="contact__checkbox-custom"
                                    aria-hidden="true"
                                >
                                    <Check
                                        size={13}
                                        stroke-width={2.5}
                                        class="contact__check-icon"
                                    />
                                </span>
                                <span class="contact__checkbox-text">
                                    He leído y acepto la <a
                                        href="/privacidad"
                                        class="contact__privacy-link"
                                        >política de privacidad</a
                                    >.
                                </span>
                            </label>
                        </div>

                        <!-- Botón CTA Principal -->
                        <button type="submit" class="contact__submit-btn">
                            <span>Cuéntame vuestro caso</span>
                            <ArrowRight
                                size={18}
                                aria-hidden="true"
                                class="contact__btn-arrow"
                            />
                        </button>
                    </form>

                    <!-- Teléfono alternativo clicable -->
                    <div class="contact__alt-call">
                        <span class="contact__alt-text"
                            >También puedes llamarme al</span
                        >
                        <a href="tel:+34614992148" class="contact__phone-link">
                            <Phone size={15} aria-hidden="true" />
                            <span>614 99 21 48</span>
                        </a>
                    </div>

                    <!-- Microgarantías discretas -->
                    <p class="contact__guarantees">
                        Respuesta personal · Sin compromiso · Consulta en
                        Castellón
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* --------------------------------------------------------------------------
       Contenedor y Fondo de la Sección
       -------------------------------------------------------------------------- */
    .contact {
        padding-block: clamp(4.5rem, 7.5vw, 6.75rem);
        background-color: #faf9f5;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
        position: relative;
        overflow-x: clip;
    }

    .contact__container {
        width: min(100% - 2.5rem, 1220px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    /* --------------------------------------------------------------------------
       Layout Principal (42% Izquierda / 58% Derecha)
       -------------------------------------------------------------------------- */
    .contact__layout {
        display: grid;
        grid-template-columns: minmax(0, 4.2fr) minmax(0, 5.8fr);
        gap: clamp(2.5rem, 5vw, 4.75rem);
        align-items: center;
    }

    /* --------------------------------------------------------------------------
       Columna Izquierda: Placeholder Editorial para Futura Fotografía
       -------------------------------------------------------------------------- */
    .contact__visual {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    /* Halo suave orgánico con acentos dusty rose y sage (coherente con About.astro) */
    .contact__portrait-halo {
        position: absolute;
        top: -5%;
        left: 50%;
        transform: translateX(-50%);
        width: 104%;
        height: 108%;
        border-radius: 44% 56% 62% 38% / 46% 40% 60% 54%;
        background: linear-gradient(
            135deg,
            rgba(223, 162, 170, 0.22) 0%,
            rgba(141, 199, 168, 0.2) 100%
        );
        filter: blur(28px);
        z-index: 0;
        pointer-events: none;
    }

    .contact__portrait-frame {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 420px;
        margin-inline: auto;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 12px 32px rgb(65 48 30 / 12%);
    }

    :global(.contact__portrait-img) {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        object-position: center bottom;
    }

    .contact__placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(1.75rem, 3.5vw, 2.5rem);
        box-sizing: border-box;
        position: relative;
    }

    .contact__placeholder-accent {
        position: absolute;
        bottom: -20px;
        right: -20px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(141, 199, 168, 0.18) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .contact__placeholder-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        align-self: flex-start;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(23, 54, 97, 0.08);
        color: #173661;
        font-size: 0.8rem;
        font-weight: 650;
        letter-spacing: 0.01em;
    }

    .contact__placeholder-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #8dc7a8; /* Sage */
        display: inline-block;
    }

    .contact__placeholder-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .contact__placeholder-name {
        margin: 0;
        font-size: clamp(1.4rem, 2.2vw, 1.75rem);
        font-weight: 750;
        color: #173661;
        letter-spacing: -0.02em;
    }

    .contact__placeholder-note {
        margin: 0.25rem 0 0;
        font-size: 0.84rem;
        color: #7b8b9f;
        font-style: italic;
    }

    /* --------------------------------------------------------------------------
       Columna Derecha: Encabezado y Final CTA
       -------------------------------------------------------------------------- */
    .contact__main {
        display: flex;
        flex-direction: column;
    }

    .contact__header {
        margin-bottom: 1.75rem;
    }

    .contact__title {
        margin: 0 0 0.85rem;
        color: #173661;
        font-size: clamp(1.95rem, 3.2vw, 2.65rem);
        font-weight: 750;
        line-height: 1.16;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .contact__title-sub {
        display: block;
        color: #244f9e;
        font-weight: 700;
    }

    .contact__lead {
        margin: 0;
        color: #506176;
        font-size: clamp(1.02rem, 1.2vw, 1.12rem);
        line-height: 1.6;
        text-wrap: pretty;
        max-width: 580px;
    }

    /* --------------------------------------------------------------------------
       Superficie del Formulario (Limpia, Suave, Sin Card Pesada)
       -------------------------------------------------------------------------- */
    .contact__form-card {
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.08);
        border-radius: 1.5rem; /* 24px */
        padding: clamp(1.5rem, 3.5vw, 2.35rem);
        box-shadow: 0 12px 36px -16px rgba(23, 54, 97, 0.06);
    }

    .contact__form {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    .contact__row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .contact__field {
        display: flex;
        flex-direction: column;
        gap: 0.42rem;
    }

    .contact__label-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .contact__label {
        font-size: 0.88rem;
        font-weight: 650;
        color: #173661;
    }

    .contact__optional-tag {
        font-size: 0.76rem;
        color: #7b8b9f;
        background: rgba(23, 54, 97, 0.05);
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        font-weight: 500;
    }

    /* Inputs y Textarea */
    .contact__input,
    .contact__textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 0.78rem 1rem;
        border-radius: 0.75rem; /* 12px */
        border: 1px solid rgba(23, 54, 97, 0.14);
        background: #fbfaf7;
        font-size: 0.96rem;
        color: #18324a;
        font-family: inherit;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .contact__input {
        min-height: 48px;
    }

    .contact__textarea {
        min-height: 105px;
        resize: vertical;
        line-height: 1.5;
    }

    .contact__input::placeholder,
    .contact__textarea::placeholder {
        color: #8b99aa;
        font-size: 0.92rem;
    }

    .contact__input:hover,
    .contact__textarea:hover {
        border-color: rgba(36, 79, 158, 0.3);
    }

    .contact__input:focus,
    .contact__textarea:focus {
        outline: none;
        background: #ffffff;
        border-color: #244f9e;
        box-shadow: 0 0 0 3px rgba(36, 79, 158, 0.14);
    }

    /* Checkbox de Privacidad */
    .contact__field--checkbox {
        margin-top: 0.15rem;
    }

    .contact__checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        cursor: pointer;
        user-select: none;
        padding-block: 0.35rem;
        min-height: 44px;
        box-sizing: border-box;
    }

    .contact__checkbox-native {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .contact__checkbox-custom {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        border: 1px solid rgba(23, 54, 97, 0.25);
        background: #fbfaf7;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        margin-top: 2px;
        transition: all 0.2s ease;
    }

    .contact__check-icon {
        color: #ffffff;
        opacity: 0;
        transform: scale(0.6);
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .contact__checkbox-native:checked + .contact__checkbox-custom {
        background: #244f9e;
        border-color: #244f9e;
    }

    .contact__checkbox-native:checked
        + .contact__checkbox-custom
        .contact__check-icon {
        opacity: 1;
        transform: scale(1);
    }

    .contact__checkbox-native:focus-visible + .contact__checkbox-custom {
        outline: none;
        box-shadow: 0 0 0 3px rgba(36, 79, 158, 0.2);
        border-color: #244f9e;
    }

    .contact__checkbox-text {
        font-size: 0.85rem;
        color: #506176;
        line-height: 1.45;
    }

    .contact__privacy-link {
        color: #244f9e;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
    }

    .contact__privacy-link:hover {
        color: #173661;
    }

    /* Botón Submit CTA */
    .contact__submit-btn {
        width: 100%;
        min-height: 52px;
        padding: 0.9rem 1.6rem;
        background: #244f9e;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.02rem;
        border-radius: 0.85rem;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        box-shadow: 0 10px 24px -8px rgba(36, 79, 158, 0.45);
        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
        margin-top: 0.4rem;
    }

    .contact__submit-btn:hover {
        background: #173661;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px -8px rgba(23, 54, 97, 0.35);
    }

    .contact__submit-btn:active {
        transform: translateY(0);
    }

    .contact__btn-arrow {
        transition: transform 0.2s ease;
    }

    .contact__submit-btn:hover .contact__btn-arrow {
        transform: translateX(4px);
    }

    /* Bloque Teléfono Directo */
    .contact__alt-call {
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.45rem 0.55rem;
        font-size: 0.94rem;
        color: #506176;
    }

    .contact__phone-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #244f9e;
        font-weight: 700;
        text-decoration: none;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        transition:
            color 0.2s ease,
            background-color 0.2s ease;
        min-height: 38px;
    }

    .contact__phone-link:hover {
        color: #173661;
        background-color: rgba(36, 79, 158, 0.08);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Microgarantías Discretas */
    .contact__guarantees {
        margin: 0.85rem 0 0;
        text-align: center;
        font-size: 0.82rem;
        color: #7b8b9f;
        letter-spacing: 0.01em;
        line-height: 1.45;
    }

    /* Mensaje de Confirmación / Feedback */
    .contact__feedback {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        border-radius: 0.85rem;
        background: rgba(141, 199, 168, 0.15); /* Sage suave */
        border: 1px solid rgba(141, 199, 168, 0.4);
        color: #1f4a33;
        margin-bottom: 1.25rem;
        animation: fadeIn 0.3s ease-in-out;
    }
    .contact__feedback[hidden] {
        display: none;
    }

    .contact__feedback-badge {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #2e6b4c;
        color: #ffffff;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .contact__feedback-text {
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .contact__feedback-text strong {
        display: block;
        margin-bottom: 0.2rem;
        color: #173661;
    }

    .contact__feedback-text p {
        margin: 0;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* --------------------------------------------------------------------------
       Tablet: Mantener dos columnas mientras haya espacio suficiente
       -------------------------------------------------------------------------- */
    @media (max-width: 1020px) and (min-width: 821px) {
        .contact__layout {
            grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
            gap: 2.25rem;
        }
    }

    /* --------------------------------------------------------------------------
       Móvil (< 820px):
       -------------------------------------------------------------------------- */
    @media (max-width: 820px) {
        .contact {
            padding-block: clamp(3.75rem, 8vw, 4.75rem);
        }

        .contact__container {
            width: min(100% - 2rem, 100%);
            padding-inline: 0.5rem;
        }

        .contact__layout {
            display: flex;
            flex-direction: column;
            gap: 2.75rem;
        }

        /* En móvil: .contact__main va primero (H2, texto, formulario, teléfono, garantías) */
        .contact__main {
            order: 1;
            width: 100%;
        }

        /* En móvil: .contact__visual va al final (5. imagen) */
        .contact__visual {
            order: 2;
            width: 100%;
        }

        .contact__header {
            text-align: left;
            margin-bottom: 1.5rem;
        }

        .contact__title {
            font-size: clamp(1.75rem, 6.5vw, 2.25rem);
            line-height: 1.2;
        }

        .contact__form-card {
            padding: 1.35rem 1.15rem;
            border-radius: 1.25rem;
        }

        .contact__row {
            grid-template-columns: 1fr;
            gap: 1.15rem;
        }

        .contact__portrait-frame {
            max-width: 100%;
        }

        .contact__placeholder {
            padding: 1.5rem;
        }

        .contact__placeholder-name {
            font-size: 1.35rem;
        }

        /* Controles táctiles mínimo 48px */
        .contact__input {
            min-height: 48px;
            font-size: 1rem; /* Evita zoom forzado en iOS */
        }

        .contact__submit-btn {
            min-height: 52px;
            width: 100%;
        }

        .contact__alt-call {
            flex-direction: column;
            gap: 0.2rem;
            text-align: center;
        }

        .contact__phone-link {
            min-height: 48px;
            justify-content: center;
            font-size: 1.05rem;
        }
    }

    /* Microajustes específicos para pantallas estrechas (390px o menores) */
    @media (max-width: 400px) {
        .contact__container {
            padding-inline: 0.25rem;
        }

        .contact__form-card {
            padding: 1.2rem 0.95rem;
        }

        .contact__title {
            font-size: 1.7rem;
        }

        .contact__lead {
            font-size: 0.98rem;
        }

        .contact__guarantees {
            font-size: 0.78rem;
        }
    }
</style>

<script>
    function initHomeContactForm() {
        const form = document.getElementById(
            "home-contact-form",
        ) as HTMLFormElement | null;
        const feedback = document.getElementById("contact-feedback");

        if (!form) return;

        if (form.dataset.initialized === "true") return;

        form.dataset.initialized = "true";

        form.addEventListener("submit", (e) => {
            e.preventDefault();

            // Validación frontend nativa accesible
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Confirmación visual sin backend (preparado para conectar con servicio final)
            if (feedback) {
                feedback.hidden = false;
                form.reset();
                feedback.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                });
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initHomeContactForm);
    document.addEventListener("astro:page-load", initHomeContactForm);
</script>
