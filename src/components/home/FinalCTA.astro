---
import { ArrowRight, Phone } from "lucide-astro";
---

<section class="final-cta" id="pedir-cita">
    <div class="final-cta__container">
        <div class="final-cta__card">
            <header class="final-cta__header">
                <span class="final-cta__eyebrow">Demos el primer paso</span>
                <h2 class="final-cta__title">
                    ¿Hablamos de la situación de tu hijo?
                </h2>
                <p class="final-cta__text">
                    La primera consulta nos permite valorar qué está pasando y definir un plan de acción claro para empezar a avanzar.
                </p>
            </header>

            <div class="final-cta__actions">
                <a href="#contacto" class="btn btn-primary final-cta__btn-primary">
                    <span>Hablemos de tu caso</span>
                    <ArrowRight size={18} aria-hidden="true" />
                </a>

                <a href="tel:+34614992148" class="final-cta__phone-link">
                    <Phone size={17} aria-hidden="true" />
                    <span>614 99 21 48</span>
                </a>
            </div>

            <p class="final-cta__meta">
                Atención en Castellón de la Plana · Coordinación con centros escolares
            </p>
        </div>
    </div>
</section>

<style>
    .final-cta {
        padding-block: clamp(4.5rem, 7vw, 6.5rem);
        background-color: #faf9f5;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
    }

    .final-cta__container {
        width: min(100% - 2.5rem, 1100px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    .final-cta__card {
        background: linear-gradient(135deg, #173661 0%, #1e457c 100%);
        color: #ffffff;
        border-radius: 1.75rem;
        padding: clamp(3rem, 5.5vw, 4.5rem) clamp(1.75rem, 4vw, 3.5rem);
        text-align: center;
        box-shadow: 0 24px 60px -16px rgba(23, 54, 97, 0.25);
    }

    .final-cta__header {
        max-width: 680px;
        margin-inline: auto;
        margin-bottom: 2.25rem;
    }

    .final-cta__eyebrow {
        display: inline-block;
        color: #9ccbf5;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .final-cta__title {
        margin: 0 0 1.15rem;
        color: #ffffff;
        font-size: clamp(2.1rem, 3.8vw, 3rem);
        font-weight: 750;
        line-height: 1.15;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .final-cta__text {
        margin: 0;
        color: #d1e2f6;
        font-size: clamp(1.02rem, 1.2vw, 1.15rem);
        line-height: 1.65;
        text-wrap: pretty;
    }

    .final-cta__actions {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.25rem 1.75rem;
        margin-bottom: 1.85rem;
    }

    .final-cta__btn-primary {
        min-height: 52px;
        padding: 0.95rem 1.85rem;
        background: #2d79c7;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.05rem;
        border-radius: 0.85rem;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    }

    .final-cta__btn-primary:hover {
        background: #3988dc;
        transform: translateY(-2px);
    }

    .final-cta__phone-link {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: #ffffff;
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.85rem 1.4rem;
        border-radius: 0.85rem;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: background 0.2s ease;
    }

    .final-cta__phone-link:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .final-cta__meta {
        margin: 0;
        color: #a8c9ee;
        font-size: 0.86rem;
    }

    @media (max-width: 620px) {
        .final-cta__actions {
            flex-direction: column;
            align-items: stretch;
        }

        .final-cta__btn-primary,
        .final-cta__phone-link {
            width: 100%;
            justify-content: center;
            box-sizing: border-box;
        }
    }
</style>
