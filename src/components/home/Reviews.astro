---
import { Star, ChevronLeft, ChevronRight, ArrowRight } from "lucide-astro";

/**
 * ============================================================================
 * GOOGLE BUSINESS PROFILE INTEGRATION POINT
 * ============================================================================
 * Esta sección está preparada para conectarse a Google Business Profile API
 * o Google Places API (New) sin modificar la UI ni el maquetado.
 *
 * Estructura requerida:
 * {
 *   rating: number | null,
 *   totalReviews: number | null,
 *   reviews: Array<{
 *     authorName: string,
 *     authorPhoto?: string,
 *     rating: number,
 *     text: string,
 *     relativeTime: string,
 *     reviewUrl?: string
 *   }>
 * }
 *
 * Instrucciones de conexión:
 * 1. Definir GOOGLE_PLACES_API_KEY y GOOGLE_PLACE_ID en variables de entorno privadas.
 * 2. En build time (o SSR endpoint), llamar a:
 *    https://places.googleapis.com/v1/places/{placeId}?fields=reviews,rating,userRatingCount&key=${key}&languageCode=es
 * 3. Mapear la respuesta a `googleData` y poner `isGoogleConnected = true`.
 * ============================================================================
 */

export interface GoogleReview {
    authorName: string;
    authorPhoto?: string;
    rating: number;
    text: string;
    relativeTime: string;
    reviewUrl?: string;
}

export interface GoogleBusinessProfileData {
    rating: number | null;
    totalReviews: number | null;
    reviews: GoogleReview[];
}

// URL fallback del perfil en Google Maps / Business Profile
const googleProfileUrl = "https://maps.google.com/?cid=4225123225601099366";

const googleData: GoogleBusinessProfileData = {
    rating: 5,
    totalReviews: 46,
    reviews: [
        {
            authorName: "will_grao fdez",
            rating: 5,
            relativeTime: "hace 1 semana",
            text: "Gran experiencia de la mano de Ana que nos ha guiado con nuestro hijo. La conocí buscando por google porque no tenia ni idea de donde acudir. Vi buenas reseñas y la experiencia que tenia en este area y no me lo pensé, aun asi, la atencion, la cercania y la forma de comunicar ha superado mis expectativas. GRACIAS",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Elena Alegre Millan",
            rating: 5,
            relativeTime: "hace 2 semanas",
            text: "Solo podemos tener palabras de agradecimiento para Ana. Desde el primer momento nos hizo sentir muy tranquilos y, sobre todo, supo conectar con nuestro hijo de una manera muy especial. Es una persona cercana, cariñosa y muy profesional, y se nota que trabaja con mucha dedicación.Para nosotros es muy importante ver a nuestro hijo cómodo, escuchado y con confianza, y con Ana lo hemos conseguido. Estamos muy contentos con el proceso y con la evolución que estamos viendo. Sin duda, ha sido una muy buena decisión contar con ella. ❤️",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "cosmin r",
            rating: 5,
            relativeTime: "hace 2 semanas",
            text: "Ana es una profesional,  todo muy bien en su trabajo y muy buenos consejos.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Mayte a.",
            rating: 5,
            relativeTime: "hace 3 semanas",
            text: "Ana es una gran profesional, muy atenta y empática con los niñoos y los padres. Con abundantes herramientas de diagnóstico y tratamiento. Muy agradecidas por su trabajo y dedicación.",
            reviewUrl: googleProfileUrl,
        },
        { 
            authorName: "A SB",
            rating: 5,
            relativeTime: "hace 3 semanas",
            text: "Me ha encantado conocer a Ana,nos ha ayudado mucho con nuestra hija,diagnosticada de tdah.Aún queda un largo camino,pero junto a ella,se hará más fácil.Muchas gracias por todo.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Benedicte Nederlants",
            rating: 5,
            relativeTime: "hace un mes",
            text: "Acudimos a Ana porque estábamos perdidos y no sabíamos que hacer con nuestro hijo. Su respuesta fue inmediata y su trato muy cercano y profesional. Como ella se describe; nos ayudo a evaluar sus dificultades de aprendizaje, atención y conducta y a poner un nombre en su comportamiento. Así como darnos una hoja de ruta para casa y para el colegio. Recomiendo a Ana a padres que como nosotros no saben que hacer ni como empezar!! Gracias Ana.",
            reviewUrl: googleProfileUrl,
        },
    ],
};
---

<section class="reviews" id="resenas" aria-labelledby="reviews-heading">
    <div class="section-container reviews__container">
        <!-- Cabecera centrada -->
        <header class="reviews__header">
            <h2 id="reviews-heading" class="reviews__title">
                La tranquilidad de saber qué hacer
            </h2>

            <p class="reviews__intro">
                Experiencias reales de familias que han encontrado claridad, pautas y acompañamiento.
            </p>

            <!-- Bloque compacto Google con Logotipo Oficial de Letras GRANDE y 5 estrellas grandes -->
            <a
                href={googleProfileUrl}
                id="google-profile-link"
                target="_blank"
                rel="noopener noreferrer"
                class="reviews__google-badge"
                aria-label="Ver perfil de Google Business Profile"
            >
                <div class="reviews__brand">
                    <!-- Logotipo oficial vectorial completo de GOOGLE con sus letras grandes -->
                    <svg
                        class="reviews__google-wordmark"
                        viewBox="0 0 272 92"
                        width="122"
                        height="41"
                        role="img"
                        aria-label="Google"
                    >
                        <use href="/icons/sprite.svg#logo-google"></use>
                    </svg>
                </div>

                <div class="reviews__stars-wrap">
                    <div class="reviews__stars" aria-label="5 de 5 estrellas">
                        {
                            Array.from({ length: 5 }).map(() => (
                                <Star
                                    size={21}
                                    fill="#FBBC05"
                                    color="#FBBC05"
                                    stroke-width={0}
                                />
                            ))
                        }
                    </div>

                    <span class="reviews__rating-text">
                        <strong id="google-rating">5</strong>/5
                        <span class="reviews__dot">.</span>
                        <span id="google-review-count">46</span> reseñas
                    </span>
                </div>
            </a>
        </header>

        <!-- Carrusel de Reseñas -->
        <div class="reviews__carousel">
            <!-- Controles discretos izquierda / derecha -->
            <div class="reviews__controls">
                <button
                    type="button"
                    class="reviews__control-btn"
                    id="reviews-prev"
                    aria-label="Ver reseña anterior"
                >
                    <ChevronLeft size={22} stroke-width={2.2} />
                </button>
                <button
                    type="button"
                    class="reviews__control-btn"
                    id="reviews-next"
                    aria-label="Ver siguiente reseña"
                >
                    <ChevronRight size={22} stroke-width={2.2} />
                </button>
            </div>

            <!-- Track con CSS Scroll-Snap (Desktop: 3, Tablet: 2, Móvil: 1) -->
            <div
                class="reviews__track"
                id="reviews-track"
                role="region"
                aria-label="Reseñas de Google"
                tabindex="0"
            >
                {
                    googleData.reviews.map((review: GoogleReview) => {
                        const initial = review.authorName.trim().charAt(0) || "G";
                        const isLong = review.text.length > 190;

                        return (
                            <article class="review-card">
                                <!-- Cabecera de la card -->
                                <div class="review-card__header">
                                    <div class="review-card__author">
                                        {review.authorPhoto ? (
                                            <img
                                                src={review.authorPhoto}
                                                alt={review.authorName}
                                                class="review-card__avatar-img"
                                                width="44"
                                                height="44"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div
                                                class="review-card__avatar-placeholder"
                                                aria-hidden="true"
                                            >
                                                <span>{initial}</span>
                                            </div>
                                        )}

                                        <div class="review-card__meta">
                                            <span class="review-card__name">
                                                {review.authorName}
                                            </span>
                                            <span class="review-card__date">
                                                {review.relativeTime}
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Identificador Google en Card con la G oficial -->
                                    <div
                                        class="review-card__google-source"
                                        title="Reseña verificada en Google"
                                        aria-label="Origen Google"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            aria-hidden="true"
                                        >
                                            <use href="/icons/sprite.svg#icon-google"></use>
                                        </svg>
                                    </div>
                                </div>

                                <!-- 5 Estrellas amarillas grandes -->
                                <div
                                    class="review-card__stars"
                                    aria-label={`${review.rating} estrellas`}
                                >
                                    {Array.from({ length: review.rating }).map(() => (
                                        <Star
                                            size={16}
                                            fill="#FBBC05"
                                            color="#FBBC05"
                                            stroke-width={0}
                                        />
                                    ))}
                                </div>

                                <!-- Texto real de la reseña con soporte de expansión -->
                                <div class="review-card__content">
                                    <p
                                        class:list={[
                                            "review-card__text",
                                            { "review-card__text--clamped": isLong },
                                        ]}
                                    >
                                        “{review.text}”
                                    </p>
                                    {isLong && (
                                        <button
                                            type="button"
                                            class="review-card__read-more"
                                            aria-expanded="false"
                                        >
                                            Leer más
                                        </button>
                                    )}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>

        <!-- CTA inferior -->
        <div class="reviews__action">
            <a
                href={googleProfileUrl}
                id="google-reviews-link"
                target="_blank"
                rel="noopener noreferrer"
                class="reviews__cta-btn"
            >
                <span>Ver todas las reseñas en Google</span>
                <ArrowRight size={17} stroke-width={2} aria-hidden="true" class="reviews__cta-arrow" />
            </a>
        </div>
    </div>
</section>

<style>
    /* ==========================================================================
       Reviews Section
       Estética limpia, premium, con logotipo Google oficial grande y scroll fluido.
       ========================================================================== */
    .reviews {
        padding-block: clamp(5rem, 8vw, 7.5rem);
        background-color: #faf9f5;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
        position: relative;
        overflow: hidden;
    }

    /* --------------------------------------------------------------------------
       Cabecera centrada
       -------------------------------------------------------------------------- */
    .reviews__header {
        text-align: center;
        max-width: 780px;
        margin-inline: auto;
        margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .reviews__title {
        margin: 0 0 0.85rem;
        color: var(--color-primary-dark);
        font-size: clamp(2.1rem, 3.8vw, 3.1rem);
        font-weight: 750;
        line-height: 1.15;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .reviews__intro {
        margin: 0 0 1.75rem;
        color: var(--color-text-soft);
        font-size: clamp(1.02rem, 1.2vw, 1.15rem);
        line-height: 1.6;
        text-wrap: pretty;
    }

    /* Bloque compacto Google con logotipo de letras grande */
    .reviews__google-badge {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.1rem 1.4rem;
        padding: 0.75rem 1.65rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.1);
        box-shadow:
            0 8px 24px -4px rgba(23, 54, 97, 0.06),
            0 2px 6px rgba(23, 54, 97, 0.02);
        text-decoration: none;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .reviews__google-badge:hover {
        transform: translateY(-2px);
        border-color: rgba(66, 133, 244, 0.35);
        box-shadow:
            0 12px 28px -6px rgba(66, 133, 244, 0.15),
            0 4px 10px rgba(23, 54, 97, 0.04);
    }

    .reviews__brand {
        display: inline-flex;
        align-items: center;
    }

    /* Logotipo vectorial grande de Google con letras */
    .reviews__google-wordmark {
        display: block;
        width: 122px;
        height: 41px;
        flex-shrink: 0;
    }

    .reviews__stars-wrap {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    .reviews__stars {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .reviews__rating-text {
        font-size: 0.92rem;
        color: var(--color-primary-dark);
        font-weight: 650;
        white-space: nowrap;
    }

    .reviews__rating-text strong {
        font-weight: 850;
        color: var(--color-primary-dark);
        font-size: 1rem;
    }

    .reviews__rating-text--status {
        color: var(--color-text-soft);
        font-weight: 600;
        font-size: 0.86rem;
    }

    .reviews__dot {
        margin-inline: 0.4rem;
        color: rgba(23, 54, 97, 0.35);
    }

    /* --------------------------------------------------------------------------
       Carrusel de Reseñas
       -------------------------------------------------------------------------- */
    .reviews__carousel {
        position: relative;
        width: 100%;
    }

    .reviews__controls {
        position: absolute;
        top: -4.4rem;
        right: 0;
        display: flex;
        gap: 0.55rem;
        z-index: 2;
    }

    .reviews__control-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.12);
        color: var(--color-primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(23, 54, 97, 0.04);
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .reviews__control-btn:hover:not(:disabled) {
        background: var(--color-primary);
        color: #ffffff;
        border-color: var(--color-primary);
        transform: translateY(-1px);
    }

    .reviews__control-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* Track de desplazamiento */
    .reviews__track {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-block: 0.5rem 1.25rem;
        margin-inline: -0.25rem;
        padding-inline: 0.25rem;
    }

    .reviews__track::-webkit-scrollbar {
        display: none;
    }

    .reviews__track:focus-visible {
        outline: 2px solid var(--color-primary);
        border-radius: 1rem;
    }

    /* --------------------------------------------------------------------------
       Cards de Reseñas (Marfil / Blanco roto suave)
       -------------------------------------------------------------------------- */
    .review-card {
        flex: 0 0 calc((100% - (2 * 1.5rem)) / 3);
        box-sizing: border-box;
        scroll-snap-align: start;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.08);
        border-radius: 1.25rem;
        padding: clamp(1.4rem, 2vw, 1.85rem);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        box-shadow:
            0 8px 24px -6px rgba(23, 54, 97, 0.04),
            0 2px 6px rgba(23, 54, 97, 0.02);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }

    .review-card:hover {
        transform: translateY(-3px);
        border-color: rgba(66, 133, 244, 0.25);
        box-shadow:
            0 14px 32px -8px rgba(23, 54, 97, 0.08),
            0 4px 10px rgba(66, 133, 244, 0.04);
    }

    .review-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.85rem;
    }

    .review-card__author {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .review-card__avatar-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f6f1e8 0%, #ede4d5 100%);
        border: 1px solid rgba(23, 54, 97, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 0.98rem;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .review-card__avatar-img {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(23, 54, 97, 0.1);
        flex-shrink: 0;
    }

    .review-card__meta {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .review-card__name {
        font-size: 0.94rem;
        font-weight: 700;
        color: var(--color-primary-dark);
        letter-spacing: -0.01em;
    }

    .review-card__date {
        font-size: 0.76rem;
        color: var(--color-text-soft);
        margin-top: 0.15rem;
    }

    .review-card__google-source {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(23, 54, 97, 0.035);
        border: 1px solid rgba(23, 54, 97, 0.06);
        flex-shrink: 0;
    }

    .review-card__google-source svg {
        display: block;
    }

    .review-card__stars {
        display: inline-flex;
        align-items: center;
        gap: 2.5px;
        margin-bottom: 0.95rem;
    }

    .review-card__content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .review-card__text {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--color-text);
        font-weight: 460;
        text-wrap: pretty;
    }

    .review-card__text--clamped {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 5;
        overflow: hidden;
    }

    .review-card__text--expanded {
        display: block;
        -webkit-line-clamp: unset;
    }

    .review-card__read-more {
        align-self: flex-start;
        margin-top: 0.5rem;
        padding: 0;
        background: none;
        border: none;
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.2s ease;
    }

    .review-card__read-more:hover {
        color: var(--color-primary-dark);
    }

    /* --------------------------------------------------------------------------
       CTA inferior: Ver todas las reseñas en Google →
       -------------------------------------------------------------------------- */
    .reviews__action {
        display: flex;
        justify-content: center;
        margin-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    .reviews__cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--color-primary-dark);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        border-radius: 0.75rem;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.12);
        box-shadow: 0 4px 14px rgba(23, 54, 97, 0.04);
        transition:
            background-color 0.25s ease,
            color 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }

    .reviews__cta-btn:hover {
        background-color: var(--color-primary);
        color: #ffffff;
        border-color: var(--color-primary);
        box-shadow: 0 8px 20px rgba(36, 79, 158, 0.2);
        transform: translateY(-2px);
    }

    .reviews__cta-arrow {
        transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .reviews__cta-btn:hover .reviews__cta-arrow {
        transform: translateX(4px);
    }

    /* ==========================================================================
       Tablet Breakpoint (max-width: 1024px): 2 cards por vista
       ========================================================================== */
    @media (max-width: 1024px) {
        .review-card {
            flex: 0 0 calc((100% - 1.25rem) / 2);
        }

        .reviews__track {
            gap: 1.25rem;
        }

        .reviews__controls {
            position: static;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
    }

    /* ==========================================================================
       Mobile Breakpoint (max-width: 680px): 1 card por vista + swipe natural
       ========================================================================== */
    @media (max-width: 680px) {
        .reviews {
            padding-block: 4.5rem 4rem;
        }

        .reviews__container {
            width: 100%;
            padding-inline: 18px;
        }

        .reviews__title {
            font-size: clamp(1.85rem, 6.8vw, 2.3rem);
        }

        .reviews__google-badge {
            padding: 0.65rem 1.15rem;
            gap: 0.75rem;
            width: 100%;
            max-width: 360px;
            box-sizing: border-box;
        }

        .reviews__google-wordmark {
            width: 105px;
            height: 35px;
        }

        .reviews__stars svg {
            width: 18px;
            height: 18px;
        }

        .reviews__rating-text {
            font-size: 0.82rem;
        }

        .review-card {
            flex: 0 0 100%;
            min-width: 100%;
            padding: 1.4rem 1.25rem;
            border-radius: 1.15rem;
        }

        .reviews__track {
            gap: 1rem;
            padding-inline: 0;
            margin-inline: 0;
        }

        .reviews__controls {
            position: static;
            justify-content: center;
            margin-bottom: 1.25rem;
            gap: 0.75rem;
        }

        .reviews__control-btn {
            width: 44px;
            height: 44px;
        }

        .reviews__cta-btn {
            width: 100%;
            min-height: 48px;
            justify-content: center;
            box-sizing: border-box;
            text-align: center;
        }
    }

    /* Reducción de movimiento */
    @media (prefers-reduced-motion: reduce) {
        .reviews__track {
            scroll-behavior: auto;
        }

        .review-card,
        .reviews__control-btn,
        .reviews__cta-btn,
        .reviews__cta-arrow {
            transition: none !important;
            transform: none !important;
        }
    }
</style>

<script>
    function initReviewsCarousel() {
        const track = document.getElementById("reviews-track");
        const prevBtn = document.getElementById("reviews-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("reviews-next") as HTMLButtonElement | null;

        if (!track || !prevBtn || !nextBtn || track.dataset.initialized) return;
        track.dataset.initialized = "true";

        function updateButtons() {
            if (!track || !prevBtn || !nextBtn) return;
            const scrollLeft = track.scrollLeft;
            const maxScroll = track.scrollWidth - track.clientWidth - 4;

            prevBtn.disabled = scrollLeft <= 4;
            nextBtn.disabled = scrollLeft >= maxScroll;
        }

        prevBtn.addEventListener("click", () => {
            if (!track) return;
            const card = track.querySelector(".review-card") as HTMLElement | null;
            const step = card ? card.offsetWidth + 24 : 320;
            track.scrollBy({ left: -step, behavior: "smooth" });
        });

        nextBtn.addEventListener("click", () => {
            if (!track) return;
            const card = track.querySelector(".review-card") as HTMLElement | null;
            const step = card ? card.offsetWidth + 24 : 320;
            track.scrollBy({ left: step, behavior: "smooth" });
        });

        track.addEventListener("scroll", updateButtons, { passive: true });
        window.addEventListener("resize", updateButtons, { passive: true });
        updateButtons();

        // Control accesible para "Leer más"
        const readMoreButtons = track.querySelectorAll(".review-card__read-more");
        readMoreButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const textEl = btn.previousElementSibling as HTMLElement | null;
                if (!textEl) return;

                const isExpanded = btn.getAttribute("aria-expanded") === "true";
                if (isExpanded) {
                    textEl.classList.remove("review-card__text--expanded");
                    textEl.classList.add("review-card__text--clamped");
                    btn.setAttribute("aria-expanded", "false");
                    btn.textContent = "Leer más";
                } else {
                    textEl.classList.remove("review-card__text--clamped");
                    textEl.classList.add("review-card__text--expanded");
                    btn.setAttribute("aria-expanded", "true");
                    btn.textContent = "Leer menos";
                }
            });
        });
    }

    async function loadGooglePlaceData() {
        try {
            const response = await fetch("/api/google-place");
            if (!response.ok) {
                throw new Error(`HTTP error ${response.status}`);
            }
            const data = await response.json();

            if (data.rating !== undefined && data.rating !== null) {
                const ratingEl = document.getElementById("google-rating");
                if (ratingEl) {
                    ratingEl.textContent = Number(data.rating).toFixed(1);
                }
            }

            if (data.totalReviews !== undefined && data.totalReviews !== null) {
                const countEl = document.getElementById("google-review-count");
                if (countEl) {
                    countEl.textContent = String(data.totalReviews);
                }
            }

            if (data.googleMapsUrl) {
                const profileLink = document.getElementById("google-profile-link") as HTMLAnchorElement | null;
                if (profileLink) {
                    profileLink.href = data.googleMapsUrl;
                }

                const reviewsLink = document.getElementById("google-reviews-link") as HTMLAnchorElement | null;
                if (reviewsLink) {
                    reviewsLink.href = data.googleMapsUrl;
                }
            }
        } catch (error) {
            console.error("Error al cargar datos dinámicos de Google Places:", error);
        }
    }

    function initReviews() {
        initReviewsCarousel();
        loadGooglePlaceData();
    }

    document.addEventListener("DOMContentLoaded", initReviews);
    document.addEventListener("astro:page-load", initReviews);
</script>
