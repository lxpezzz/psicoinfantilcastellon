---
import { Star, ChevronLeft, ChevronRight, ArrowRight } from "lucide-astro";

// Reseñas y cifras gestionadas manualmente, sin consultas a APIs externas.

export interface GoogleReview {
    authorName: string;
    authorPhoto?: string;
    rating: number;
    text: string;
    relativeTime: string;
    reviewUrl?: string;
}

export interface GoogleBusinessProfileData {
    rating: number | null;
    totalReviews: number | null;
    reviews: GoogleReview[];
}

// Enlace al perfil en Google Maps.
const googleProfileUrl = "https://maps.google.com/?cid=4225123225601099366";

const googleData: GoogleBusinessProfileData = {
    rating: 5,
    totalReviews: 59,
    reviews: [
        {
            authorName: "Sandra Marco Campos",
            rating: 5,
            relativeTime: "hace 4 días",
            text: "Una gran profesional y, sobre todo, una maravillosa persona. Nos ha dado las herramientas que buscábamos. Recomendable 100%.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Cristina Faubel Serra",
            rating: 5,
            relativeTime: "hace 6 días",
            text: "Un trato muy familiar, se nota q le gusta y eso se nota nada más entrar",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Vane Saura",
            rating: 5,
            relativeTime: "hace 6 días",
            text: "Ana ha atendido a nuestro peque y la experiencia no ha podido ser mejor. Es una psicóloga cariñosa y cercana con los peques, algo que se nota desde el primer minuto. Sabe cómo ganarse su confianza, haciendo que se sientan seguros, escuchados y en un entorno de total confianza. Su empatía y dedicación marcan la diferencia. Agradecerle su gran labor. La recomendamos al 100%.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Jessica Basilio",
            rating: 5,
            relativeTime: "hace 6 días",
            text: "Estábamos muy perdidos con el comportamiento de nuestro hijo y conocer a Ana ha sido un antes y un después en nuestra vida. Nos ha realizado un informe completo con un diagnóstico de nuestro hijo, nos ha dado herramientas para mejorar comportamientos y rutinas, incluso en el ámbito escolar está colaborando para mejorar su nivel académico y su bienestar emocional, ha sido muy profesional y muy cariñosa. Todavía nos queda camino que recorrer con nuestro hijo y nos acompañará mucho tiempo porque mi hijo es feliz con ella. Ana ha sabido conocerlo, analizarlo y comprendernos de una forma excelente.",
            reviewUrl: googleProfileUrl,
        },
        { 
            authorName: "mariam menendez",
            rating: 5,
            relativeTime: "hace 1 semana",
            text: "Conectamos enseguida, y lo más agradable de la experiencia es la felicidad con que mi niña acude a ella",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Patricia Castell Gonzalez",
            rating: 5,
            relativeTime: "hace 1 semana",
            text: "Hemos ido por primera vez a ver Ana y me ha parecido que es una persona súper cercana y honesta. Tenemos un hijo de dos años qué es bastante movidito y teníamos nuestras dudas e inseguridades porque nunca habíamos ido a un psicólogo infantil y no sabíamos qué nos podían decir o cómo nos podían ayudar y ella nos lo ha explicado estupendamente, nos ha aconsejado y nos ha guiado como esperábamos.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "angel G.a",
            rating: 5,
            relativeTime: "hace 2 semanas",
            text: "Recomiendo enormemente a la psicóloga infantil Ana. Su atención y profesionalidad han sido excepcionales desde el primer día. Gracias a su trato cercano y metodología, nos sentimos muy apoyados y obtuvimos una valoración muy positiva y útil para el bienestar de nuestro hijo. Es una gran profesional.La recomiendo 100 %.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Patricia",
            rating: 5,
            relativeTime: "hace 3 semanas",
            text: "Una gran profesional, accesible, cercana y muy empática y cariñosa. 100% recomendable",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Ester Hernandez Sanchez",
            rating: 5,
            relativeTime: "hace 3 semanas",
            text: "Hemos estado esta mañana con Ana y la verdad es que hemos salido muy contentas. Desde el primer momento nos transmitió mucha seguridad y tranquilidad, y nos dio herramientas muy útiles para entender mejor a nuestra hija y saber cómo acompañarla en esta etapa.Además, estuvo con nosotras más tiempo del que duraba la visita y en ningún momento nos hizo sentir que tuviéramos que irnos ni nos transmitió ningún tipo de presión. Todo lo contrario, nos hizo sentir muy cómodas, escuchadas y comprendidas.También nos ha gustado mucho su forma de trabajar, porque en ningún momento hemos sentido que quisiera que volviéramos por volver. Nos ha dado unas pautas para poner en práctica y nos ha dicho que, si queremos, podemos volver en diciembre para contarle cómo ha ido. Eso nos ha transmitido muchísima confianza. Sin duda, si volvemos a necesitar ayuda o nos surge cualquier duda, volveremos a contar con ella. Estamos muy agradecidas y la recomendamos totalmente.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Maica Pérez",
            rating: 5,
            relativeTime: "hace 1 mes",
            text: "Gran profesional que conecta con los adolescentes.",
            reviewUrl: googleProfileUrl,
        },{
            authorName: "Rosa",
            rating: 5,
            relativeTime: "hace 1 mes",
            text: "Muy buena la experiencia con Ana, es muy profesional y nos ha ayudado mucho con nuestro hijo.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Carlos Dauden",
            rating: 5,
            relativeTime: "hace 1 semana",
            text: "Una gran profesional que destaca por sus amplios conocimientos, su experiencia y su capacidad para transmitir información compleja de una forma clara, cercana y comprensible. Combina explicaciones técnicas y rigurosas con un lenguaje natural y ejemplos cotidianos que permiten entender fácilmente incluso los conceptos más complejo. Se percibe que cuenta con una sólida formación académica, una amplia experiencia profesional y, además, una valiosa experiencia vital que aporta profundidad y perspectiva a sus explicaciones.Destaca especialmente su capacidad para escuchar, comprender y adaptar su enfoque a medida que va conociendo al paciente. No se limita a aplicar conocimientos o pautas de forma genérica, sino que analiza cada caso con atención, ajusta sus valoraciones y busca identificar con precisión el origen de las dificultades para ofrecer la ayuda más adecuada.Transmite seguridad, conocimiento y confianza. Se nota que sabe de lo que habla y que tiene tanto la preparación como la sensibilidad necesarias para ejercer su profesión con rigor y humanidad. Una psicóloga altamente recomendable por su profesionalidad, claridad y capacidad para comprender a las personas.",
            reviewUrl: googleProfileUrl,
        },
        {
            authorName: "Araceli Gil López",
            rating: 5,
            relativeTime: "hace 1 mes",
            text: "Estamos encantados y muy agradecidos con la atención y profesionalidad de Ana. Desde el primer momento ha sabido conectar con nuestra hija, ganándose su confianza y haciendo que se sienta cómoda, escuchada y comprendida. Para nosotros ha sido muy importante sentir que nuestra hija está en buenas manos y contar con alguien que la acompaña con tanto cariño y dedicación. Estamos muy contentos con su evolución y, sin duda, la recomendamos de corazón. ❤️🫂🥰",
            reviewUrl: googleProfileUrl,
        },
    ],
};
---

<section class="reviews" id="resenas" aria-labelledby="reviews-heading">
    <div class="section-container reviews__container">
        <!-- Cabecera centrada -->
        <header class="reviews__header">
            <h2 id="reviews-heading" class="reviews__title">
                La tranquilidad de saber qué hacer
            </h2>

            <p class="reviews__intro">
                Experiencias reales de familias que han encontrado claridad, pautas y acompañamiento.
            </p>

            <!-- Bloque compacto Google con Logotipo Oficial de Letras GRANDE y 5 estrellas grandes -->
            <a
                href={googleProfileUrl}
                id="google-profile-link"
                target="_blank"
                rel="noopener noreferrer"
                class="reviews__google-badge"
                aria-labelledby="google-badge-brand google-badge-score google-badge-count"
            >
                <div class="reviews__brand">
                    <!-- Logotipo oficial vectorial completo de GOOGLE con sus letras grandes -->
                    <svg
                        id="google-badge-brand"
                        class="reviews__google-wordmark"
                        viewBox="0 0 272 92"
                        width="122"
                        height="41"
                        role="img"
                        aria-label="Google"
                    >
                        <use href="/icons/sprite.svg#logo-google"></use>
                    </svg>
                </div>

                <div class="reviews__stars-wrap">
                    <div class="reviews__stars" aria-hidden="true">
                        {
                            Array.from({ length: 5 }).map(() => (
                                <Star
                                    size={21}
                                    fill="#FBBC05"
                                    color="#FBBC05"
                                    stroke-width={0}
                                />
                            ))
                        }
                    </div>

                    <span class="reviews__rating-text">
                        <span id="google-badge-score"><strong id="google-rating">5</strong>/5</span>
                        <span class="reviews__dot">.</span>
                        <span id="google-badge-count"><span id="google-review-count">59</span> reseñas</span>
                    </span>
                </div>
            </a>
        </header>

        <!-- Carrusel de Reseñas -->
        <div class="reviews__carousel">
            <!-- Controles discretos izquierda / derecha -->
            <div class="reviews__controls">
                <button
                    type="button"
                    class="reviews__control-btn"
                    id="reviews-prev"
                    aria-label="Ver reseña anterior"
                >
                    <ChevronLeft size={22} stroke-width={2.2} />
                </button>
                <button
                    type="button"
                    class="reviews__control-btn"
                    id="reviews-next"
                    aria-label="Ver siguiente reseña"
                >
                    <ChevronRight size={22} stroke-width={2.2} />
                </button>
            </div>

            <!-- Track con CSS Scroll-Snap (Desktop: 3, Tablet: 2, Móvil: 1) -->
            <div
                class="reviews__track"
                id="reviews-track"
                role="region"
                aria-label="Reseñas de Google"
                tabindex="0"
            >
                {
                    googleData.reviews.map((review: GoogleReview) => {
                        const initial = review.authorName.trim().charAt(0) || "G";
                        const isLong = review.text.length > 190;

                        return (
                            <article class="review-card">
                                <!-- Cabecera de la card -->
                                <div class="review-card__header">
                                    <div class="review-card__author">
                                        {review.authorPhoto ? (
                                            <img
                                                src={review.authorPhoto}
                                                alt={review.authorName}
                                                class="review-card__avatar-img"
                                                width="44"
                                                height="44"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div
                                                class="review-card__avatar-placeholder"
                                                aria-hidden="true"
                                            >
                                                <span>{initial}</span>
                                            </div>
                                        )}

                                        <div class="review-card__meta">
                                            <span class="review-card__name">
                                                {review.authorName}
                                            </span>
                                            <span class="review-card__date">
                                                {review.relativeTime}
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Identificador Google en Card con la G oficial -->
                                    <div
                                        class="review-card__google-source"
                                        title="Reseña verificada en Google"
                                        aria-label="Origen Google"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            aria-hidden="true"
                                        >
                                            <use href="/icons/sprite.svg#icon-google"></use>
                                        </svg>
                                    </div>
                                </div>

                                <!-- 5 Estrellas amarillas grandes -->
                                <div
                                    class="review-card__stars"
                                    aria-label={`${review.rating} estrellas`}
                                >
                                    {Array.from({ length: review.rating }).map(() => (
                                        <Star
                                            size={16}
                                            fill="#FBBC05"
                                            color="#FBBC05"
                                            stroke-width={0}
                                        />
                                    ))}
                                </div>

                                <!-- Texto real de la reseña con soporte de expansión -->
                                <div class="review-card__content">
                                    <p
                                        class:list={[
                                            "review-card__text",
                                            { "review-card__text--clamped": isLong },
                                        ]}
                                    >
                                        “{review.text}”
                                    </p>
                                    {isLong && (
                                        <button
                                            type="button"
                                            class="review-card__read-more"
                                            aria-expanded="false"
                                        >
                                            Leer más
                                        </button>
                                    )}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>

        <!-- CTA inferior -->
        <div class="reviews__action">
            <a
                href={googleProfileUrl}
                id="google-reviews-link"
                target="_blank"
                rel="noopener noreferrer"
                class="reviews__cta-btn"
            >
                <span>Ver todas las reseñas en Google</span>
                <ArrowRight size={17} stroke-width={2} aria-hidden="true" class="reviews__cta-arrow" />
            </a>
        </div>
    </div>
</section>

<style>
    /* ==========================================================================
       Reviews Section
       Estética limpia, premium, con logotipo Google oficial grande y scroll fluido.
       ========================================================================== */
    .reviews {
        padding-block: clamp(5rem, 8vw, 7.5rem);
        background-color: #faf9f5;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
        position: relative;
        overflow: hidden;
    }

    /* --------------------------------------------------------------------------
       Cabecera centrada
       -------------------------------------------------------------------------- */
    .reviews__header {
        text-align: center;
        max-width: 780px;
        margin-inline: auto;
        margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .reviews__title {
        margin: 0 0 0.85rem;
        color: var(--color-primary-dark);
        font-size: clamp(2.1rem, 3.8vw, 3.1rem);
        font-weight: 750;
        line-height: 1.15;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .reviews__intro {
        margin: 0 0 1.75rem;
        color: var(--color-text-soft);
        font-size: clamp(1.02rem, 1.2vw, 1.15rem);
        line-height: 1.6;
        text-wrap: pretty;
    }

    /* Bloque compacto Google con logotipo de letras grande */
    .reviews__google-badge {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.1rem 1.4rem;
        padding: 0.75rem 1.65rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.1);
        box-shadow:
            0 8px 24px -4px rgba(23, 54, 97, 0.06),
            0 2px 6px rgba(23, 54, 97, 0.02);
        text-decoration: none;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .reviews__google-badge:hover {
        transform: translateY(-2px);
        border-color: rgba(66, 133, 244, 0.35);
        box-shadow:
            0 12px 28px -6px rgba(66, 133, 244, 0.15),
            0 4px 10px rgba(23, 54, 97, 0.04);
    }

    .reviews__brand {
        display: inline-flex;
        align-items: center;
    }

    /* Logotipo vectorial grande de Google con letras */
    .reviews__google-wordmark {
        display: block;
        width: 122px;
        height: 41px;
        flex-shrink: 0;
    }

    .reviews__stars-wrap {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    .reviews__stars {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .reviews__rating-text {
        font-size: 0.92rem;
        color: var(--color-primary-dark);
        font-weight: 650;
        white-space: nowrap;
    }

    .reviews__rating-text strong {
        font-weight: 850;
        color: var(--color-primary-dark);
        font-size: 1rem;
    }

    .reviews__rating-text--status {
        color: var(--color-text-soft);
        font-weight: 600;
        font-size: 0.86rem;
    }

    .reviews__dot {
        margin-inline: 0.4rem;
        color: rgba(23, 54, 97, 0.35);
    }

    /* --------------------------------------------------------------------------
       Carrusel de Reseñas
       -------------------------------------------------------------------------- */
    .reviews__carousel {
        position: relative;
        width: 100%;
    }

    .reviews__controls {
        position: absolute;
        top: -4.4rem;
        right: 0;
        display: flex;
        gap: 0.55rem;
        z-index: 2;
    }

    .reviews__control-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.12);
        color: var(--color-primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(23, 54, 97, 0.04);
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .reviews__control-btn:hover:not(:disabled) {
        background: var(--color-primary);
        color: #ffffff;
        border-color: var(--color-primary);
        transform: translateY(-1px);
    }

    .reviews__control-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* Track de desplazamiento */
    .reviews__track {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-block: 0.5rem 1.25rem;
        margin-inline: -0.25rem;
        padding-inline: 0.25rem;
    }

    .reviews__track::-webkit-scrollbar {
        display: none;
    }

    .reviews__track:focus-visible {
        outline: 2px solid var(--color-primary);
        border-radius: 1rem;
    }

    /* --------------------------------------------------------------------------
       Cards de Reseñas (Marfil / Blanco roto suave)
       -------------------------------------------------------------------------- */
    .review-card {
        flex: 0 0 calc((100% - (2 * 1.5rem)) / 3);
        box-sizing: border-box;
        scroll-snap-align: start;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.08);
        border-radius: 1.25rem;
        padding: clamp(1.4rem, 2vw, 1.85rem);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        box-shadow:
            0 8px 24px -6px rgba(23, 54, 97, 0.04),
            0 2px 6px rgba(23, 54, 97, 0.02);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }

    .review-card:hover {
        transform: translateY(-3px);
        border-color: rgba(66, 133, 244, 0.25);
        box-shadow:
            0 14px 32px -8px rgba(23, 54, 97, 0.08),
            0 4px 10px rgba(66, 133, 244, 0.04);
    }

    .review-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.85rem;
    }

    .review-card__author {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .review-card__avatar-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f6f1e8 0%, #ede4d5 100%);
        border: 1px solid rgba(23, 54, 97, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 0.98rem;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .review-card__avatar-img {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(23, 54, 97, 0.1);
        flex-shrink: 0;
    }

    .review-card__meta {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .review-card__name {
        font-size: 0.94rem;
        font-weight: 700;
        color: var(--color-primary-dark);
        letter-spacing: -0.01em;
    }

    .review-card__date {
        font-size: 0.76rem;
        color: var(--color-text-soft);
        margin-top: 0.15rem;
    }

    .review-card__google-source {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(23, 54, 97, 0.035);
        border: 1px solid rgba(23, 54, 97, 0.06);
        flex-shrink: 0;
    }

    .review-card__google-source svg {
        display: block;
    }

    .review-card__stars {
        display: inline-flex;
        align-items: center;
        gap: 2.5px;
        margin-bottom: 0.95rem;
    }

    .review-card__content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .review-card__text {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.65;
        color: var(--color-text);
        font-weight: 460;
        text-wrap: pretty;
    }

    .review-card__text--clamped {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 5;
        overflow: hidden;
    }

    .review-card__text--expanded {
        display: block;
        -webkit-line-clamp: unset;
    }

    .review-card__read-more {
        align-self: flex-start;
        margin-top: 0.5rem;
        padding: 0;
        background: none;
        border: none;
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.2s ease;
    }

    .review-card__read-more:hover {
        color: var(--color-primary-dark);
    }

    /* --------------------------------------------------------------------------
       CTA inferior: Ver todas las reseñas en Google →
       -------------------------------------------------------------------------- */
    .reviews__action {
        display: flex;
        justify-content: center;
        margin-top: clamp(2.5rem, 4vw, 3.5rem);
    }

    .reviews__cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--color-primary-dark);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        border-radius: 0.75rem;
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.12);
        box-shadow: 0 4px 14px rgba(23, 54, 97, 0.04);
        transition:
            background-color 0.25s ease,
            color 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }

    .reviews__cta-btn:hover {
        background-color: var(--color-primary);
        color: #ffffff;
        border-color: var(--color-primary);
        box-shadow: 0 8px 20px rgba(36, 79, 158, 0.2);
        transform: translateY(-2px);
    }

    .reviews__cta-arrow {
        transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .reviews__cta-btn:hover .reviews__cta-arrow {
        transform: translateX(4px);
    }

    /* ==========================================================================
       Tablet Breakpoint (max-width: 1024px): 2 cards por vista
       ========================================================================== */
    @media (max-width: 1024px) {
        .review-card {
            flex: 0 0 calc((100% - 1.25rem) / 2);
        }

        .reviews__track {
            gap: 1.25rem;
        }

        .reviews__controls {
            position: static;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
    }

    /* ==========================================================================
       Mobile Breakpoint (max-width: 680px): 1 card por vista + swipe natural
       ========================================================================== */
    @media (max-width: 680px) {
        .reviews {
            padding-block: 4.5rem 4rem;
        }

        .reviews__container {
            width: 100%;
            padding-inline: 18px;
        }

        .reviews__title {
            font-size: clamp(1.85rem, 6.8vw, 2.3rem);
        }

        .reviews__google-badge {
            padding: 0.65rem 1.15rem;
            gap: 0.75rem;
            width: 100%;
            max-width: 360px;
            box-sizing: border-box;
        }

        .reviews__google-wordmark {
            width: 105px;
            height: 35px;
        }

        .reviews__stars svg {
            width: 18px;
            height: 18px;
        }

        .reviews__rating-text {
            font-size: 0.82rem;
        }

        .review-card {
            flex: 0 0 100%;
            min-width: 100%;
            padding: 1.4rem 1.25rem;
            border-radius: 1.15rem;
        }

        .reviews__track {
            gap: 1rem;
            padding-inline: 0;
            margin-inline: 0;
        }

        .reviews__controls {
            position: static;
            justify-content: center;
            margin-bottom: 1.25rem;
            gap: 0.75rem;
        }

        .reviews__control-btn {
            width: 44px;
            height: 44px;
        }

        .reviews__cta-btn {
            width: 100%;
            min-height: 48px;
            justify-content: center;
            box-sizing: border-box;
            text-align: center;
        }
    }

    /* Reducción de movimiento */
    @media (prefers-reduced-motion: reduce) {
        .reviews__track {
            scroll-behavior: auto;
        }

        .review-card,
        .reviews__control-btn,
        .reviews__cta-btn,
        .reviews__cta-arrow {
            transition: none !important;
            transform: none !important;
        }
    }
</style>

<script>
    function initReviewsCarousel() {
        const track = document.getElementById("reviews-track");
        const prevBtn = document.getElementById("reviews-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("reviews-next") as HTMLButtonElement | null;

        if (!track || !prevBtn || !nextBtn || track.dataset.initialized) return;
        track.dataset.initialized = "true";

        function updateButtons() {
            if (!track || !prevBtn || !nextBtn) return;
            const scrollLeft = track.scrollLeft;
            const maxScroll = track.scrollWidth - track.clientWidth - 4;

            prevBtn.disabled = scrollLeft <= 4;
            nextBtn.disabled = scrollLeft >= maxScroll;
        }

        prevBtn.addEventListener("click", () => {
            if (!track) return;
            const card = track.querySelector(".review-card") as HTMLElement | null;
            const step = card ? card.offsetWidth + 24 : 320;
            track.scrollBy({ left: -step, behavior: "smooth" });
        });

        nextBtn.addEventListener("click", () => {
            if (!track) return;
            const card = track.querySelector(".review-card") as HTMLElement | null;
            const step = card ? card.offsetWidth + 24 : 320;
            track.scrollBy({ left: step, behavior: "smooth" });
        });

        track.addEventListener("scroll", updateButtons, { passive: true });
        window.addEventListener("resize", updateButtons, { passive: true });
        updateButtons();

        // Control accesible para "Leer más"
        const readMoreButtons = track.querySelectorAll(".review-card__read-more");
        readMoreButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const textEl = btn.previousElementSibling as HTMLElement | null;
                if (!textEl) return;

                const isExpanded = btn.getAttribute("aria-expanded") === "true";
                if (isExpanded) {
                    textEl.classList.remove("review-card__text--expanded");
                    textEl.classList.add("review-card__text--clamped");
                    btn.setAttribute("aria-expanded", "false");
                    btn.textContent = "Leer más";
                } else {
                    textEl.classList.remove("review-card__text--clamped");
                    textEl.classList.add("review-card__text--expanded");
                    btn.setAttribute("aria-expanded", "true");
                    btn.textContent = "Leer menos";
                }
            });
        });
    }

    function initReviews() {
        initReviewsCarousel();
    }

    document.addEventListener("DOMContentLoaded", initReviews);
    document.addEventListener("astro:page-load", initReviews);
</script>
