---
import { ChevronDown } from "lucide-astro";
import { faqs } from "../../data/faq";
---

<section class="py-[clamp(5rem,8vw,7.5rem)] bg-[#f7f6f2] border-t border-[rgba(23,54,97,0.08)]" id="faq">
    <div class="w-[min(100%-2.5rem,900px)] mx-auto box-border">
        <header class="text-center mb-[clamp(2.5rem,4vw,3.5rem)]">
            <p class="m-0 mb-[0.85rem] text-[var(--color-primary)] text-[0.82rem] font-bold tracking-[0.1em] uppercase">Dudas frecuentes</p>
            <h2 class="m-0 mb-4 text-[var(--color-primary-dark)] text-[clamp(2.1rem,3.5vw,2.9rem)] font-[750] leading-[1.15] tracking-[-0.035em] text-balance">Preguntas habituales de las familias</h2>
            <p class="m-0 text-[var(--color-text-soft)] text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.6] text-balance">
                Respuestas claras para que sepáis exactamente qué esperar desde el primer contacto.
            </p>
        </header>

        <div class="flex flex-col gap-4">
            {
                faqs.map((faq, index) => (
                    <details class="group/faq bg-white border border-[rgba(23,54,97,0.09)] rounded-[1.15rem] overflow-hidden transition-[border-color,box-shadow] duration-200 ease-[ease] [&[open]]:border-[rgba(36,79,158,0.2)] [&[open]]:shadow-[0_8px_24px_rgba(23,54,97,0.05)]" open={index === 0}>
                        <summary class="py-[1.35rem] px-[1.6rem] text-[1.08rem] font-bold text-[var(--color-primary-dark)] cursor-pointer flex justify-between items-center select-none list-none [&::-webkit-details-marker]:hidden">
                            <span>{faq.question}</span>
                            <ChevronDown size={18} class="text-[var(--color-primary)] transition-transform duration-250 ease-[ease] shrink-0 group-open/faq:[transform:rotate(180deg)]" aria-hidden="true" />
                        </summary>
                        <div class="pt-0 px-[1.6rem] pb-[1.4rem] text-[var(--color-text-soft)] text-[0.98rem] leading-[1.65]">
                            <p class="m-0">{faq.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

