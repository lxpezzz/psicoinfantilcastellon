---
import { ChevronDown } from "lucide-astro";
import { faqs } from "../../data/faq";
---

<section class="faq" id="faq">
    <div class="faq__container">
        <header class="faq__header">
            <p class="faq__eyebrow">Dudas frecuentes</p>
            <h2 class="faq__title">Preguntas habituales de las familias</h2>
            <p class="faq__intro">
                Respuestas claras para que sepáis exactamente qué esperar desde el primer contacto.
            </p>
        </header>

        <div class="faq__list">
            {
                faqs.map((faq, index) => (
                    <details class="faq__item" open={index === 0}>
                        <summary class="faq__question">
                            <span>{faq.question}</span>
                            <ChevronDown size={18} class="faq__icon" aria-hidden="true" />
                        </summary>
                        <div class="faq__answer">
                            <p>{faq.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    .faq {
        padding-block: clamp(5rem, 8vw, 7.5rem);
        background-color: #f7f6f2;
        border-top: 1px solid rgba(23, 54, 97, 0.08);
    }

    .faq__container {
        width: min(100% - 2.5rem, 900px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    .faq__header {
        text-align: center;
        margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    }

    .faq__eyebrow {
        margin: 0 0 0.85rem;
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .faq__title {
        margin: 0 0 1rem;
        color: var(--color-primary-dark);
        font-size: clamp(2.1rem, 3.5vw, 2.9rem);
        font-weight: 750;
        line-height: 1.15;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .faq__intro {
        margin: 0;
        color: var(--color-text-soft);
        font-size: clamp(1rem, 1.2vw, 1.15rem);
        line-height: 1.6;
        text-wrap: balance;
    }

    .faq__list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .faq__item {
        background: #ffffff;
        border: 1px solid rgba(23, 54, 97, 0.09);
        border-radius: 1.15rem;
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .faq__item[open] {
        border-color: rgba(36, 79, 158, 0.2);
        box-shadow: 0 8px 24px rgba(23, 54, 97, 0.05);
    }

    .faq__question {
        padding: 1.35rem 1.6rem;
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--color-primary-dark);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        list-style: none;
    }

    .faq__question::-webkit-details-marker {
        display: none;
    }

    .faq__icon {
        color: var(--color-primary);
        transition: transform 0.25s ease;
        flex-shrink: 0;
    }

    .faq__item[open] .faq__icon {
        transform: rotate(180deg);
    }

    .faq__answer {
        padding: 0 1.6rem 1.4rem;
        color: var(--color-text-soft);
        font-size: 0.98rem;
        line-height: 1.65;
    }

    .faq__answer p {
        margin: 0;
    }
</style>
