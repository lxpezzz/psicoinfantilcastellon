---
const linkClass = "mobile-menu__link text-[var(--color-primary-dark)]! text-[1.25rem] font-bold no-underline transition-[color] duration-200 ease-[ease] [&:hover]:text-[var(--color-primary)]!";
---

<div class="mobile-menu group/mobile-menu fixed inset-0 z-[999] pointer-events-none invisible transition-[visibility] duration-300 ease-[ease] [&.is-open]:pointer-events-auto [&.is-open]:visible min-[981px]:hidden" id="mobile-menu" aria-hidden="true">
    <div class="absolute inset-0 bg-[rgba(23,54,97,0.3)] backdrop-blur-[4px] opacity-0 transition-opacity duration-300 ease-[ease] group-[.is-open]/mobile-menu:opacity-100" id="mobile-menu-backdrop"></div>
    <div class="absolute top-0 right-0 bottom-0 w-[min(85vw,360px)] bg-[#fdfcf9] pt-24 px-8 pb-10 shadow-[-10px_0_30px_rgba(23,54,97,0.1)] flex flex-col justify-between [transform:translateX(100%)] transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] box-border group-[.is-open]/mobile-menu:[transform:translateX(0)]">
        <nav class="flex flex-col gap-5" aria-label="Navegación móvil secundaria">
            <a href="#como-trabajo" class={linkClass}>Cómo trabajo</a>
            <a href="#sobre-mi" class={linkClass}>Sobre mí</a>
            <a href="#resenas" class={linkClass}>Reseñas</a>
            <a href="#faq" class={linkClass}>Preguntas frecuentes</a>
        </nav>

        <div class="flex flex-col gap-5 pt-8 border-t border-[rgba(23,54,97,0.08)]">
            <a href="tel:+34614992148" class="flex flex-col items-center no-underline text-[0.88rem] text-[var(--color-text-soft)]! gap-1">
                <span>Consulta telefónica:</span>
                <strong class="text-[var(--color-primary)] text-[1.15rem]">614 99 21 48</strong>
            </a>
        </div>
    </div>
</div>

<script>
    function initMobileMenu() {
        const toggleBtn = document.getElementById("header-menu-btn");
        const menu = document.getElementById("mobile-menu");
        const backdrop = document.getElementById("mobile-menu-backdrop");
        const links = menu?.querySelectorAll(".mobile-menu__link");

        if (!toggleBtn || !menu || menu.dataset.initialized) return;
        menu.dataset.initialized = "true";

        const activeBtn = toggleBtn;
        const activeMenu = menu;

        function openMenu() {
            activeMenu.classList.add("is-open");
            activeMenu.setAttribute("aria-hidden", "false");
            activeBtn.setAttribute("aria-expanded", "true");
            document.body.classList.add("mobile-menu-open");
            document.body.style.overflow = "hidden";
        }

        function closeMenu() {
            activeMenu.classList.remove("is-open");
            activeMenu.setAttribute("aria-hidden", "true");
            activeBtn.setAttribute("aria-expanded", "false");
            document.body.classList.remove("mobile-menu-open");
            document.body.style.overflow = "";
        }

        window.addEventListener("mobile-menu:close", closeMenu);

        activeBtn.addEventListener("click", () => {
            const isOpen = activeMenu.classList.contains("is-open");
            if (isOpen) closeMenu();
            else openMenu();
        });

        backdrop?.addEventListener("click", closeMenu);

        links?.forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && menu.classList.contains("is-open")) {
                closeMenu();
            }
        });
    }

    initMobileMenu();
    document.addEventListener("astro:page-load", initMobileMenu);
</script>

