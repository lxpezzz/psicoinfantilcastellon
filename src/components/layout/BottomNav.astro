---
import { Home, PanelsTopLeft, Mail } from "lucide-astro";
---

<!-- Navegación inferior fija estilo app/Instagram, visible solo en móvil (<= 680px) -->
<nav class="bottom-nav hidden [@media(max-width:680px)]:block fixed bottom-[calc(10px+env(safe-area-inset-bottom,0px))] left-3 right-3 mx-auto max-w-[420px] h-[58px] z-[990] pointer-events-auto [transition:transform_0.3s_cubic-bezier(0.23,1,0.32,1),opacity_0.25s_ease,visibility_0.25s_ease] [@media(max-width:390px)]:left-[10px] [@media(max-width:390px)]:right-[10px] [@media(max-width:390px)]:h-14" id="bottom-nav" aria-label="Navegación rápida inferior">
    <div class="flex items-center justify-around w-full h-full bg-white/12 [backdrop-filter:blur(25px)_saturate(145%)] [-webkit-backdrop-filter:blur(25px)_saturate(145%)] border border-[rgba(23,54,97,0.09)] rounded-[20px] shadow-[0_10px_28px_-6px_rgba(23,54,97,0.1),0_2px_8px_rgba(0,0,0,0.03)] px-2 box-border [@media(max-width:390px)]:rounded-[18px]">
        <!-- 1. Inicio -->
        <a
            href="/"
            class="bottom-nav__item flex-1 h-full flex items-center justify-center no-underline relative rounded-[14px] [transition:color_0.2s_ease,transform_0.15s_ease,background-color_0.2s_ease] [-webkit-tap-highlight-color:transparent] [&:active]:[transform:scale(0.88)] [&:active]:bg-[rgba(23,54,97,0.05)] [&:focus-visible]:[outline:2px_solid_#244f9e] [&:focus-visible]:outline-offset-[-2px] [&:hover_svg]:text-[#244f9e] text-[#173661]!"
            aria-label="Inicio"
            id="bottom-nav-home"
        >
            <Home
                size={23}
                stroke-width={1.8}
                class="block transition-transform duration-200 ease-[ease]"
                aria-hidden="true"
            />
        </a>

        <!-- 2. Servicios -->
        <a href="#servicios" class="bottom-nav__item flex-1 h-full flex items-center justify-center no-underline relative rounded-[14px] [transition:color_0.2s_ease,transform_0.15s_ease,background-color_0.2s_ease] [-webkit-tap-highlight-color:transparent] [&:active]:[transform:scale(0.88)] [&:active]:bg-[rgba(23,54,97,0.05)] [&:focus-visible]:[outline:2px_solid_#244f9e] [&:focus-visible]:outline-offset-[-2px] [&:hover_svg]:text-[#244f9e] text-[#173661]!" aria-label="Servicios">
            <PanelsTopLeft
                size={23}
                stroke-width={1.8}
                class="block transition-transform duration-200 ease-[ease]"
                aria-hidden="true"
            />
        </a>

        <!-- 3. Contacto -->
        <a href="#contacto" class="bottom-nav__item flex-1 h-full flex items-center justify-center no-underline relative rounded-[14px] [transition:color_0.2s_ease,transform_0.15s_ease,background-color_0.2s_ease] [-webkit-tap-highlight-color:transparent] [&:active]:[transform:scale(0.88)] [&:active]:bg-[rgba(23,54,97,0.05)] [&:focus-visible]:[outline:2px_solid_#244f9e] [&:focus-visible]:outline-offset-[-2px] [&:hover_svg]:text-[#244f9e] text-[#173661]!" aria-label="Contacto">
            <Mail
                size={23}
                stroke-width={1.8}
                class="block transition-transform duration-200 ease-[ease]"
                aria-hidden="true"
            />
        </a>

        <!-- 4. WhatsApp -->
        <a
            href="https://wa.me/34614992148"
            class="bottom-nav__item flex-1 h-full flex items-center justify-center no-underline relative rounded-[14px] [transition:color_0.2s_ease,transform_0.15s_ease,background-color_0.2s_ease] [-webkit-tap-highlight-color:transparent] [&:active]:[transform:scale(0.88)] [&:active]:bg-[rgba(23,54,97,0.05)] [&:focus-visible]:[outline:2px_solid_#244f9e] [&:focus-visible]:outline-offset-[-2px] [&:hover_svg]:text-[#244f9e] text-[#1f7a4a]! [&:hover]:text-[#16653c]!"
            aria-label="WhatsApp"
            target="_blank"
            rel="noopener noreferrer"
        >
            <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="block transition-transform duration-200 ease-[ease]"
                aria-hidden="true"
            >
                <use href="/icons/sprite.svg#icon-whatsapp"></use>
            </svg>
        </a>
    </div>
</nav>

<style>
    @media (max-width: 680px) {
        /* Reserve room for the fixed bar, including the device safe area. */
        :global(body) {
            padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)) !important;
        }

        /* These selectors also respond to the mobile menu's external state. */
        .bottom-nav.is-hidden,
        :global(body.mobile-menu-open) .bottom-nav,
        :global(body:has(.mobile-menu.is-open)) .bottom-nav {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(120%);
        }
    }
</style>

<script>
    function initBottomNav() {
        const bottomNav = document.getElementById("bottom-nav");
        const homeBtn = document.getElementById("bottom-nav-home");
        const menu = document.getElementById("mobile-menu");

        if (!bottomNav || bottomNav.dataset.initialized) return;
        bottomNav.dataset.initialized = "true";

        // Comportamiento de clics en la barra inferior
        bottomNav.querySelectorAll(".bottom-nav__item").forEach((item) => {
            item.addEventListener("click", (e) => {
                // Si el menú móvil está abierto, cerrarlo
                if (
                    menu?.classList.contains("is-open") ||
                    document.body.classList.contains("mobile-menu-open")
                ) {
                    window.dispatchEvent(new CustomEvent("mobile-menu:close"));
                }

                // Smooth scroll para Inicio
                if (item === homeBtn || item.getAttribute("href") === "/") {
                    if (
                        window.location.pathname === "/" ||
                        window.location.pathname === ""
                    ) {
                        e.preventDefault();
                        window.scrollTo({ top: 0, behavior: "smooth" });
                    }
                }
            });
        });

        // Observar cambios en el menú móvil para sincronizar la visibilidad
        if (menu) {
            const observer = new MutationObserver(() => {
                const isOpen = menu.classList.contains("is-open");
                bottomNav.classList.toggle("is-hidden", isOpen);
            });
            observer.observe(menu, {
                attributes: true,
                attributeFilter: ["class"],
            });
        }
    }

    document.addEventListener("DOMContentLoaded", initBottomNav);
    document.addEventListener("astro:page-load", initBottomNav);
</script>
