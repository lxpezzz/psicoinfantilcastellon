---
// Footer.astro - Global Site Footer
import { Phone, Mail, MapPin } from "lucide-astro";

const currentYear = 2026;
---

<footer class="footer" id="pie-pagina" aria-label="Pie de página">
    <div class="footer__container">
        <!-- Zona Superior: Marca a la izquierda / Contacto a la derecha -->
        <div class="footer__top">
            <!-- Izquierda: Logo y descripción -->
            <div class="footer__brand">
                <img
                    src="/logo-psicoinfantil.svg"
                    alt="Psico Infantil Castellón"
                    class="header__logo"
                    width="180"
                    height="70"
                    loading="eager"
                />
                <p class="footer__tagline">
                    Psicología infantil y adolescente en Castellón
                </p>
            </div>

            <!-- Derecha: Solo teléfono, email y ubicación -->
            <div class="footer__contact">
                <div class="footer__contact-list">
                    <!-- Teléfono clicable -->
                    <a
                        href="tel:+34614992148"
                        class="footer__contact-item footer__contact-item--phone"
                    >
                        <Phone
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>614 99 21 48</span>
                    </a>

                    <!-- Email clicable -->
                    <a
                        href="mailto:info@psicoinfantil.com"
                        class="footer__contact-item footer__contact-item--email"
                    >
                        <Mail
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>info@psicoinfantil.com</span>
                    </a>

                    <!-- Ubicación / Dirección -->
                    <div
                        class="footer__contact-item footer__contact-item--address"
                    >
                        <MapPin
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>Castellón de la Plana</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Separador muy fino y discreto -->
        <hr class="footer__divider" aria-hidden="true" />

        <!-- Zona Inferior: Copyright y Enlaces Legales -->
        <div class="footer__bottom">
            <p class="footer__copyright">
                &copy; {currentYear} PsicoInfantil Castellón
            </p>

            <nav class="footer__legal" aria-label="Enlaces legales">
                <a href="/aviso-legal">Aviso legal</a>
                <span class="footer__dot" aria-hidden="true">·</span>
                <a href="/privacidad">
                    <span class="footer__legal-desktop"
                        >Política de privacidad</span
                    >
                    <span class="footer__legal-mobile">Privacidad</span>
                </a>
                <span class="footer__dot" aria-hidden="true">·</span>
                <a href="/cookies">
                    <span class="footer__legal-desktop"
                        >Política de cookies</span
                    >
                    <span class="footer__legal-mobile">Cookies</span>
                </a>
            </nav>
        </div>
    </div>
</footer>

<style>
    /* --------------------------------------------------------------------------
       Footer Global: Azul marino profundo, sin cards, sin sombras
       -------------------------------------------------------------------------- */
    .footer {
        background-color: #173661; /* Azul marino profundo coherente con la identidad */
        color: #f8fafc; /* Blanco roto para texto principal */
        padding-top: clamp(3rem, 4.5vw, 4rem);
        padding-bottom: clamp(2rem, 3.5vw, 2.75rem);
        position: relative;
    }

    .footer__container {
        width: min(100% - 2.5rem, 1220px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    /* --------------------------------------------------------------------------
       Zona Superior Desktop: Izquierda (Marca) / Derecha (Contacto)
       Acercado hacia el centro para reducir la sensación de vacío central
       -------------------------------------------------------------------------- */
    .footer__top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        max-width: 1040px; /* Acercamiento hacia el centro */
        margin-inline: auto;
    }

    /* Izquierda: Logo y Subtítulo */
    .footer__brand {
        display: flex;
        flex-direction: column;
    }

    .footer__logo {
        display: inline-flex;
        flex-direction: column;
        line-height: 1;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .footer__logo:hover {
        opacity: 0.92;
    }

    /* Logo/nombre aprox. 6-7% más grande */
    .footer__logo-main {
        color: #ffffff;
        font-size: 1.45rem;
        font-weight: 750;
        letter-spacing: -0.035em;
    }

    .footer__logo-sub {
        margin-top: 0.28rem;
        color: #9ccbf5;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.19em;
        text-transform: uppercase;
    }

    /* Subtítulo con mayor contraste y presencia */
    .footer__tagline {
        margin: 0.7rem 0 0;
        font-size: 0.93rem;
        color: rgba(248, 250, 252, 0.85); /* Mayor nitidez y contraste */
        line-height: 1.5;
        max-width: 36ch;
    }

    /* Derecha: Contacto (teléfono, email, ubicación) */
    .footer__contact {
        display: flex;
        align-items: flex-start;
        text-align: right;
    }

    /* Mayor separación vertical entre las 3 líneas */
    .footer__contact-list {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.85rem; /* Más aire entre líneas */
    }

    .footer__contact-item {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.93rem;
        color: rgba(248, 250, 252, 0.82);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer__item-icon {
        color: #9ccbf5;
        flex-shrink: 0;
    }

    /* Teléfono clicable */
    a.footer__contact-item--phone {
        color: #ffffff;
        font-weight: 650;
        font-size: 1rem;
        letter-spacing: 0.01em;
    }

    a.footer__contact-item--phone:hover {
        color: #9ccbf5;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Email clicable */
    a.footer__contact-item--email:hover {
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Ubicación / Dirección */
    .footer__contact-item--address {
        color: rgba(248, 250, 252, 0.75);
    }

    /* --------------------------------------------------------------------------
       Separador muy fino y discreto
       -------------------------------------------------------------------------- */
    .footer__divider {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 2.25rem 0 1.5rem;
        width: 100%;
    }

    /* --------------------------------------------------------------------------
       Zona Inferior: Copyright (Izquierda) / Enlaces Legales (Derecha)
       -------------------------------------------------------------------------- */
    .footer__bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-size: 0.83rem;
        color: rgba(248, 250, 252, 0.65);
    }

    .footer__copyright {
        margin: 0;
    }

    .footer__legal {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .footer__legal a {
        color: rgba(248, 250, 252, 0.68);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer__legal a:hover {
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .footer__dot {
        color: rgba(248, 250, 252, 0.3);
        user-select: none;
    }

    .footer__legal-mobile {
        display: none;
    }

    .footer__legal-desktop {
        display: inline;
    }

    /* --------------------------------------------------------------------------
       MÓVIL (< 768px):
       - Muy compacto, padding 2.25rem–2.75rem
       - Sin navegación principal (Inicio, Servicios, Contacto)
       - Orden exacto:
         1. Logo / nombre PsicoInfantil Castellón
         2. “Psicología infantil y adolescente en Castellón”
         3. Teléfono
         4. Email
         5. Castellón de la Plana
         6. Aviso legal · Privacidad · Cookies
         7. © 2026 PsicoInfantil Castellón
       -------------------------------------------------------------------------- */
    @media (max-width: 768px) {
        .footer {
            padding-top: 2.5rem;
            padding-bottom: 2.5rem;
        }

        .footer__container {
            width: 100%;
            padding-inline: 1.25rem;
        }

        .footer__top {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.25rem;
            max-width: 100%;
        }

        /* 1 y 2: Logo y Subtítulo */
        .footer__brand {
            align-items: center;
            text-align: center;
        }

        .footer__logo-main {
            font-size: 1.32rem;
        }

        .footer__tagline {
            margin-top: 0.35rem;
            font-size: 0.88rem;
            max-width: 32ch;
            text-align: center;
            color: rgba(248, 250, 252, 0.85);
        }

        /* 3, 4 y 5: Teléfono, Email, Dirección */
        .footer__contact {
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 100%;
        }

        .footer__contact-list {
            align-items: center;
            text-align: center;
            width: 100%;
            gap: 0.65rem;
        }

        /* 3. Teléfono primero */
        .footer__contact-item--phone {
            order: 1;
            font-size: 1.05rem;
            padding: 0.35rem 0.6rem;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* 4. Email segundo */
        .footer__contact-item--email {
            order: 2;
            font-size: 0.92rem;
            padding: 0.25rem 0.5rem;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* 5. Dirección tercera */
        .footer__contact-item--address {
            order: 3;
            font-size: 0.85rem;
            margin-top: 0.15rem;
        }

        /* Separador centrado y discreto */
        .footer__divider {
            width: 50px;
            margin: 1.4rem auto;
            border-top-color: rgba(255, 255, 255, 0.08);
        }

        /* Zona inferior: 6. Legal primero, 7. Copyright después */
        .footer__bottom {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.75rem;
        }

        .footer__legal {
            order: 1;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
        }

        .footer__legal a {
            padding: 0.25rem 0.35rem;
            font-size: 0.82rem;
        }

        .footer__legal-desktop {
            display: none;
        }

        .footer__legal-mobile {
            display: inline;
        }

        .footer__copyright {
            order: 2;
            font-size: 0.78rem;
            color: rgba(248, 250, 252, 0.55);
        }
    }

    /* Microajustes específicos para pantallas estrechas (390px o menor) */
    @media (max-width: 400px) {
        .footer {
            padding-top: 2.25rem;
            padding-bottom: 2.25rem;
        }

        .footer__container {
            padding-inline: 1rem;
        }

        .footer__tagline {
            font-size: 0.85rem;
        }

        .footer__contact-item--phone {
            font-size: 1rem;
        }
    }
</style>
