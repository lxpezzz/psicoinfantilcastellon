---
// Footer.astro - Global Site Footer
import { Phone, Mail, MapPin } from "lucide-astro";

const currentYear = 2026;
---

<footer class="footer" id="pie-pagina" aria-label="Pie de página">
    <div class="footer__container">
        <!-- Zona Superior: Marca a la izquierda / Contacto a la derecha -->
        <div class="footer__top">
            <!-- Izquierda: Logo y descripción -->
            <div class="footer__brand">
                <img
                    src="/logo_psicoinfantil_white.svg"
                    alt="Psico Infantil Castellón"
                    class="header__logo"
                    width="180"
                    height="70"
                    loading="eager"
                />
                <p class="footer__tagline">
                    Psicología infantil y adolescente en Castellón
                </p>
            </div>

            <!-- Derecha: Solo teléfono, email y ubicación -->
            <div class="footer__contact">
                <div class="footer__contact-list">
                    <!-- Teléfono clicable -->
                    <a
                        href="tel:+34614992148"
                        class="footer__contact-item footer__contact-item--phone"
                    >
                        <Phone
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>614 99 21 48</span>
                    </a>

                    <!-- Email clicable -->
                    <a
                        href="mailto:info@psicoinfantil.com"
                        class="footer__contact-item footer__contact-item--email"
                    >
                        <Mail
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>info@psicoinfantil.com</span>
                    </a>

                    <!-- Ubicación / Dirección -->
                    <div
                        class="footer__contact-item footer__contact-item--address"
                    >
                        <MapPin
                            size={15}
                            class="footer__item-icon"
                            aria-hidden="true"
                        />
                        <span>Castellón de la Plana</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Separador muy fino y discreto -->
        <hr class="footer__divider" aria-hidden="true" />

        <!-- Zona Inferior: Copyright y Enlaces Legales -->
        <div class="footer__bottom">
            <p class="footer__copyright">
                &copy; {currentYear} PsicoInfantil Castellón
            </p>

            <nav class="footer__legal" aria-label="Enlaces legales">
                <a href="/aviso-legal">Aviso legal</a>
                <span class="footer__dot" aria-hidden="true">·</span>
                <a href="/privacidad">
                    <span class="footer__legal-desktop"
                        >Política de privacidad</span
                    >
                    <span class="footer__legal-mobile">Privacidad</span>
                </a>
                <span class="footer__dot" aria-hidden="true">·</span>
                <a href="/cookies">
                    <span class="footer__legal-desktop"
                        >Política de cookies</span
                    >
                    <span class="footer__legal-mobile">Cookies</span>
                </a>
            </nav>
        </div>
    </div>
</footer>

<style>
    /* --------------------------------------------------------------------------
       Footer Global: Azul marino profundo, sin cards, sin sombras
       -------------------------------------------------------------------------- */
    .footer {
        background-color: #173661; /* Azul marino profundo coherente con la identidad */
        color: #f8fafc; /* Blanco roto para texto principal */
        padding-top: clamp(3rem, 4.5vw, 4rem);
        padding-bottom: clamp(2rem, 3.5vw, 2.75rem);
        position: relative;
    }

    .footer__container {
        width: min(100% - 2.5rem, 1220px);
        margin-inline: auto;
        box-sizing: border-box;
    }

    /* --------------------------------------------------------------------------
       Zona Superior Desktop: Izquierda (Marca) / Derecha (Contacto)
       Acercado hacia el centro para reducir la sensación de vacío central
       -------------------------------------------------------------------------- */
    .footer__top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    /* Izquierda: Logo y Subtítulo */
    .footer__brand {
        display: flex;
        flex-direction: column;
    }

    .footer__logo {
        display: inline-flex;
        flex-direction: column;
        line-height: 1;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .footer__logo:hover {
        opacity: 0.92;
    }

    /* Logo/nombre aprox. 6-7% más grande */
    .footer__logo-main {
        color: #ffffff;
        font-size: 1.45rem;
        font-weight: 750;
        letter-spacing: -0.035em;
    }

    .footer__logo-sub {
        margin-top: 0.28rem;
        color: #9ccbf5;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.19em;
        text-transform: uppercase;
    }

    /* Subtítulo con mayor contraste y presencia */
    .footer__tagline {
        margin: 0.7rem 0 0;
        font-size: 0.93rem;
        color: rgba(248, 250, 252, 0.85); /* Mayor nitidez y contraste */
        line-height: 1.5;
        max-width: 36ch;
    }

    /* Derecha: Contacto (teléfono, email, ubicación) */
    .footer__contact {
        display: flex;
        align-items: flex-start;
        text-align: right;
    }

    /* Mayor separación vertical entre las 3 líneas */
    .footer__contact-list {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.85rem; /* Más aire entre líneas */
    }

    .footer__contact-item {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.93rem;
        color: rgba(248, 250, 252, 0.82);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer__item-icon {
        color: #9ccbf5;
        flex-shrink: 0;
    }

    /* Teléfono clicable */
    a.footer__contact-item--phone {
        color: #ffffff;
        font-weight: 650;
        font-size: 1rem;
        letter-spacing: 0.01em;
    }

    a.footer__contact-item--phone:hover {
        color: #9ccbf5;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Email clicable */
    a.footer__contact-item--email:hover {
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* Ubicación / Dirección */
    .footer__contact-item--address {
        color: rgba(248, 250, 252, 0.75);
    }

    /* --------------------------------------------------------------------------
       Separador muy fino y discreto
       -------------------------------------------------------------------------- */
    .footer__divider {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 2.25rem 0 1.5rem;
        width: 100%;
    }

    /* --------------------------------------------------------------------------
       Zona Inferior: Copyright (Izquierda) / Enlaces Legales (Derecha)
       -------------------------------------------------------------------------- */
    .footer__bottom {
        max-width: 1220px;
        margin-inline: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .footer__copyright {
        margin: 0;
    }

    .footer__legal {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .footer__legal a {
        color: rgba(248, 250, 252, 0.68);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer__legal a:hover {
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .footer__dot {
        color: rgba(248, 250, 252, 0.3);
        user-select: none;
    }

    .footer__legal-mobile {
        display: none;
    }

    .footer__legal-desktop {
        display: inline;
    }

    /* --------------------------------------------------------------------------
       MÓVIL (< 768px):
       -------------------------------------------------------------------------- */
    @media (max-width: 768px) {
        .footer {
            padding-top: 1.8rem;
            padding-bottom: 1.8rem;
        }

        .footer__container {
            width: 100%;
            padding-inline: 1.25rem;
            box-sizing: border-box;
        }

        /* =========================
       BLOQUE SUPERIOR
       ========================= */

        .footer__top {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;

            width: 100%;
            max-width: 320px;
            margin-inline: auto;

            gap: 1.25rem;
        }

        /* Logo + subtítulo */
        .footer__brand {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .footer__logo {
            margin-inline: auto;
        }

        .footer__logo-main {
            font-size: 1.32rem;
        }

        .footer__tagline {
            margin-top: 0.35rem;
            margin-inline: auto;

            max-width: 250px;

            font-size: 0.88rem;
            line-height: 1.45;

            text-align: center;
            color: rgba(248, 250, 252, 0.85);
        }

        /* =========================
       CONTACTO
       ========================= */

        .footer__contact {
            width: 100%;
            max-width: 320px;
            margin-inline: auto;

            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .footer__contact-list {
            width: 100%;

            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.1rem;
            text-align: center;
        }

        /* Todos los elementos comparten el mismo eje */
        .footer__contact-item--phone,
        .footer__contact-item--email,
        .footer__contact-item--address {
            width: 100%;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            text-align: center;
            box-sizing: border-box;
            gap: 0.5rem;
        }

        /* Teléfono */
        .footer__contact-item--phone {
            order: 1;

            min-height: 44px;

            font-size: 1.05rem;
        }

        /* Email */
        .footer__contact-item--email {
            order: 2;

            min-height: 40px;

            font-size: 0.92rem;
        }

        /* Dirección */
        .footer__contact-item--address {
            order: 3;

            min-height: 36px;

            font-size: 0.85rem;
        }

        /* =========================
       SEPARADOR
       ========================= */

        .footer__divider {
            width: 54px;
            margin: 1.4rem auto;

            border-top-color: rgba(255, 255, 255, 0.08);
        }

        /* =========================
       BLOQUE INFERIOR
       ========================= */

        .footer__bottom {
            width: 100%;
            max-width: 320px;
            margin-inline: auto;

            display: flex;
            flex-direction: column;
            align-items: center;

            text-align: center;
            gap: 0.75rem;
        }

        /* Legales */
        .footer__legal {
            order: 1;

            width: 100%;

            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;

            gap: 0.5rem;
            text-align: center;
        }

        .footer__legal a {
            padding: 0.25rem 0.35rem;

            font-size: 0.82rem;
            text-align: center;
        }

        .footer__legal-desktop {
            display: none;
        }

        .footer__legal-mobile {
            display: inline;
        }

        /* Copyright */
        .footer__copyright {
            order: 2;

            width: 100%;
            margin: 0;

            font-size: 0.78rem;
            text-align: center;

            color: rgba(248, 250, 252, 0.55);
        }
    }

    /* =========================
   PANTALLAS ESTRECHAS
   ========================= */

    @media (max-width: 400px) {
        .footer {
            padding-top: 2.25rem;
            padding-bottom: 2.25rem;
        }

        .footer__container {
            padding-inline: 1rem;
        }

        .footer__top,
        .footer__contact,
        .footer__bottom {
            max-width: 300px;
        }

        .footer__tagline {
            max-width: 245px;
            font-size: 0.85rem;
        }

        .footer__contact-item--phone {
            font-size: 1rem;
        }

        .footer__contact-item--email {
            font-size: 0.88rem;
        }

        .footer__contact-item--address {
            font-size: 0.82rem;
        }

        .footer__legal {
            gap: 0.35rem;
        }

        .footer__legal a {
            font-size: 0.8rem;
        }

        .footer__copyright {
            font-size: 0.76rem;
        }
    }
</style>
