---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide-astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    post: CollectionEntry<"blog">;
    featured?: boolean;
    headingLevel?: 2 | 3;
}

const { post, featured = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const postUrl = `/blog/${post.id}/`;
const cardTitle = post.data.cardTitle ?? post.data.title;

const formattedDate = post.data.publishDate.toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const isoDate = post.data.publishDate.toISOString();
---

<article
    class="@container/blog-card group relative h-full min-w-0 overflow-hidden rounded-[1.35rem] border border-[rgba(23,54,97,0.08)] bg-white transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1 hover:border-[rgba(23,54,97,0.18)] hover:shadow-[0_18px_40px_-16px_rgba(23,54,97,0.12)] focus-within:ring-2 focus-within:ring-inset focus-within:ring-[var(--color-primary)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
    <div class="grid h-full grid-cols-1 grid-rows-[auto_1fr] @min-[40rem]/blog-card:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)] @min-[40rem]/blog-card:grid-rows-1">
        <!-- Imagen del artículo -->
        <div class="relative aspect-video min-w-0 overflow-hidden bg-[#eef1ed] @min-[40rem]/blog-card:aspect-auto @min-[40rem]/blog-card:min-h-[17rem]">
            <Image
                src={post.data.image}
                alt={post.data.imageAlt}
                widths={[380, 560, 760]}
                sizes="auto, (max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc((100vw - 72px) / 2), (max-width: 1259px) calc((100vw - 104px) / 3), 386px"
                quality={85}
                loading={featured ? "eager" : "lazy"}
                fetchpriority={featured ? "high" : undefined}
                class="absolute inset-0 h-full w-full object-cover object-[50%_42%] transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[rgba(23,54,97,0.15)] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
        </div>

        <!-- Contenido de la card -->
        <div class="flex min-w-0 flex-col justify-between p-5 @min-[22rem]/blog-card:p-6 @min-[40rem]/blog-card:p-7">
            <div class="flex min-w-0 flex-col gap-3">
                <!-- Categoría y Fecha -->
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-[0.75rem]">
                    <span class="inline-flex items-center rounded-full bg-[rgba(36,79,158,0.08)] px-2.5 py-0.5 font-bold tracking-wide text-[var(--color-primary)] uppercase">
                        {post.data.category}
                    </span>
                    <span class="inline-flex items-center gap-2.5">
                        <span class="text-[var(--color-text-soft)]/50 select-none" aria-hidden="true">·</span>
                        <time datetime={isoDate} class="whitespace-nowrap font-medium text-[var(--color-text-soft)]">
                            {formattedDate}
                        </time>
                    </span>
                </div>

                <!-- Título -->
                <Heading class="m-0 text-[1.3125rem] font-[750] leading-[1.28] tracking-[-0.025em] text-[var(--color-primary-dark)] transition-colors duration-200 group-hover:text-[var(--color-primary)] [text-wrap:balance]">
                    <a href={postUrl} class="block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                        <span class="line-clamp-3">{cardTitle}</span>
                    </a>
                </Heading>

                <!-- Extracto -->
                <p class="m-0 text-[0.9rem] leading-[1.65] text-[var(--color-text-soft)] line-clamp-2 [text-wrap:pretty]">
                    {post.data.description}
                </p>
            </div>

            <!-- Enlace CTA de card -->
            <div class="mt-3 text-[0.9rem] font-medium text-[var(--color-primary)]">
                <a href={postUrl} aria-label={`Leer artículo: ${cardTitle}`} class="inline-flex min-h-11 items-center gap-1.5 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                    <span>Leer artículo</span>
                    <ArrowRight
                        size={16}
                        stroke-width={2.2}
                        class="transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                        aria-hidden="true"
                    />
                </a>
            </div>
        </div>
    </div>
</article>
