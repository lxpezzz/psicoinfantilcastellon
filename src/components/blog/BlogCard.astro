---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide-astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    post: CollectionEntry<"blog">;
    featured?: boolean;
    headingLevel?: 2 | 3;
}

const { post, featured = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const postUrl = `/blog/${post.id}/`;

const formattedDate = post.data.publishDate.toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const isoDate = post.data.publishDate.toISOString();
---

<article
    class:list={[
        "group relative flex flex-col overflow-hidden rounded-[1.35rem] border border-[rgba(23,54,97,0.08)] bg-white transition-[transform,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1 hover:border-[rgba(23,54,97,0.18)] hover:shadow-[0_18px_40px_-16px_rgba(23,54,97,0.12)] focus-within:ring-2 focus-within:ring-inset focus-within:ring-[var(--color-primary)]",
        featured ? "md:grid md:grid-cols-2 md:items-center" : "",
    ]}
>
    <!-- Imagen del artículo -->
    <div class:list={[
        "relative overflow-hidden bg-[#eef1ed]",
        featured ? "h-full min-h-[260px] md:min-h-[340px]" : "aspect-[16/10]",
    ]}>
        <Image
            src={post.data.image}
            alt={post.data.imageAlt}
            widths={[380, 560, 760]}
            sizes={featured ? "(max-width: 768px) 100vw, 50vw" : "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"}
            quality={85}
            loading={featured ? "eager" : "lazy"}
            fetchpriority={featured ? "high" : undefined}
            class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[rgba(23,54,97,0.15)] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
    </div>

    <!-- Contenido de la card -->
    <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
        <div>
            <!-- Categoría y Fecha -->
            <div class="flex flex-wrap items-center gap-2.5 text-[0.78rem]">
                <span class="inline-flex items-center rounded-full bg-[rgba(36,79,158,0.08)] px-2.5 py-0.5 font-bold tracking-wide text-[var(--color-primary)] uppercase">
                    {post.data.category}
                </span>
                <span class="text-[var(--color-text-soft)]/50 select-none" aria-hidden="true">·</span>
                <time datetime={isoDate} class="font-medium text-[var(--color-text-soft)]">
                    {formattedDate}
                </time>
            </div>

            <!-- Título -->
            <Heading class="mb-0 mt-3 text-[1.22rem] font-[750] leading-[1.28] tracking-[-0.025em] text-[var(--color-primary-dark)] transition-colors duration-200 group-hover:text-[var(--color-primary)] [text-wrap:balance]">
                <a href={postUrl} class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                    <span class="absolute inset-0" aria-hidden="true"></span>
                    {post.data.title}
                </a>
            </Heading>

            <!-- Extracto -->
            <p class="mb-0 mt-2.5 text-[0.94rem] leading-[1.65] text-[var(--color-text-soft)] line-clamp-3 [text-wrap:pretty]">
                {post.data.description}
            </p>
        </div>

        <!-- Enlace CTA de card -->
        <div class="mt-6 flex items-center gap-1.5 text-[0.92rem] font-bold text-[var(--color-primary)]">
            <span>Leer artículo</span>
            <ArrowRight
                size={16}
                stroke-width={2.2}
                class="transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-x-1"
                aria-hidden="true"
            />
        </div>
    </div>
</article>
