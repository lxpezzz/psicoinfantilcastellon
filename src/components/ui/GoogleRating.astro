---
import { Star } from "lucide-astro";

interface Props {
    class?: string;
    score?: string;
    label?: string;
    href?: string;
}

const {
    class: className = "",
    score = "5/5",
    label = "Reseñas en Google",
    href = "#resenas",
} = Astro.props;
---

<a
    href={href}
    class:list={["google-rating inline-flex items-center gap-3 py-[0.55rem] px-4 rounded-[999px] bg-white/86 backdrop-blur-[12px] border border-[rgba(23,54,97,0.08)] shadow-[0_8px_24px_rgba(23,54,97,0.06)] no-underline cursor-pointer transition-[transform,background-color,box-shadow,border-color] duration-200 ease-[ease] [&:hover]:[transform:translateY(-2px)] [&:hover]:bg-white/95 [&:hover]:border-[rgba(36,79,158,0.2)] [&:hover]:shadow-[0_12px_28px_rgba(23,54,97,0.11)]", className]}
    aria-label={`Ver ${score} estrellas en ${label}`}
>
    <div class="flex items-center justify-center shrink-0" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18">
            <use href="/icons/sprite.svg#icon-google"></use>
        </svg>
    </div>
    <div class="flex flex-col leading-[1.15]">
        <div class="flex items-center gap-[0.4rem]">
            <span class="text-[0.88rem] font-[750] text-[var(--color-primary-dark)] leading-none">{score}</span>
            <div class="inline-flex items-center gap-0.5" aria-hidden="true">
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
            </div>
        </div>
        <span class="text-[0.72rem] font-medium text-[var(--color-text-soft)] mt-[0.15rem] whitespace-nowrap">{label}</span>
    </div>
</a>

