---
import { Star } from "lucide-astro";

interface Props {
    class?: string;
    score?: string;
    label?: string;
    href?: string;
}

const {
    class: className = "",
    score = "5/5",
    label = "Reseñas en Google",
    href = "#resenas",
} = Astro.props;
---

<a
    href={href}
    class:list={["google-rating", className]}
    aria-label={`Ver ${score} estrellas en ${label}`}
>
    <div class="google-rating__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.26v3.15C3.25 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.26C.46 8.16 0 9.97 0 12s.46 3.84 1.26 5.42l4.02-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.25 2.64 1.26 6.58l4.02 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
        </svg>
    </div>
    <div class="google-rating__info">
        <div class="google-rating__rating">
            <span class="google-rating__score">{score}</span>
            <div class="google-rating__stars" aria-hidden="true">
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
                <Star size={11} fill="#f59e0b" color="#f59e0b" stroke-width={0} />
            </div>
        </div>
        <span class="google-rating__label">{label}</span>
    </div>
</a>

<style>
    .google-rating {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(23, 54, 97, 0.08);
        box-shadow: 0 8px 24px rgba(23, 54, 97, 0.06);
        text-decoration: none;
        cursor: pointer;
        transition:
            transform 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .google-rating:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(36, 79, 158, 0.2);
        box-shadow: 0 12px 28px rgba(23, 54, 97, 0.11);
    }

    .google-rating__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .google-rating__info {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .google-rating__rating {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .google-rating__score {
        font-size: 0.88rem;
        font-weight: 750;
        color: var(--color-primary-dark);
        line-height: 1;
    }

    .google-rating__stars {
        display: inline-flex;
        align-items: center;
        gap: 2px;
    }

    .google-rating__label {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--color-text-soft);
        margin-top: 0.15rem;
        white-space: nowrap;
    }
</style>
