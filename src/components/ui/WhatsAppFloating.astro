<a
    class="whatsapp-floating"
    href="https://wa.me/34614992148"
    target="_blank"
    rel="noopener noreferrer"
>
    <span class="sr-only">Contactar con PsicoInfantil por WhatsApp</span>
    <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
    >
        <use href="/icons/sprite.svg#icon-whatsapp"></use>
    </svg>
</a>

<style>
    .whatsapp-floating {
        display: flex;
        position: fixed;
        right: calc(24px + env(safe-area-inset-right, 0px));
        bottom: calc(var(--whatsapp-cookie-offset, 24px) + env(safe-area-inset-bottom, 0px));
        z-index: 980;
        width: 56px;
        height: 56px;
        align-items: center;
        justify-content: center;
        border: 1px solid #15803d;
        border-radius: 50%;
        background-color: #25d366;
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(23, 54, 97, 0.16);
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .whatsapp-floating:focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: 4px;
    }

    /* Complementa exactamente la navegación móvil, visible hasta 680px. */
    @media (max-width: 680px) {
        .whatsapp-floating {
            display: none;
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .whatsapp-floating:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(23, 54, 97, 0.2);
        }
    }

    /* Solo se oculta mientras el menú principal ocupa la pantalla. */
    :global(body.mobile-menu-open) .whatsapp-floating,
    :global(body:has(.mobile-menu.is-open)) .whatsapp-floating {
        visibility: hidden;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .whatsapp-floating {
            transition: none;
        }

        .whatsapp-floating:hover {
            transform: none;
        }
    }
</style>

<script>
    function initWhatsAppFloating() {
        const button = document.querySelector<HTMLElement>(".whatsapp-floating");
        const banner = document.getElementById("cookie-banner");

        if (!button || !banner || button.dataset.initialized) return;
        button.dataset.initialized = "true";

        const updatePosition = () => {
            if (banner.getAttribute("aria-hidden") !== "false") {
                button.style.removeProperty("--whatsapp-cookie-offset");
                return;
            }

            const bannerBottom = Number.parseFloat(getComputedStyle(banner).bottom) || 0;
            const offset = Math.ceil(banner.offsetHeight + bannerBottom + 16);
            button.style.setProperty("--whatsapp-cookie-offset", `${offset}px`);
        };

        new ResizeObserver(updatePosition).observe(banner);
        new MutationObserver(updatePosition).observe(banner, {
            attributes: true,
            attributeFilter: ["aria-hidden"],
        });
        updatePosition();
    }

    initWhatsAppFloating();
    document.addEventListener("astro:page-load", initWhatsAppFloating);
</script>
