---
import { HeartHandshake } from "lucide-astro";

interface Props {
    class?: string;
    phone?: string;
    question?: string;
    tagline?: string;
}

const {
    class: className = "",
    phone = "614 99 21 48",
    question = "¿Te preocupa algo de tu hijo?",
    tagline = "Hablemos con calma.",
} = Astro.props;

const cleanPhone = phone.replace(/\s+/g, "");
---

<a
    href={`tel:+34${cleanPhone}`}
    class:list={["phone-cta", className]}
    aria-label={`Llamar para hablar de tu caso: ${phone}`}
>
    <div class="phone-cta__icon" aria-hidden="true">
        <HeartHandshake size={20} stroke-width={1.8} />
    </div>
    <div class="phone-cta__body">
        <span class="phone-cta__question">{question}</span>
        <span class="phone-cta__tagline">{tagline}</span>
        <span class="phone-cta__phone">{phone}</span>
    </div>
</a>

<style>
    .phone-cta {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1.1rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.84);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(23, 54, 97, 0.08);
        box-shadow: 0 10px 28px rgba(23, 54, 97, 0.07);
        text-decoration: none;
        cursor: pointer;
        box-sizing: border-box;
        transition:
            transform 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .phone-cta:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.94);
        border-color: rgba(36, 79, 158, 0.2);
        box-shadow: 0 14px 34px rgba(23, 54, 97, 0.11);
    }

    .phone-cta__icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--color-primary);
        color: white;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .phone-cta__body {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .phone-cta__question {
        font-size: 0.76rem;
        color: var(--color-text-soft);
        font-weight: 500;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .phone-cta__tagline {
        font-size: 0.88rem;
        color: var(--color-primary-dark);
        font-weight: 650;
        line-height: 1.25;
        margin-top: 0.1rem;
    }

    .phone-cta__phone {
        font-size: 1.05rem;
        color: var(--color-primary);
        font-weight: 750;
        line-height: 1.2;
        margin-top: 0.25rem;
        letter-spacing: 0.02em;
    }
</style>
