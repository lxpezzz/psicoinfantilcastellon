---
import { HeartHandshake } from "lucide-astro";

interface Props {
    class?: string;
    phone?: string;
    question?: string;
    tagline?: string;
}

const {
    class: className = "",
    phone = "614 99 21 48",
    question = "¿Te preocupa algo de tu hijo?",
    tagline = "Hablemos con calma.",
} = Astro.props;

const cleanPhone = phone.replace(/\s+/g, "");
---

<a
    href={`tel:+34${cleanPhone}`}
    class:list={["phone-cta flex items-center gap-[0.85rem] py-[0.85rem] px-[1.1rem] rounded-2xl bg-white/84 backdrop-blur-[12px] border border-[rgba(23,54,97,0.08)] shadow-[0_10px_28px_rgba(23,54,97,0.07)] no-underline cursor-pointer box-border transition-[transform,background-color,box-shadow,border-color] duration-200 ease-[ease] [&:hover]:[transform:translateY(-2px)] [&:hover]:bg-white/94 [&:hover]:border-[rgba(36,79,158,0.2)] [&:hover]:shadow-[0_14px_34px_rgba(23,54,97,0.11)]", className]}
    aria-label={`Llamar para hablar de tu caso: ${phone}`}
>
    <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] text-white grid place-items-center shrink-0" aria-hidden="true">
        <HeartHandshake size={20} stroke-width={1.8} />
    </div>
    <div class="flex flex-col min-w-0">
        <span class="text-[0.76rem] text-[var(--color-text-soft)] font-medium leading-[1.25] truncate">{question}</span>
        <span class="text-[0.88rem] text-[var(--color-primary-dark)] font-[650] leading-[1.25] mt-[0.1rem]">{tagline}</span>
        <span class="text-[1.05rem] text-[var(--color-primary)] font-[750] leading-[1.2] mt-1 tracking-[0.02em]">{phone}</span>
    </div>
</a>

