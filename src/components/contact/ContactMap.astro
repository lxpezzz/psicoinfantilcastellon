---
import {
    MapPin,
    Navigation,
    Car,
    Bus,
    ShieldCheck,
    ExternalLink,
} from "lucide-astro";
import Button from "../ui/Button.astro";
import { location } from "../../data/location";
---

<section
    class="contact-page-map [--color-text-soft:#506176] py-[clamp(3.5rem,6vw,5rem)] bg-[#eef3f0] border-t border-[rgba(23,54,97,0.08)]"
    aria-labelledby="map-heading"
>
    <div class="section-container">
        <!-- 1. Cabecera de la Sección de Ubicación -->
        <div class="max-w-[760px] text-left mb-8 sm:mb-10">
            <h2
                id="map-heading"
                class="text-[clamp(1.85rem,3.2vw,2.5rem)] font-[750] text-[var(--color-primary-dark)] tracking-[-0.03em] m-0 mb-4 [text-wrap:balance]"
            >
                ¿Dónde está nuestra consulta?
            </h2>
            <p
                class="text-[1.02rem] leading-[1.68] text-[var(--color-text-soft)] m-0 [text-wrap:pretty]"
            >
                Ubicada en una zona tranquila y accesible de Castellón de la
                Plana, pensada para que las familias y los menores acudan con
                total comodidad, discreción y sin agobios.
            </p>
        </div>

        <div
            class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.5fr)_minmax(260px,0.85fr)] gap-8 lg:gap-12 items-start"
        >
            <!-- Mapa con un único marco y la información práctica a su lado -->
            <div class="min-w-0">
                <!-- Marco Interno con el iframe interactivo -->
                <div
                    class="rounded-[1rem] overflow-hidden relative w-full h-[320px] sm:h-[400px] bg-[#eaf0f6]"
                    data-consent-map
                >
                    <div class="contact-page-map__consent" data-map-notice>
                        <p id="map-consent-description">
                            Para mostrar el mapa, Google recibirá tu dirección IP y podrá utilizar cookies según su política de privacidad.
                            Solo se cargará si lo autorizas aquí, independientemente de las cookies estadísticas.
                        </p>
                        <button type="button" class="contact-page-map__control" data-map-accept aria-describedby="map-consent-description" hidden>
                            Autorizar y cargar Google Maps
                        </button>
                        <p class="contact-page-map__help">Puedes usar el enlace «Cómo llegar» sin cargar el mapa en esta web.</p>
                    </div>
                    <button type="button" class="contact-page-map__control contact-page-map__revoke" data-map-revoke hidden>
                        Desactivar mapa
                    </button>
                    <template data-map-template>
                        <iframe
                        data-src={location.googleMapsEmbedUrl}
                        class="w-full h-full border-0 absolute inset-0"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        title="Ubicación exacta de PsicoInfantil Castellón en Google Maps"
                        ></iframe>
                    </template>
                </div>

                <!-- Barra Inferior de Acción y Dirección Verificada -->
                <div
                    class="pt-5 flex flex-col xl:flex-row items-start xl:items-center justify-between gap-5"
                >
                    <div class="flex items-center gap-3">
                        <div class="text-[var(--color-primary)] shrink-0">
                            <MapPin size={20} aria-hidden="true" />
                        </div>
                        <a
                            href={location.googleMapsUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                        >
                            <strong
                                class="text-[0.98rem] font-bold text-[var(--color-primary-dark)] block"
                            >
                                {location.streetAddress},
                            </strong>
                            <span
                                class="text-[0.84rem] text-[var(--color-text-soft)]"
                            >
                                {location.locality}
                            </span>
                        </a>
                    </div>

                    <!-- Botón Abrir en Google Maps / Cómo llegar -->
                    <Button
                        href={location.googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        size="md"
                        class="group w-full sm:w-auto shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                    >
                        <Navigation size={16} aria-hidden="true" />
                        <span>Cómo llegar en Google Maps</span>
                        <ExternalLink
                            size={14}
                            class="opacity-70 group-hover:opacity-100 transition-opacity"
                            aria-hidden="true"
                        />
                    </Button>
                </div>
            </div>

            <!-- Información práctica sin tarjetas decorativas -->
            <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-7">
                <!-- Aparcamiento -->
                <div
                    class="border-t border-[rgba(23,54,97,0.16)] pt-5 flex flex-col gap-2.5"
                >
                    <div class="text-[var(--color-primary)] mb-1">
                        <Car size={21} aria-hidden="true" />
                    </div>
                    <strong
                        class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                    >
                        Aparcamiento en la zona
                    </strong>
                    <p
                        class="text-[0.95rem] leading-[1.7] text-[var(--color-text-soft)] m-0"
                    >
                        Facilidad para estacionar en las calles adyacentes y
                        avenidas próximas (zona de aparcamiento público sin
                        parquímetros).
                    </p>
                </div>

                <!-- Transporte Público -->
                <div
                    class="border-t border-[rgba(23,54,97,0.16)] pt-5 flex flex-col gap-2.5"
                >
                    <div class="text-[var(--color-primary)] mb-1">
                        <Bus size={21} aria-hidden="true" />
                    </div>
                    <strong
                        class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                    >
                        Transporte y accesos
                    </strong>
                    <p
                        class="text-[0.95rem] leading-[1.7] text-[var(--color-text-soft)] m-0"
                    >
                        Autobús: L12 (paradas Riu Sella / Riu Nalón) y líneas
                        L8, L18 y L9 a pocos minutos andando.
                    </p>
                </div>

                <!-- Privacidad y Puntualidad -->
                <div
                    class="border-t border-[rgba(23,54,97,0.16)] pt-5 flex flex-col gap-2.5"
                >
                    <div class="text-[var(--color-primary)] mb-1">
                        <ShieldCheck size={21} aria-hidden="true" />
                    </div>
                    <strong
                        class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                    >
                        Atención privada y sin esperas
                    </strong>
                    <p
                        class="text-[0.95rem] leading-[1.7] text-[var(--color-text-soft)] m-0"
                    >
                        Cada sesión se programa con el tiempo necesario para
                        garantizar puntualidad, intimidad y que las familias
                        nunca coincidan en la sala de espera.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-page-map__consent {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 1.5rem;
        text-align: center;
        color: var(--color-primary-dark);
    }

    .contact-page-map__consent[hidden],
    .contact-page-map__control[hidden] {
        display: none;
    }

    .contact-page-map__consent p {
        max-width: 58ch;
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .contact-page-map__consent .contact-page-map__help {
        font-size: 0.875rem;
    }

    .contact-page-map__control {
        padding: 0.7rem 1rem;
        border: 1px solid var(--color-primary);
        border-radius: 0.75rem;
        background: white;
        color: var(--color-primary-dark);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
    }

    .contact-page-map__control:hover {
        background: var(--color-bg);
    }

    .contact-page-map__control:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
    }

    .contact-page-map__revoke {
        position: absolute;
        z-index: 1;
        top: 0.75rem;
        right: 0.75rem;
    }
</style>

<script>
    import { CONSENT_KEY, CONSENT_DATE_KEY, readCookieConsent } from "../../scripts/cookie-consent";

    const container = document.querySelector<HTMLElement>("[data-consent-map]");
    const notice = container?.querySelector<HTMLElement>("[data-map-notice]");
    const accept = container?.querySelector<HTMLButtonElement>("[data-map-accept]");
    const revoke = container?.querySelector<HTMLButtonElement>("[data-map-revoke]");
    const template = container?.querySelector<HTMLTemplateElement>("[data-map-template]");

    if (container && notice && accept && revoke && template) {
        accept.hidden = false;

        function disableMap(restoreFocus = false) {
            container?.querySelector("iframe")?.remove();
            if (notice) notice.hidden = false;
            if (revoke) revoke.hidden = true;
            if (restoreFocus) accept?.focus({ preventScroll: true });
        }

        accept.addEventListener("click", () => {
            if (container.querySelector("iframe")) return;
            const frame = template.content.querySelector("iframe")?.cloneNode(true) as HTMLIFrameElement | undefined;
            if (!frame?.dataset.src) return;
            frame.src = frame.dataset.src;
            frame.removeAttribute("data-src");
            container.append(frame);
            notice.hidden = true;
            revoke.hidden = false;
            revoke.focus({ preventScroll: true });
        });
        revoke.addEventListener("click", () => disableMap(true));
        // El permiso es específico de este documento; no se guarda ni activa GA4.
        window.addEventListener("pagehide", () => disableMap());
        window.addEventListener("cookie-consent-updated", () => {
            if (readCookieConsent() !== "all") disableMap(document.activeElement === revoke);
        });
        window.addEventListener("storage", event => {
            if ((event.key === null || event.key === CONSENT_KEY || event.key === CONSENT_DATE_KEY) && readCookieConsent() !== "all") disableMap();
        });
    }
</script>
