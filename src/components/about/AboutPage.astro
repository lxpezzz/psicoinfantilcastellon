---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import { location } from "../../data/location";
import {
    Award,
    GraduationCap,
    School,
    HeartHandshake,
    Users,
    Brain,
    Scale,
    CheckCircle2,
    ArrowRight,
    Phone,
    Mail,
    MapPin,
    ShieldCheck,
    ChevronDown,
    Clock,
} from "lucide-astro";
import anaImg from "../../images/about/ana-diaz.webp";
---

<article
    class="about-page [--color-text-soft:#506176] border-t border-[rgba(23,54,97,0.08)] pt-[clamp(1.5rem,3vw,2.5rem)] pb-[clamp(4rem,7vw,6rem)] bg-[#faf9f5] text-[var(--color-text)]"
>
    <div class="section-container">
        <!-- 1. Breadcrumbs de Navegación (sin eyebrow) -->
        <nav
            class="inline-flex items-center gap-2 text-[0.85rem] text-[var(--color-text-soft)] mb-6 sm:mb-8"
            aria-label="Miga de pan"
        >
            <a
                href="/"
                class="text-[var(--color-primary)] no-underline hover:text-[var(--color-primary-dark)] hover:underline transition-colors"
            >
                Inicio
            </a>
            <span class="opacity-40" aria-hidden="true">/</span>
            <span
                class="font-semibold text-[var(--color-primary-dark)]"
                aria-current="page"
            >
                Sobre mí
            </span>
        </nav>

        <!-- 2. Hero Editorial: Titular, Presentación Íntima y Retrato Oficial -->
        <header class="mb-[clamp(2.5rem,5vw,4rem)]">
            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-9 lg:gap-16 items-start"
            >
                <!-- Columna de Texto: 7 cols en Desktop -->
                <div class="lg:col-span-7 flex flex-col items-start">
                    <h1
                        class="text-[clamp(2rem,3.4vw,3rem)] font-[750] leading-[1.12] tracking-[-0.035em] text-[var(--color-primary-dark)] m-0 mb-6 [text-wrap:balance]"
                    >
                        Más de 20 años acompañando a niños, adolescentes y
                        familias para entender qué está pasando.
                    </h1>

                    <p
                        class="max-w-[60ch] text-[1.02rem] sm:text-[1.08rem] leading-[1.75] text-[var(--color-text-soft)] m-0 mb-7 [text-wrap:pretty]"
                    >
                        Soy <strong>Ana Díaz Berbel</strong>, psicóloga
                        sanitaria infantil y juvenil en Castellón con <strong
                            >Nº de Colegiada CV08027</strong
                        >. Acompaño a familias y colegios para comprender las
                        dificultades de aprendizaje, encontrar pautas prácticas
                        y apoyar el bienestar del niño en el aula y en casa.
                    </p>

                    <!-- Acciones con el mismo componente de las páginas de servicio -->
                    <div
                        class="flex flex-wrap items-center gap-4 w-full sm:w-auto"
                    >
                        <Button
                            href="/#contacto"
                            size="md"
                            class="w-full sm:w-auto focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                        >
                            <span>Hablemos de vuestro caso</span>
                            <ArrowRight size={17} aria-hidden="true" />
                        </Button>

                        <Button
                            href="tel:+34614992148"
                            variant="secondary"
                            size="md"
                            class="w-full sm:w-auto focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                        >
                            <Phone
                                size={17}
                                class="text-[var(--color-primary)]"
                                aria-hidden="true"
                            />
                            <span>Llamar al 614 99 21 48</span>
                        </Button>
                    </div>
                </div>

                <!-- Retrato sin marcos superpuestos ni información sobre la fotografía -->
                <div
                    class="lg:col-span-5 flex flex-col items-center lg:items-end"
                >
                    <figure class="m-0 w-full max-w-[400px]">
                        <div
                            class="rounded-[1rem] overflow-hidden bg-[#eef3f0] aspect-[4/4.8]"
                        >
                            <Image
                                src={anaImg}
                                alt="Ana Díaz Berbel, psicóloga infantil y juvenil en Castellón colegiada CV08027"
                                class="w-full h-full object-cover object-top"
                                width={840}
                                height={1008}
                                quality={92}
                                format="webp"
                                widths={[380, 480, 760, 840]}
                                sizes="(max-width: 439px) calc(100vw - 40px), 400px"
                                loading="eager"
                                fetchpriority="high"
                            />
                        </div>
                        <figcaption
                            class="flex items-start gap-2.5 pt-4 text-[var(--color-primary-dark)]"
                        >
                            <ShieldCheck
                                size={18}
                                class="mt-0.5 shrink-0 text-[var(--color-primary)]"
                                aria-hidden="true"
                            />
                            <div class="flex flex-col gap-1">
                                <strong class="text-[0.95rem] font-[650]"
                                    >Ana Díaz Berbel</strong
                                >
                                <span
                                    class="text-[0.8rem] text-[var(--color-text-soft)]"
                                    >Col. CV08027 · COP Comunitat Valenciana</span
                                >
                            </div>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </header>

        <blockquote
            class="m-0 max-w-[900px] border-t border-[rgba(23,54,97,0.12)] pt-7 mb-[clamp(2.5rem,5vw,4rem)]"
        >
            <p
                class="m-0 text-[clamp(1.15rem,2vw,1.5rem)] font-[500] leading-[1.6] tracking-[-0.015em] text-[var(--color-primary-dark)] [text-wrap:pretty]"
            >
                “Mi trabajo no concluye cuando entrego un informe; continúa
                acompañando a la familia y al colegio para comprender los
                resultados y orientar los siguientes pasos.”
            </p>
        </blockquote>

        <!-- Trayectoria sin tarjetas repetidas -->
        <section
            class="mb-[clamp(3.5rem,6vw,5.5rem)]"
            aria-label="Cifras clave y trayectoria de Ana Díaz"
        >
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
                <!-- Cifra 1: Dirección Ágora Lledó -->
                <div class="border-t border-[rgba(23,54,97,0.12)] pt-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="text-[var(--color-primary)]">
                            <School size={22} aria-hidden="true" />
                        </div>
                        <span
                            class="text-[3rem] font-[650] leading-none tracking-[-0.04em] text-[var(--color-primary-dark)]"
                        >
                            19
                        </span>
                    </div>
                    <div>
                        <h2
                            class="text-[1.15rem] font-bold text-[var(--color-primary-dark)] m-0 mb-2"
                        >
                            Años dirigiendo orientación escolar
                        </h2>
                        <p
                            class="text-[0.9rem] leading-[1.62] text-[var(--color-text-soft)] m-0"
                        >
                            Lideré durante casi dos décadas el Departamento
                            Psicopedagógico de <strong
                                >Ágora Lledó International School</strong
                            > en Castellón, coordinando la atención a la diversidad
                            y las adaptaciones curriculares.
                        </p>
                    </div>
                </div>

                <!-- Cifra 2: Experiencia Clínica y Sanitaria -->
                <div class="border-t border-[rgba(23,54,97,0.12)] pt-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="text-[var(--color-primary)]">
                            <Clock size={22} aria-hidden="true" />
                        </div>
                        <span
                            class="text-[3rem] font-[650] leading-none tracking-[-0.04em] text-[var(--color-primary-dark)]"
                        >
                            +20
                        </span>
                    </div>
                    <div>
                        <h2
                            class="text-[1.15rem] font-bold text-[var(--color-primary-dark)] m-0 mb-2"
                        >
                            Años de experiencia profesional
                        </h2>
                        <p
                            class="text-[0.9rem] leading-[1.62] text-[var(--color-text-soft)] m-0"
                        >
                            Más de dos décadas diagnosticando e interviniendo en
                            TDAH, altas capacidades, dislexia, bajo rendimiento
                            escolar y acompañamiento a adolescentes en Castellón
                            de la Plana.
                        </p>
                    </div>
                </div>

                <!-- Cifra 3: Familias Acompañadas -->
                <div class="border-t border-[rgba(23,54,97,0.12)] pt-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="text-[var(--color-primary)]">
                            <HeartHandshake size={22} aria-hidden="true" />
                        </div>
                        <span
                            class="text-[3rem] font-[650] leading-none tracking-[-0.04em] text-[var(--color-primary-dark)]"
                        >
                            +250
                        </span>
                    </div>
                    <div>
                        <h2
                            class="text-[1.15rem] font-bold text-[var(--color-primary-dark)] m-0 mb-2"
                        >
                            Familias acompañadas
                        </h2>
                        <p
                            class="text-[0.9rem] leading-[1.62] text-[var(--color-text-soft)] m-0"
                        >
                            Padres y madres acompañados para comprender mejor
                            cómo aprende su hijo, encontrar pautas para el día a
                            día y afrontar las dificultades con más recursos.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. El Gran Factor Diferencial: La Visión 360º (Colegio + Familia + Consulta) -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]">
            <div
                class="bg-[var(--color-primary-dark)] rounded-[1rem] p-[clamp(1.5rem,4vw,3rem)] text-white"
            >
                <div class="max-w-[780px] mb-8 sm:mb-10">
                    <div class="text-[0.9rem] font-[500] text-[#b6cce2] mb-5">
                        <span>El verdadero valor diferencial</span>
                    </div>
                    <h2
                        class="text-[clamp(1.75rem,3vw,2.5rem)] font-[650] leading-[1.16] tracking-[-0.03em] text-white m-0 mb-5 [text-wrap:balance]"
                    >
                        El puente entre la consulta de psicología y la realidad
                        del aula escolar
                    </h2>
                    <p
                        class="text-[1.02rem] leading-[1.68] text-[#d1dced] m-0 [text-wrap:pretty]"
                    >
                        Los informes psicopedagógicos resultan más útiles cuando
                        sus conclusiones se traducen en orientaciones que
                        encajan con el día a día del aula. Haber estado casi 20
                        años dentro de un colegio me permite ofrecer una visión
                        360º: <strong
                            >hablo el mismo idioma que los docentes</strong
                        > y puedo proponer apoyos adaptados al contexto de cada centro.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-6 border-t border-white/12 pt-8"
                >
                    <!-- Vértice 1: Consulta -->
                    <div class="flex flex-col gap-2.5">
                        <div class="text-[#b6cce2] mb-2">
                            <Brain size={21} aria-hidden="true" />
                        </div>
                        <strong class="text-[1.1rem] font-bold text-white"
                            >1. En la consulta</strong
                        >
                        <p
                            class="text-[0.9rem] leading-[1.65] text-[#cbd7e6] m-0"
                        >
                            Una valoración individualizada para comprender las
                            dificultades, identificar fortalezas y orientar los
                            siguientes pasos.
                        </p>
                    </div>

                    <!-- Vértice 2: Colegio -->
                    <div class="flex flex-col gap-2.5">
                        <div class="text-[#b6cce2] mb-2">
                            <School size={21} aria-hidden="true" />
                        </div>
                        <strong class="text-[1.1rem] font-bold text-white"
                            >2. En el colegio</strong
                        >
                        <p
                            class="text-[0.9rem] leading-[1.65] text-[#cbd7e6] m-0"
                        >
                            Orientaciones que tienen en cuenta las necesidades
                            del alumno y la realidad del entorno educativo.
                        </p>
                    </div>

                    <!-- Vértice 3: Hogar -->
                    <div class="flex flex-col gap-2.5">
                        <div class="text-[#b6cce2] mb-2">
                            <HeartHandshake size={21} aria-hidden="true" />
                        </div>
                        <strong class="text-[1.1rem] font-bold text-white"
                            >3. En el hogar</strong
                        >
                        <p
                            class="text-[0.9rem] leading-[1.65] text-[#cbd7e6] m-0"
                        >
                            Pautas prácticas que pueden ayudar a las familias a
                            acompañar a sus hijos en el día a día.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. Biografía y Vocación: La Historia de Ana Díaz -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]">
            <div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
                    <div class="lg:col-span-6 flex flex-col justify-center">
                        <h2
                            class="text-[clamp(1.6rem,2.6vw,2.15rem)] font-extrabold text-[var(--color-primary-dark)] tracking-[-0.03em] m-0 mb-4 [text-wrap:balance]"
                        >
                            De Galicia a Castellón: una vida dedicada a la
                            psicología y la educación.
                        </h2>
                        <p
                            class="text-[0.95rem] leading-[1.7] text-[var(--color-text-soft)] m-0 mb-4"
                        >
                            Nací en Galicia, pero Castellón es mi ciudad, mi
                            hogar y donde he desarrollado íntegramente mi
                            carrera profesional y mi familia.
                        </p>
                        <p
                            class="text-[0.95rem] leading-[1.7] text-[var(--color-text-soft)] m-0"
                        >
                            Mi vocación comenzó al comprender que muchos niños
                            tachados de "vagos", "distraídos" o "desmotivados"
                            simplemente procesan la información de manera
                            diferente. Ayudarles a entenderse y darles las
                            llaves de su propio aprendizaje es la experiencia
                            más gratificante de mi vida.
                        </p>
                    </div>

                    <div
                        class="lg:col-span-6 flex flex-col justify-center bg-[#eef3f0] rounded-[1rem] p-6 sm:p-8"
                    >
                        <h3
                            class="text-[1.12rem] font-bold text-[var(--color-primary-dark)] m-0 mb-3"
                        >
                            Por qué creé PsicoInfantil Castellón
                        </h3>
                        <p
                            class="text-[0.92rem] leading-[1.68] text-[var(--color-text-soft)] m-0 mb-4"
                        >
                            Tras coordinar durante casi dos décadas equipos
                            psicopedagógicos en un colegio de referencia
                            internacional, sentí la necesidad de crear un
                            espacio donde atender a las familias con el tiempo,
                            la serenidad y la dedicación artesanal que cada niño
                            merece.
                        </p>
                        <p
                            class="text-[0.92rem] leading-[1.68] text-[var(--color-text-soft)] m-0"
                        >
                            En mi consulta en <a
                                href={location.googleMapsUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-inherit underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                                ><strong>{location.address}</strong></a
                            >, cuidamos el tiempo de escucha y adaptamos la
                            atención a cada familia. Cada caso se valora de
                            forma individual, con una evaluación ajustada a sus
                            necesidades y un acompañamiento cercano desde la
                            primera sesión.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. Formación Académica, Rigor Forense y Colegiación -->
        <section
            class="mb-[clamp(3.5rem,6vw,5.5rem)]"
            aria-labelledby="education-heading"
        >
            <div>
                <div class="max-w-[760px] mb-8">
                    <h2
                        id="education-heading"
                        class="text-[clamp(1.5rem,2.5vw,2rem)] font-extrabold text-[var(--color-primary-dark)] tracking-[-0.03em] m-0 mb-2.5"
                    >
                        Formación y experiencia al servicio de niños,
                        adolescentes y familias
                    </h2>
                    <p
                        class="text-[0.95rem] leading-[1.65] text-[var(--color-text-soft)] m-0"
                    >
                        La empatía y la calidez van de la mano de una
                        metodología rigurosa y una valoración cuidadosa de cada
                        caso. Mi trayectoria está respaldada por titulaciones
                        oficiales y formación continuada:
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-8">
                    <!-- Licenciatura -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.12)] pt-5 flex flex-col gap-2.5"
                    >
                        <div class="text-[var(--color-primary)] mb-1">
                            <GraduationCap size={22} aria-hidden="true" />
                        </div>
                        <strong
                            class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                            >Licenciada en Psicología</strong
                        >
                        <span
                            class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--color-primary)]"
                            >Universitat de València</span
                        >
                        <p
                            class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0"
                        >
                            Especialización en psicología evolutiva, educativa y
                            neuropsicología del desarrollo infantil y
                            adolescente.
                        </p>
                    </div>

                    <!-- Colegiatura Oficial -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.12)] pt-5 flex flex-col gap-2.5"
                    >
                        <div class="text-[var(--color-primary)] mb-1">
                            <ShieldCheck size={22} aria-hidden="true" />
                        </div>
                        <strong
                            class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                            >Colegiada Oficial CV08027</strong
                        >
                        <span
                            class="text-[0.82rem] font-bold uppercase tracking-wider text-[#1e6e4a]"
                            >COP Comunitat Valenciana</span
                        >
                        <p
                            class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0"
                        >
                            Colegiación profesional, compromiso deontológico y
                            seguro de responsabilidad civil profesional.
                        </p>
                    </div>

                    <!-- Máster Forense -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.12)] pt-5 flex flex-col gap-2.5"
                    >
                        <div class="text-[var(--color-primary)] mb-1">
                            <Scale size={22} aria-hidden="true" />
                        </div>
                        <strong
                            class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                            >Máster en Psicología Forense</strong
                        >
                        <span
                            class="text-[0.82rem] font-bold uppercase tracking-wider text-[#8c3b47]"
                            >UNIR</span
                        >
                        <p
                            class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0"
                        >
                            Esta formación aporta herramientas para la
                            evaluación psicológica y la elaboración de informes
                            profesionales dentro del ámbito de competencia de la
                            psicología.
                        </p>
                    </div>

                    <!-- Mediación Familiar -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.12)] pt-5 flex flex-col gap-2.5"
                    >
                        <div class="text-[var(--color-primary)] mb-1">
                            <Users size={22} aria-hidden="true" />
                        </div>
                        <strong
                            class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                            >Experta en Mediación Familiar</strong
                        >
                        <span
                            class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--color-primary)]"
                            >Didáctica y Resolución de Conflictos</span
                        >
                        <p
                            class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0"
                        >
                            Especializada en restaurar la convivencia familiar,
                            resolver desacuerdos educativos y establecer pautas
                            de crianza positiva.
                        </p>
                    </div>

                    <!-- Divulgación y Formación -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.12)] pt-5 flex flex-col gap-2.5 sm:col-span-2"
                    >
                        <div class="text-[var(--color-primary)] mb-1">
                            <Award size={22} aria-hidden="true" />
                        </div>
                        <strong
                            class="text-[1.05rem] font-bold text-[var(--color-primary-dark)]"
                            >Divulgadora y Conferenciante Educativa</strong
                        >
                        <span
                            class="text-[0.82rem] font-bold uppercase tracking-wider text-[#1e6e4a]"
                            >Formación a Claustros y Familias</span
                        >
                        <p
                            class="text-[0.88rem] leading-[1.6] text-[var(--color-text-soft)] m-0"
                        >
                            Imparto ponencias, seminarios y escuelas de padres
                            sobre detección temprana de altas capacidades,
                            dificultades lectoescritoras, gestión del TDAH en el
                            aula y salud mental en la adolescencia en Castellón
                            y la Comunitat Valenciana.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7. Los 4 Pilares de mi Método de Trabajo -->
        <section class="mb-[clamp(3.5rem,6vw,5.5rem)]">
            <div class="bg-[#eef3f0] rounded-[1rem] p-[clamp(1.5rem,4vw,3rem)]">
                <div class="max-w-[760px] mb-8 sm:mb-10">
                    <h2
                        class="text-[clamp(1.5rem,2.5vw,2rem)] font-extrabold text-[var(--color-primary-dark)] tracking-[-0.03em] m-0 mb-2.5"
                    >
                        Cómo trabajamos juntos: 4 principios irrenunciables
                    </h2>
                    <p
                        class="text-[0.95rem] leading-[1.65] text-[var(--color-text-soft)] m-0"
                    >
                        Cada familia que cruza la puerta de PsicoInfantil
                        Castellón encuentra un entorno seguro y una metodología
                        basada en cuatro compromisos éticos:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Pilar 1 -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.16)] pt-5 flex flex-col gap-3"
                    >
                        <div class="flex items-center gap-3">
                            <span
                                class="text-[var(--color-primary)] font-[650] text-[0.85rem]"
                                >01</span
                            >
                            <h3
                                class="text-[1.1rem] font-bold text-[var(--color-primary-dark)] m-0"
                            >
                                Comprender antes de etiquetar
                            </h3>
                        </div>
                        <p
                            class="text-[0.9rem] leading-[1.65] text-[var(--color-text-soft)] m-0"
                        >
                            Un diagnóstico no debe encasillar a un niño ni
                            limitar su futuro. Puede ayudar a comprender sus
                            dificultades y fortalezas y a orientar los apoyos
                            que podrían favorecer su aprendizaje y bienestar.
                        </p>
                    </div>

                    <!-- Pilar 2 -->
                    <div
                        class="border-t border-[rgba(23,54,97,0.16)] pt-5 flex flex-col gap-3"
                    >
                        <div class="flex items-center gap-3">
                            <span
                                class="text-[var(--color-primary)] font-[650] text-[0.85rem]"
                                >02</span
                            >
                            <h3
                                class="text-[1.1rem] font-bold text-[var(--color-primary-dark)] m-0"
                            >
