                <div class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-[rgba(23,54,97,0.18)] pt-6 lg:pt-0 lg:pl-8 flex flex-col gap-3 text-[var(--color-primary-dark)] text-[0.9rem]">
