---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "../ui/Button.astro";
import { ArrowRight } from "lucide-astro";

export interface Props {
    breadcrumbLabel?: string;
    breadcrumbHref?: string;
    parentBreadcrumbLabel?: string;
    parentBreadcrumbHref?: string;
    eyebrow: string;
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt: string;
}

const {
    breadcrumbLabel,
    breadcrumbHref,
    parentBreadcrumbLabel = "Servicios",
    parentBreadcrumbHref = "/#servicios",
    eyebrow,
    title,
    description,
    image,
    imageAlt,
} = Astro.props;

const currentBreadcrumbLabel = breadcrumbLabel || eyebrow;
const currentBreadcrumbHref = breadcrumbHref || Astro.url.pathname;
const imageMaxWidth = Math.min(580, Math.round((image.width / image.height) * 460));
---

<section
    class="border-t border-[rgba(23,54,97,0.08)] bg-[#f7f5f0] pt-6 pb-12 sm:pt-8 sm:pb-16 lg:pt-10 lg:pb-20"
>
    <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="mb-6 sm:mb-8 lg:mb-10">
            <ol
                class="m-0 flex flex-wrap items-center gap-2 p-0 list-none text-[0.82rem] font-medium text-[var(--color-text-soft)]"
            >
                <li>
                    <a
                        href="/"
                        class="transition-colors duration-150 hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] rounded-sm"
                    >
                        Inicio
                    </a>
                </li>
                <li
                    class="text-[var(--color-primary)]/35 select-none text-[0.75rem]"
                    aria-hidden="true"
                >
                    /
                </li>
                <li>
                    <a
                        href={parentBreadcrumbHref}
                        class="transition-colors duration-150 hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] rounded-sm"
                    >
                        {parentBreadcrumbLabel}
                    </a>
                </li>
                <li
                    class="text-[var(--color-primary)]/35 select-none text-[0.75rem]"
                    aria-hidden="true"
                >
                    /
                </li>
                <li>
                    <a
                        href={currentBreadcrumbHref}
                        aria-current="page"
                        class="font-semibold text-[var(--color-primary-dark)] transition-colors duration-150 hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] rounded-sm"
                    >
                        {currentBreadcrumbLabel}
                    </a>
                </li>
            </ol>
        </nav>

        <!-- Eyebrow -->
        <p
            class="mb-3.5 text-[0.78rem] font-bold tracking-[0.14em] text-[var(--color-primary)] uppercase sm:mb-4 lg:mb-5"
        >
            {eyebrow}
        </p>

        <!-- Editorial Grid -->
        <div
            class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start lg:gap-12 xl:gap-16"
        >
            <div class="lg:col-span-7 xl:col-span-7">
                <h1
                    class="m-0 text-[2.15rem] font-[750] leading-[1.12] tracking-[-0.035em] text-[var(--color-primary-dark)] sm:text-[2.5rem] lg:text-[2.8rem] xl:text-[3rem] [text-wrap:balance]"
                >
                    {title}
                </h1>

                <p
                    class="service-intro__description max-w-[54ch] text-[1.05rem] leading-[1.75] text-[var(--color-text-soft)] sm:text-[1.125rem] [text-wrap:pretty]"
                >
                    {description}
                </p>

                <div class="service-intro__actions">
                    <Button
                        href="#contacto"
                        variant="primary"
                        size="lg"
                        class="service-intro__btn"
                    >
                        <span>Cuéntame tu caso</span>
                        <ArrowRight
                            size={19}
                            stroke-width={2}
                            aria-hidden="true"
                        />
                    </Button>
                </div>
            </div>

            <div class="lg:col-span-5 xl:col-span-5">
                <div
                    class="relative mx-auto w-full overflow-hidden rounded-2xl border border-[rgba(23,54,97,0.08)] bg-[#e6ece7] shadow-[0_4px_24px_-10px_rgba(23,54,97,0.08)] lg:mx-0"
                    style={{ maxWidth: `${imageMaxWidth}px` }}
                >
                    <Image
                        src={image}
                        alt={imageAlt}
                        widths={[400, 640, 800, 1024]}
                        sizes="(max-width: 1023px) min(100vw - 2.5rem, 580px), 480px"
                        quality={88}
                        loading="eager"
                        fetchpriority="high"
                        class="block h-auto w-full"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .service-intro__description {
        margin-block: clamp(1.5rem, 2vw, 2.5rem) 0;
    }
    .service-intro__actions {
        margin-top: clamp(1.5rem, 2vw, 2.5rem);
    }
    :global(.ui-btn.service-intro__btn) {
        border-radius: 50% 10% 50% 10% / 10% 50% 10% 50%;
    }
</style>
