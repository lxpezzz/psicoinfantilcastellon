---
import {
    Activity,
    ArrowUpRight,
    Brain,
    CircleAlert,
    Clock,
    FileCheck,
    FileText,
    HeartHandshake,
    ListChecks,
    Sliders,
    Target,
    Users,
    Zap,
} from "lucide-astro";
import { services } from "../../data/services";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceSignals from "./ServiceSignals.astro";
import ServiceAssessment from "./ServiceAssessment.astro";
import ServiceManifesto from "./ServiceManifesto.astro";
import ServiceAreas, { type AreaItem } from "./ServiceAreas.astro";
import RelatedServices, {
    type RelatedServiceItem,
} from "./RelatedServices.astro";
import ServiceFAQ, { type FAQItem } from "./ServiceFAQ.astro";
import ServiceCTA from "./ServiceCTA.astro";

const adhdService = services.find((service) => service.id === "tdah");

if (!adhdService) {
    throw new Error(
        "No se ha encontrado el servicio de tratamiento y evaluación de TDAH.",
    );
}

const situations = [
    {
        icon: Brain,
        text: "Se distrae con facilidad o parece que está continuamente 'en las nubes'.",
    },
    {
        icon: CircleAlert,
        text: "Falla en los exámenes por no leer bien los enunciados o saltarse pasos por precipitación.",
    },
    {
        icon: Clock,
        text: "Empieza las tareas pero no las acaba, dejando deberes a medias por desorganización.",
    },
    {
        icon: HeartHandshake,
        text: "Pierde el control emocional con rapidez: se frustra, explota o le cuesta gestionar cambios.",
    },
    {
        icon: Activity,
        text: "Muestra inquietud motora continua: le cuesta permanecer sentado o toquetea objetos sin parar.",
    },
    {
        icon: FileText,
        text: "Dudas si es TDAH, inmadurez evolutiva, desmotivación o un bloqueo emocional no resuelto.",
    },
];

const perspectives = [
    {
        number: "01",
        icon: Target,
        title: "Medición rigurosa de la atención",
        text: "Exploramos las dificultades de atención y su repercusión en las tareas y rutinas, teniendo en cuenta la edad, el contexto y la información aportada por la familia y el colegio.",
    },
    {
        number: "02",
        icon: Sliders,
        title: "Entrenamiento en Funciones Ejecutivas",
        text: "El acompañamiento aborda la planificación, la organización y el control de impulsos con objetivos ajustados a sus necesidades cotidianas.",
    },
    {
        number: "03",
        icon: Users,
        title: "Acompañamiento a familia y aula",
        text: "Orientamos pautas para casa y recomendaciones que el equipo educativo pueda valorar según las necesidades del alumno y el contexto escolar.",
    },
];

const areas: AreaItem[] = [
    {
        icon: Brain,
        title: "Entrenamiento en Funciones Ejecutivas",
        description:
            "Planificación, memoria operativa, flexibilidad cognitiva y organización mental aplicada al estudio diario.",
        span: "md:col-span-7",
        bgVariant: "primary",
    },
    {
        icon: Zap,
        title: "Autorregulación y control inhibitorio",
        description:
            "Estrategias prácticas para frenar la impulsividad, esperar turnos y pensar antes de actuar.",
        span: "md:col-span-5",
        bgVariant: "sage",
    },
    {
        icon: Target,
        title: "Atención sostenida y selectiva",
        description:
            "Apoyo para reconocer distracciones, ajustar las tareas y buscar formas de mantener o recuperar la atención, respetando sus necesidades de descanso.",
        span: "md:col-span-4",
        bgVariant: "white",
    },
    {
        icon: HeartHandshake,
        title: "Gestión emocional y frustración",
        description:
            "Acompañamiento para reconocer la frustración, comprender qué situaciones le resultan difíciles y explorar formas de responder a ellas.",
        span: "md:col-span-4",
        bgVariant: "dusty-rose",
    },
    {
        icon: FileCheck,
        title: "Adaptaciones escolares en el aula",
        description:
            "Recomendaciones para que el equipo educativo valore ajustes en las tareas, las instrucciones y la evaluación según las necesidades detectadas.",
        span: "md:col-span-4",
        bgVariant: "primary-dark",
    },
    {
        icon: ListChecks,
        title: "Organización de tareas y agenda",
        description:
            "Apoyo para organizar materiales, tareas y recordatorios con rutinas ajustadas a su edad y a las dificultades observadas.",
        span: "md:col-span-5",
        bgVariant: "white",
    },
    {
        icon: ArrowUpRight,
        title: "Estrategias ante exámenes",
        description:
            "Orientación para comprender los enunciados, distribuir el tiempo y revisar las respuestas teniendo en cuenta sus dificultades de atención e impulsividad.",
        span: "md:col-span-3",
        bgVariant: "blue-soft",
    },
    {
        icon: Users,
        title: "Asesoramiento familiar en casa",
        description:
            "Pautas para adaptar las rutinas, comunicar las indicaciones con claridad y acompañar las dificultades de atención e impulsividad en casa.",
        span: "md:col-span-4",
        bgVariant: "sage-light",
    },
];

const relatedServicesList: RelatedServiceItem[] = [
    {
        description: "Evaluación de las dificultades de atención y aprendizaje",
        href: "/evaluacion-y-diagnostico/",
    },
    {
        description: "Técnicas de estudio, planificación y método",
        href: "/mejora-del-rendimiento-escolar/",
    },
    {
        description: "Rutinas y pautas para acompañar el TDAH en casa",
        href: "/asesoramiento-a-padres/",
    },
];

const faqs: FAQItem[] = [
    {
        question:
            "¿Cómo diferenciar si es TDAH o simplemente inmadurez o falta de atención temporal?",
        answer: "No se distingue por una conducta aislada. Se valora la persistencia de las dificultades, su intensidad, su evolución y cómo interfieren en casa, en el colegio y en otros entornos. La evaluación ayuda a explorar si son compatibles con TDAH o si conviene considerar otras explicaciones.",
    },
    {
        question: "¿Es imprescindible medicar a un niño con diagnóstico de TDAH?",
        answer: "No todos los niños con TDAH necesitan el mismo abordaje. La indicación de medicación corresponde al profesional médico, que valora cada caso. El apoyo psicopedagógico puede abordar las dificultades de aprendizaje, organización y autorregulación, dentro de un plan ajustado a las necesidades del menor.",
    },
    {
        question: "¿Qué adaptaciones metodológicas debe realizar el colegio?",
        answer: "Las medidas se valoran según las necesidades del alumno y el procedimiento educativo aplicable. Pueden incluir instrucciones más claras, ajustes en la organización de las tareas o apoyos en la evaluación. El equipo de orientación del centro concreta qué medidas corresponden en cada situación.",
    },
    {
        question: "¿Puede tener TDAH aunque sus notas sean altas o sea muy inteligente?",
        answer: "Sí. Las buenas notas o una elevada capacidad intelectual no descartan dificultades de atención o impulsividad. También importa el esfuerzo necesario, la organización, la autonomía y su funcionamiento fuera de los exámenes. La repercusión puede cambiar con las demandas de cada etapa.",
    },
    {
        question: "¿Cómo ayudáis a las familias en casa con las batallas de los deberes?",
        answer: "Revisamos qué momentos de los deberes generan más dificultad y orientamos pautas adaptadas a la familia: cómo organizar las tareas, comunicar las indicaciones y acompañar la frustración. Las propuestas se ajustan a lo que resulte viable en vuestro día a día.",
    },
];
---

<main class="overflow-x-clip bg-[#f7f8f6] pt-[88px]" id="servicios">
    <!-- 1. ServiceIntro -->
    <ServiceIntro
        breadcrumbLabel={adhdService.shortTitle}
        eyebrow={adhdService.title}
        title="Le cuesta mantener la atención, aunque quiera hacerlo bien"
        description="Las dificultades de atención e impulsividad no deben interpretarse automáticamente como falta de voluntad. En PsicoInfantil Castellón valoramos cómo afectan al aprendizaje y a la vida cotidiana para orientar el acompañamiento en organización, funciones ejecutivas y autorregulación."
        image={adhdService.heroImage}
        imageAlt={adhdService.alt}
    />

    <!-- 2. ServiceSignals -->
    <ServiceSignals
        title="¿Sientes que su esfuerzo nunca llega a verse reflejado?"
        description="Las dificultades de atención, organización o control de impulsos pueden manifestarse de formas distintas y tener diferentes explicaciones. Estas señales ayudan a describir lo que observáis, pero por sí solas no confirman un TDAH."
        signals={situations}
    />

    <!-- 3. ServiceAssessment -->
    <ServiceAssessment
        id="como-trabajamos"
        title="La atención es como un músculo: si no se entrena correctamente, se debilita"
        description="Antes de orientar los apoyos, valoramos cómo se presentan las dificultades, desde cuándo se observan y cómo afectan a distintos ámbitos. La información recogida permite explorar posibles explicaciones y concretar objetivos de acompañamiento con la familia y, cuando procede, con el centro escolar."
        perspectives={perspectives}
    />

    <!-- 4. ServiceManifesto -->
    <ServiceManifesto
        secondaryPhrase="El TDAH no se cura con castigos."
        secondaryHighlight="castigos"
        mainPhrase="Se entrena como una habilidad ejecutiva."
        mainHighlight="habilidad ejecutiva"
        explanation="No es un niño 'malo' ni 'vago', sino alguien cuya función ejecutiva y control de la conducta funcionan de forma diferente. El objetivo no es que obedezca sin más, sino que aprenda a comprenderse, autorregularse y desarrollar todo su potencial con seguridad."
    />

    <!-- 5. ServiceAreas -->
    <ServiceAreas
        title="¿Qué trabajamos en la intervención de TDAH?"
        areas={areas}
        description="Los objetivos se ajustan a las dificultades de atención, las funciones ejecutivas y la autorregulación, considerando su repercusión en el aprendizaje y en el día a día."
    />

    <!-- 6. RelatedServices -->
    <RelatedServices
        title="Servicios complementarios para su progreso escolar"
        description="La evaluación ayuda a comprender las dificultades de atención. El trabajo sobre el estudio y las pautas familiares permite trasladar los apoyos al colegio y al día a día en casa."
        services={relatedServicesList}
    />

    <!-- 7. ServiceFAQ -->
    <ServiceFAQ title="Preguntas frecuentes sobre TDAH" faqs={faqs} />

    <!-- 8. ServiceCTA -->
    <ServiceCTA
        title="¿Sientes que el día a día se ha convertido en una batalla? Hablemos."
        titleUnderline="Hablemos"
        description="Cuéntame vuestra situación. Si ves que le cuesta arrancar con los deberes, se olvida de las tareas o su impulsividad está afectando a su autoestima, estoy aquí para ayudaros. Escríbeme sin compromiso y tracemos un plan juntos."
        primaryCtaText="Solicitar valoración"
        primaryCtaHref="#contacto"
        phoneText="También puedes llamar al 614 99 21 48"
        phoneHref="tel:+34614992148"
    />
</main>
