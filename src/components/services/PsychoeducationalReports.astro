---
import {
    ArrowUpRight,
    Award,
    Brain,
    CircleAlert,
    ClipboardCheck,
    Compass,
    FileCheck,
    FileSpreadsheet,
    FileText,
    GraduationCap,
    HeartHandshake,
    ListChecks,
    Scale,
    School,
} from "lucide-astro";
import { services } from "../../data/services";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceSignals from "./ServiceSignals.astro";
import ServiceAssessment from "./ServiceAssessment.astro";
import ServiceManifesto from "./ServiceManifesto.astro";
import ServiceAreas, { type AreaItem } from "./ServiceAreas.astro";
import RelatedServices, {
    type RelatedServiceItem,
} from "./RelatedServices.astro";
import ServiceFAQ, { type FAQItem } from "./ServiceFAQ.astro";
import ServiceCTA from "./ServiceCTA.astro";

const reportService = services.find(
    (service) => service.id === "informes-psicopedagogicos",
);

if (!reportService) {
    throw new Error(
        "No se ha encontrado el servicio de informes psicopedagógicos.",
    );
}

const situations = [
    {
        icon: School,
        text: "El colegio os solicita una valoración externa para activar medidas de apoyo.",
    },
    {
        icon: FileCheck,
        text: "Necesitáis recoger por escrito las necesidades detectadas y las recomendaciones para valorar apoyos escolares.",
    },
    {
        icon: CircleAlert,
        text: "Queréis disponer de las conclusiones de una evaluación sobre atención, aprendizaje o altas capacidades.",
    },
    {
        icon: FileSpreadsheet,
        text: "Queréis conocer si la información del informe puede aportarse a una solicitud de beca NEAE, según los requisitos de la convocatoria.",
    },
    {
        icon: ListChecks,
        text: "Contáis con un informe previo desactualizado que el centro escolar no está aplicando.",
    },
    {
        icon: Compass,
        text: "Necesitáis recoger orientaciones académicas teniendo en cuenta sus intereses, capacidades y situación educativa.",
    },
];

const perspectives = [
    {
        number: "01",
        icon: Scale,
        title: "Validez y especialización forense",
        text: "La formación en Psicología Forense aporta herramientas para una elaboración cuidadosa de informes dentro del ámbito profesional de la psicología. Su utilización en un procedimiento concreto depende de la finalidad y de los requisitos exigidos.",
    },
    {
        number: "02",
        icon: GraduationCap,
        title: "Conocimiento del sistema escolar",
        text: "La experiencia en departamentos de orientación ayuda a presentar la información en un formato útil para comprender las necesidades del alumno y valorar posibles medidas educativas.",
    },
    {
        number: "03",
        icon: HeartHandshake,
        title: "Pautas prácticas post-diagnóstico",
        text: "No entrego un informe y me despido; facilito pautas concretas para casa y coordinación directa con los tutores y el centro educativo.",
    },
];

const areas: AreaItem[] = [
    {
        icon: FileCheck,
        title: "Adaptaciones curriculares oficiales",
        description:
            "Aporta información y recomendaciones que el centro puede considerar al valorar ajustes en la metodología, las tareas o la evaluación.",
        span: "md:col-span-7",
        bgVariant: "primary",
    },
    {
        icon: Brain,
        title: "Diagnóstico diferencial clínico",
        description:
            "Recoge los resultados y las conclusiones de la evaluación sobre atención, aprendizaje o altas capacidades, señalando los límites y las cuestiones que puedan requerir más valoración.",
        span: "md:col-span-5",
        bgVariant: "sage",
    },
    {
        icon: FileSpreadsheet,
        title: "Tramitación de Becas NEAE",
        description:
            "Información que puede resultar pertinente para una solicitud de ayudas NEAE. La documentación exigida debe comprobarse en la convocatoria; el informe no sustituye otros certificados o valoraciones que puedan requerirse.",
        span: "md:col-span-4",
        bgVariant: "white",
    },
    {
        icon: Award,
        title: "Identificación de Altas Capacidades",
        description:
            "Conclusiones sobre el perfil de capacidades y sus necesidades educativas, con recomendaciones que el centro pueda valorar para el enriquecimiento curricular.",
        span: "md:col-span-4",
        bgVariant: "dusty-rose",
    },
    {
        icon: ListChecks,
        title: "Segunda opinión experta",
        description:
            "Revisión y actualización de valoraciones previas para reajustar el enfoque de la intervención educativa al momento actual.",
        span: "md:col-span-4",
        bgVariant: "primary-dark",
    },
    {
        icon: ClipboardCheck,
        title: "Pautas prácticas para el aula",
        description:
            "Guía de actuación directa para los profesores que facilita su labor y la integración escolar y académica del alumno.",
        span: "md:col-span-5",
        bgVariant: "white",
    },
    {
        icon: ArrowUpRight,
        title: "Orientación vocacional",
        description:
            "Informes detallados para ayudar al alumno a elegir su futuro académico en ESO y Bachillerato basándose en sus capacidades reales.",
        span: "md:col-span-3",
        bgVariant: "blue-soft",
    },
    {
        icon: HeartHandshake,
        title: "Coordinación con el centro",
        description:
            "Intercambio de información con el equipo educativo, cuando se acuerde y con el consentimiento correspondiente, para facilitar la comprensión de las recomendaciones y valorar su encaje en el aula.",
        span: "md:col-span-4",
        bgVariant: "sage-light",
    },
];

const relatedServicesList: RelatedServiceItem[] = [
    {
        description: "Evaluación que fundamenta las conclusiones del informe",
        href: "/evaluacion-y-diagnostico/",
    },
    {
        description: "Atención, impulsividad y autorregulación",
        href: "/tratamiento-tdah/",
    },
    {
        description: "Intervención en lectura, escritura y comprensión",
        href: "/tratamiento-dislexia/",
    },
    {
        description: "Valoración del perfil y de sus necesidades educativas",
        href: "/tratamiento-altas-capacidades/",
    },
];

const faqs: FAQItem[] = [
    {
        question:
            "¿Tiene validez oficial este informe ante los colegios e institutos?",
        answer: "Un informe externo puede aportar información profesional a colegios e institutos. Su reconocimiento para un trámite o una medida concreta depende de los requisitos aplicables y de quién deba emitir la documentación. No debe confundirse con un dictamen oficial del sistema educativo ni se puede garantizar su aceptación en cualquier procedimiento.",
    },
    {
        question:
            "¿Cuál es la diferencia entre evaluación e informe psicopedagógico?",
        answer: "La evaluación es el procedimiento clínico de sesiones donde se aplican pruebas, test y entrevistas para analizar el perfil del alumno. El informe psicopedagógico es el dictamen formal por escrito que recoge los resultados, conclusiones diagnósticas y las adaptaciones educativas recomendadas para el colegio.",
    },
    {
        question:
            "¿Sirve este informe para solicitar adaptaciones en la PAU (Selectividad)?",
        answer: "Puede aportar información sobre las dificultades y necesidades del alumno, pero no garantiza adaptaciones en la PAU. Deben comprobarse los requisitos, los plazos y la documentación exigida por los organismos responsables, junto con el equipo de orientación del centro.",
    },
    {
        question: "¿Cuánto tiempo se tarda en entregar el informe definitivo?",
        answer: "El plazo depende del alcance de la evaluación y de la información necesaria para completar el documento. La previsión de entrega y la forma de explicar las conclusiones se concretan con la familia antes de iniciar el proceso.",
    },
    {
        question: "¿Incluye el servicio coordinación directa con el colegio?",
        answer: "Sí. Tras la sesión de devolución con vosotros, facilito pautas específicas para el tutor y, con vuestra conformidad, puedo contactar directamente con el departamento de orientación del centro educativo para asegurar la correcta interpretación de las medidas propuestas.",
    },
];
---

<main class="overflow-x-clip bg-[#f7f8f6] pt-[88px]" id="servicios">
    <!-- 1. ServiceIntro -->
    <ServiceIntro
        breadcrumbLabel={reportService.shortTitle}
        eyebrow={reportService.title}
        title="¿Necesitas un documento riguroso para garantizar las adaptaciones que tu hijo necesita?"
        description="Un informe psicopedagógico recoge la evaluación realizada, sus conclusiones y las recomendaciones pertinentes. En PsicoInfantil Castellón buscamos que esta información sea comprensible para la familia y útil para el diálogo con el centro educativo, sin sustituir los procedimientos que correspondan a cada institución."
        image={reportService.heroImage}
        imageAlt={reportService.alt}
    />

    <!-- 2. ServiceSignals -->
    <ServiceSignals
        title="¿Cuándo es imprescindible contar con una valoración formal?"
        description="Puede ser útil disponer de información escrita sobre las dificultades, fortalezas y necesidades educativas. El informe permite compartir las conclusiones y recomendaciones, aunque su uso en trámites concretos depende de los requisitos establecidos."
        signals={situations}
    />

    <!-- 3. ServiceAssessment -->
    <ServiceAssessment
        id="como-trabajamos"
        title="Un informe debe ser un puente hacia soluciones, no un obstáculo burocrático"
        description="La experiencia en orientación escolar en Castellón aporta una visión del contexto educativo. El informe organiza la información relevante, explica las conclusiones y formula recomendaciones relacionadas con el motivo de la evaluación."
        perspectives={perspectives}
    />

    <!-- 4. ServiceManifesto -->
    <ServiceManifesto
        secondaryPhrase="Un informe no es solo un trámite."
        secondaryHighlight="trámite"
        mainPhrase="Es la llave legal y educativa para su bienestar."
        mainHighlight="llave legal"
        explanation="El informe ayuda a ordenar la información disponible y a comunicar las necesidades detectadas. Sus recomendaciones sirven como referencia para conversar con el colegio y valorar los apoyos, sin garantizar una medida concreta."
    />

    <!-- 5. ServiceAreas -->
    <ServiceAreas
        title="Beneficios y alcance del informe psicopedagógico"
        areas={areas}
        description="Informes psicopedagógicos que explican la evaluación, sus conclusiones y las recomendaciones educativas, con un alcance ajustado al motivo de consulta."
    />

    <!-- 6. RelatedServices -->
    <RelatedServices
        title="Servicios complementarios a la valoración formal"
        description="El informe recoge los resultados de una evaluación y orienta los siguientes pasos. Según el perfil identificado, puede facilitar apoyos específicos para TDAH, dislexia o altas capacidades."
        services={relatedServicesList}
    />

    <!-- 7. ServiceFAQ -->
    <ServiceFAQ title="Preguntas frecuentes sobre informes" faqs={faqs} />

    <!-- 8. ServiceCTA -->
    <ServiceCTA
        title="¿Necesitáis un informe técnico válido? Hablemos."
        titleUnderline="Hablemos"
        description="Tras 20 años dirigiendo departamentos de orientación en Castellón, sé que un informe riguroso es la llave para que el colegio entienda y atienda las necesidades de vuestro hijo. Escríbeme sin compromiso y tracemos la mejor solución."
        primaryCtaText="Solicitar informe oficial"
        primaryCtaHref="#contacto"
        phoneText="También puedes llamar al 614 99 21 48"
        phoneHref="tel:+34614992148"
    />
</main>
