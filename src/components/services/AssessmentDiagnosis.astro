---
import {
    ArrowUpRight,
    Award,
    Brain,
    CircleAlert,
    ClipboardCheck,
    FileCheck,
    FileText,
    GraduationCap,
    HeartHandshake,
    ListChecks,
    Scale,
    School,
} from "lucide-astro";
import { services } from "../../data/services";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceSignals from "./ServiceSignals.astro";
import ServiceAssessment from "./ServiceAssessment.astro";
import ServiceManifesto from "./ServiceManifesto.astro";
import ServiceAreas, { type AreaItem } from "./ServiceAreas.astro";
import RelatedServices, {
    type RelatedServiceItem,
} from "./RelatedServices.astro";
import ServiceFAQ, { type FAQItem } from "./ServiceFAQ.astro";
import ServiceCTA from "./ServiceCTA.astro";

const evalService = services.find(
    (service) => service.id === "evaluacion-diagnostico",
);

if (!evalService) {
    throw new Error(
        "No se ha encontrado el servicio de evaluación y diagnóstico.",
    );
}

const situations = [
    {
        icon: CircleAlert,
        text: "Sospecháis TDAH, dislexia, dificultades de aprendizaje o altas capacidades",
    },
    {
        icon: School,
        text: "El colegio os dice que le cuesta seguir el ritmo o mantener la atención",
    },
    {
        icon: Brain,
        text: "Su esfuerzo no se refleja en los resultados",
    },
    {
        icon: HeartHandshake,
        text: "Aparecen bloqueos, rechazo al colegio o mucha ansiedad ante determinadas situaciones",
    },
    {
        icon: FileText,
        text: "Necesitáis una evaluación para orientar los siguientes pasos",
    },
    {
        icon: ListChecks,
        text: "Habéis escuchado “ya madurará”, pero las dificultades siguen ahí",
    },
];

const perspectives = [
    {
        number: "01",
        icon: Scale,
        title: "Evaluación rigurosa y adaptada",
        text: "Utilizamos pruebas y herramientas de evaluación adecuadas a su edad y a las dificultades que queremos comprender.",
    },
    {
        number: "02",
        icon: GraduationCap,
        title: "Experiencia en el entorno educativo",
        text: "Más de 20 años trabajando con niños, adolescentes, familias y centros educativos permiten interpretar los resultados teniendo en cuenta también lo que ocurre en su día a día.",
    },
    {
        number: "03",
        icon: HeartHandshake,
        title: "Explicación clara y siguientes pasos",
        text: "Os explicamos qué hemos encontrado, resolvemos vuestras dudas y concretamos qué pautas, apoyos o adaptaciones pueden ayudar a partir de ese momento.",
    },
];

const areas: AreaItem[] = [
    {
        icon: Brain,
        title: "Evaluación cognitiva y neuropsicológica",
        description:
            "Estudio del perfil de inteligencia (CI), memoria de trabajo, velocidad de procesamiento y funciones ejecutivas.",
        span: "md:col-span-7",
        bgVariant: "primary",
    },
    {
        icon: FileText,
        title: "Dificultades Específicas de Aprendizaje",
        description:
            "Valoración de dificultades específicas de aprendizaje, como dislexia, discalculia o disortografía, para comprender cómo afectan a la lectura, la escritura o las matemáticas y orientar el diagnóstico.",
        span: "md:col-span-5",
        bgVariant: "sage",
    },
    {
        icon: ClipboardCheck,
        title: "Evaluación de TDAH y atención",
        description:
            "Valoración clínica de la atención sostenida, impulsividad, inquietud motora y autorregulación en el aula y el hogar.",
        span: "md:col-span-4",
        bgVariant: "white",
    },
    {
        icon: Award,
        title: "Detección de Altas Capacidades",
        description:
            "Identificación de posibles altas capacidades y talentos específicos para comprender sus necesidades educativas y orientar propuestas de enriquecimiento curricular.",
        span: "md:col-span-4",
        bgVariant: "dusty-rose",
    },
    {
        icon: FileCheck,
        title: "Base técnica para medidas escolares",
        description:
            "Fundamentación psicopedagógica para solicitar adaptaciones curriculares de acceso, evaluación o metodología.",
        span: "md:col-span-4",
        bgVariant: "primary-dark",
    },
    {
        icon: ListChecks,
        title: "Revisión y segunda opinión experta",
        description:
            "Actualización y contraste de diagnósticos previos que hayan quedado desfasados o no hayan servido para actuar.",
        span: "md:col-span-5",
        bgVariant: "white",
    },
    {
        icon: ArrowUpRight,
        title: "Orientación vocacional y académica",
        description:
            "Exploración de aptitudes, competencias e intereses para la toma de decisiones en Secundaria y Bachillerato.",
        span: "md:col-span-3",
        bgVariant: "blue-soft",
    },
    {
        icon: HeartHandshake,
        title: "Pautas de intervención familiar",
        description:
            "Estrategias realistas para que padres y madres sepáis exactamente cómo acompañar su aprendizaje en casa.",
        span: "md:col-span-4",
        bgVariant: "sage-light",
    },
];

const relatedServicesList: RelatedServiceItem[] = [
    {
        description: "Resultados y orientaciones para la familia y el colegio",
        href: "/informes-psicopedagogicos/",
    },
    {
        description: "Atención, autorregulación y apoyo educativo",
        href: "/tratamiento-tdah/",
    },
    {
        description: "Reeducación en lectura, escritura y comprensión",
        href: "/tratamiento-dislexia/",
    },
    {
        description: "Estimulación cognitiva y bienestar emocional",
        href: "/tratamiento-altas-capacidades/",
    },
];

const faqs: FAQItem[] = [
    {
        question:
            "¿Cuándo es el momento adecuado para solicitar una evaluación psicopedagógica?",
        answer: "Puede ser útil cuando el esfuerzo no se refleja en los resultados, el colegio observa dificultades persistentes de atención o aprendizaje, o aparecen bloqueos y desmotivación. Consultar permite valorar lo que ocurre y decidir si conviene evaluar, ofrecer orientación o realizar un seguimiento.",
    },
    {
        question:
            "¿Qué validez tienen las pruebas y el diagnóstico ante el colegio?",
        answer: "Los resultados pueden aportar información útil a la familia y al equipo de orientación del colegio. Su uso para solicitar medidas educativas depende del procedimiento y de los requisitos aplicables; una valoración externa no sustituye automáticamente la documentación que pueda exigir el centro o la administración.",
    },
    {
        question:
            "¿Cuántas sesiones son necesarias para completar el diagnóstico?",
        answer: "El número de sesiones depende del motivo de consulta, la edad y la información que sea necesario recoger. El proceso permite conocer la situación, valorar las dificultades y explicar las conclusiones y orientaciones a la familia. Antes de comenzar se concreta el alcance de la evaluación y, cuando corresponda, del informe.",
    },
    {
        question: "¿Habrá coordinación con el colegio o instituto de mi hijo?",
        answer: "Sí, siempre con el consentimiento de la familia. Puedo mantener contacto con el tutor o el equipo de orientación del centro escolar para contrastar datos y facilitar que las recomendaciones pedagógicas se apliquen eficazmente en el aula.",
    },
    {
        question: "¿Un diagnóstico puede etiquetar negativamente a mi hijo?",
        answer: "Es una preocupación comprensible. El diagnóstico, cuando procede, debe servir para comprender las dificultades y orientar los apoyos, no para definir al niño ni limitar sus posibilidades. Importa explicar las conclusiones con cuidado, reconocer sus fortalezas y evitar que una etiqueta sustituya la comprensión de su situación.",
    },
];
---

<main class="overflow-x-clip bg-[#f7f8f6] pt-[88px]" id="servicios">
    <!-- 1. ServiceIntro -->
    <ServiceIntro
        breadcrumbLabel={evalService.shortTitle}
        eyebrow={evalService.title}
        title="Una evaluación para poner claridad a lo que os preocupa"
        description="Cuando hay dificultades de aprendizaje, atención, organización o rendimiento, una evaluación permite mirar más allá de las notas y comprender qué puede estar interfiriendo."
        image={evalService.heroImage}
        imageAlt={evalService.alt}
    />

    <!-- 2. ServiceSignals -->
    <ServiceSignals
        title="¿Sientes que algo no encaja, pero no sabes exactamente qué está pasando?"
        description="Cuando aparecen dificultades que no terminamos de entender, es fácil empezar a hacer suposiciones. Una evaluación permite ordenar la información, identificar qué puede estar interfiriendo y tomar decisiones con más claridad."
        signals={situations}
    />

    <!-- 3. ServiceAssessment -->
    <ServiceAssessment
        id="como-trabajamos"
        title="Un diagnóstico debe ser un mapa claro para avanzar, no un laberinto de dudas"
        description="Una buena evaluación no consiste solo en obtener resultados. Se trata de comprender cómo aprende, dónde aparecen las dificultades y qué necesita para poder avanzar."
        perspectives={perspectives}
    />

    <!-- 4. ServiceManifesto -->
    <ServiceManifesto
        secondaryPhrase="Un diagnóstico
        no cambia al niño."
        secondaryHighlight="niño"
        mainPhrase="Cambia la forma de
entenderle y acompañarle."
        mainHighlight="mapa claro"
        explanation="Comprender las dificultades puede ayudar a reducir interpretaciones injustas sobre su esfuerzo y a orientar el acompañamiento familiar y escolar. La evaluación busca aportar información útil, respetando sus fortalezas y su forma de vivir lo que ocurre."
    />

    <!-- 5. ServiceAreas -->
    <ServiceAreas
        title="¿Qué valoramos en la evaluación?"
        areas={areas}
        description="La evaluación se ajusta al motivo de consulta y a la etapa evolutiva. Permite explorar las dificultades y fortalezas relacionadas con el aprendizaje y orientar los apoyos que conviene valorar."
    />

    <!-- 6. RelatedServices -->
    <RelatedServices
        title="Del diagnóstico certero a la intervención eficaz"
        description="Tras la evaluación, los resultados pueden recogerse en un informe para la familia y el colegio. Las necesidades identificadas también orientan los apoyos específicos en atención, lectura o altas capacidades."
        services={relatedServicesList}
    />

    <!-- 7. ServiceFAQ -->
    <ServiceFAQ title="Preguntas frecuentes sobre la evaluación" faqs={faqs} />

    <!-- 8. ServiceCTA -->
    <ServiceCTA
        title="Si necesitas salir de dudas de una vez por todas, hablemos."
        titleUnderline="hablemos"
        description="Cuéntame qué has observado en tu hijo y tracemos el plan de evaluación más adecuado para entender sus necesidades y proteger su futuro escolar."
        primaryCtaText="Solicitar evaluación"
        primaryCtaHref="#contacto"
        phoneText="También puedes llamar al 614 99 21 48"
        phoneHref="tel:+34614992148"
    />
</main>
