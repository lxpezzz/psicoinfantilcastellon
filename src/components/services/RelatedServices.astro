---
import { ArrowUpRight } from "lucide-astro";

export interface RelatedServiceItem {
    title: string;
    description: string;
    href: string;
}

interface Props {
    title: string;
    description: string;
    services: RelatedServiceItem[];
}

const { title, description, services } = Astro.props;
---

<section class="border-y border-[rgba(23,54,97,0.08)] bg-white py-[clamp(3.75rem,7vw,5.75rem)]">
    <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(460px,1.15fr)] lg:gap-14 xl:gap-16">
            <header class="max-w-125px">
                <h2 class="m-0 text-[clamp(2rem,3.8vw,3.4rem)] font-[750] leading-[1.06] tracking-[-0.035em] text-[var(--color-primary-dark)] [text-wrap:balance]">
                    {title}
                </h2>
                <p class="mb-0 pt-5 lg:pt-6 mt-6 text-[1.05rem] leading-[1.7] text-[var(--color-text-soft)] [text-wrap:pretty]">
                    {description}
                </p>
            </header>

            <nav class="flex flex-col divide-y divide-[rgba(23,54,97,0.1)] border-t border-[rgba(23,54,97,0.1)] lg:border-t-0" aria-label="Servicios relacionados">
                {services.map((service) => (
                    <a
                        href={service.href}
                        class="group flex min-h-[76px] items-center justify-between gap-4 py-4.5 px-2.5 -mx-2.5 rounded-[0.75rem] transition-[background-color,color] duration-200 hover:bg-[#f7f8f6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
                    >
                        <div class="flex flex-col gap-1 text-left">
                            <span class="text-[1.12rem] font-[750] text-[var(--color-primary-dark)] transition-colors duration-200 group-hover:text-[var(--color-primary)]">
                                {service.title}
                            </span>
                            <span class="text-[0.88rem] text-[var(--color-text-soft)] [text-wrap:pretty]">
                                {service.description}
                            </span>
                        </div>

                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">
                            <ArrowUpRight size={18} stroke-width={2} />
                        </span>
                    </a>
                ))}
            </nav>
        </div>
    </div>
</section>
