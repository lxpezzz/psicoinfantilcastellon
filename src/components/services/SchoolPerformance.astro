---
import { Image } from "astro:assets";
import {
    ArrowDown,
    ArrowRight,
    ArrowUpRight,
    BookOpenCheck,
    Brain,
    CalendarDays,
    CircleAlert,
    ClipboardCheck,
    FileText,
    HeartHandshake,
    ListChecks,
    Timer,
} from "lucide-astro";
import { services } from "../../data/services";

const schoolService = services.find((service) => service.id === "rendimiento-escolar");

if (!schoolService) {
    throw new Error("No se ha encontrado el servicio de rendimiento escolar.");
}

const situations = [
    { icon: HeartHandshake, text: "Se esfuerza, pero los resultados no acompañan." },
    { icon: ListChecks, text: "Pasa horas estudiando y no sabe por dónde empezar." },
    { icon: Timer, text: "Deja las tareas para el último momento." },
    { icon: CircleAlert, text: "Se bloquea especialmente ante los exámenes." },
    { icon: CalendarDays, text: "Le cuesta organizarse y llevar al día trabajos y agenda." },
    { icon: Brain, text: "Los deberes están generando frustración o conflictos en casa." },
];

const perspectives = [
    {
        icon: Brain,
        title: "Cómo aprende",
        text: "Atención, comprensión, memoria y forma de enfrentarse a las tareas.",
    },
    {
        icon: ClipboardCheck,
        title: "Cómo se organiza",
        text: "Planificación, gestión del tiempo, hábitos y técnicas de estudio.",
    },
    {
        icon: HeartHandshake,
        title: "Cómo lo está viviendo",
        text: "Motivación, frustración, confianza y respuesta ante la presión académica.",
    },
];

const areas = [
    { icon: CalendarDays, title: "Organización y planificación", span: "md:col-span-7" },
    { icon: BookOpenCheck, title: "Técnicas de estudio", span: "md:col-span-5" },
    { icon: FileText, title: "Comprensión y síntesis", span: "md:col-span-4" },
    { icon: ClipboardCheck, title: "Preparación de exámenes", span: "md:col-span-4" },
    { icon: Brain, title: "Atención y concentración", span: "md:col-span-4" },
    { icon: Timer, title: "Gestión del tiempo", span: "md:col-span-5" },
    { icon: ArrowUpRight, title: "Autonomía", span: "md:col-span-3" },
    { icon: HeartHandshake, title: "Confianza académica", span: "md:col-span-4" },
];

const relatedServices = services.filter((service) =>
    ["tdah", "dislexia", "altas-capacidades", "evaluacion-diagnostico"].includes(service.id),
);

const faqs = [
    {
        question: "¿A partir de qué edad se puede trabajar el rendimiento escolar?",
        answer: "Puede abordarse cuando las dificultades con el estudio, la organización o la autonomía empiezan a tener un peso en el día a día. El punto de partida se adapta a la etapa escolar y a lo que esté ocurriendo en cada caso.",
    },
    {
        question: "¿Es lo mismo que dar clases particulares?",
        answer: "No. El foco no es repasar una asignatura concreta, sino entender qué está dificultando el estudio y trabajar estrategias que puedan servirle de forma más autónoma.",
    },
    {
        question: "¿Trabajáis técnicas de estudio?",
        answer: "Sí, cuando son útiles para el caso. Las técnicas se integran dentro de un trabajo más amplio sobre comprensión, planificación, hábitos, atención y la forma de afrontar las tareas.",
    },
    {
        question: "¿Cuánto tiempo dura la intervención?",
        answer: "Depende de las necesidades detectadas, de los objetivos acordados y de cómo evolucione el proceso. Tras conocer el caso se puede orientar mejor cuál puede ser el siguiente paso.",
    },
    {
        question: "¿Puede haber un problema de aprendizaje aunque las notas no sean muy bajas?",
        answer: "Sí. El sobreesfuerzo, el bloqueo, la desorganización o la frustración también aportan información. Las notas son una parte del contexto, pero no explican por sí solas cómo está viviendo el aprendizaje.",
    },
];
---

<main class="overflow-x-clip bg-[#f7f8f6] pt-[88px]" id="servicios">
    <section class="relative overflow-hidden bg-[#f7f5f0]">
        <div class="absolute inset-x-0 top-0 h-px bg-[rgba(23,54,97,0.08)]" aria-hidden="true"></div>
        <div class="mx-auto grid w-[min(100%-2.5rem,1220px)] grid-cols-1 gap-12 py-[clamp(4.5rem,9vw,8.5rem)] lg:grid-cols-[minmax(0,1.02fr)_minmax(360px,0.78fr)] lg:items-center lg:gap-[clamp(3.5rem,7vw,7rem)]">
            <div class="max-w-[680px]">
                <p class="mb-5 text-[0.76rem] font-bold tracking-[0.12em] text-[var(--color-primary)]">RENDIMIENTO ESCOLAR · CASTELLÓN</p>
                <h1 class="m-0 max-w-[12ch] text-[clamp(2.8rem,5vw,5rem)] font-[750] leading-[0.98] tracking-[-0.04em] text-[var(--color-primary-dark)] [text-wrap:balance]">
                    Cuando estudiar cuesta más de lo que debería
                </h1>
                <p class="mb-0 mt-7 max-w-[60ch] text-[clamp(1.05rem,1.55vw,1.2rem)] leading-[1.7] text-[var(--color-text-soft)] [text-wrap:pretty]">
                    Hay niños y adolescentes que se esfuerzan, pasan horas delante de los apuntes y aun así no consiguen los resultados que esperan. Antes de exigirles más, conviene entender qué está dificultando su aprendizaje.
                </p>
                <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                    <a href="/#contacto" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-[0.9rem] bg-[var(--color-primary)] px-6 py-3 text-center text-[0.98rem] font-bold text-white transition-[background-color,transform] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] hover:bg-[var(--color-primary-dark)] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                        Cuéntame vuestro caso
                        <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
                    </a>
                    <a href="#como-trabajamos" class="inline-flex min-h-12 items-center justify-center gap-2 px-3 py-3 text-center text-[0.98rem] font-bold text-[var(--color-primary-dark)] underline decoration-[rgba(36,79,158,0.35)] decoration-1 underline-offset-8 transition-colors duration-200 hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                        Ver cómo trabajamos
                        <ArrowDown size={17} stroke-width={2} aria-hidden="true" />
                    </a>
                </div>
            </div>

            <div class="relative mx-auto w-full max-w-[490px] lg:mx-0 lg:justify-self-end">
                <div class="absolute -left-5 top-[12%] h-[72%] w-px bg-[var(--color-accent)]" aria-hidden="true"></div>
                <div class="relative aspect-[4/5] overflow-hidden rounded-[1.35rem] bg-[#dce6df] shadow-[0_22px_55px_-30px_rgba(23,54,97,0.42)]">
                    <Image
                        src={schoolService.image}
                        alt={schoolService.alt}
                        widths={[400, 600, 800]}
                        sizes="(max-width: 1023px) min(100vw - 40px, 490px), min(36vw, 490px)"
                        quality={85}
                        loading="eager"
                        fetchpriority="high"
                        class="h-full w-full object-cover"
                    />
                </div>
                <p class="m-0 mt-4 max-w-[32ch] text-[0.82rem] leading-[1.5] text-[var(--color-text-soft)]">
                    Entender el punto de partida ayuda a plantear un camino más realista.
                </p>
            </div>
        </div>
    </section>

    <section class="border-t border-[rgba(23,54,97,0.08)] bg-white py-[clamp(4.75rem,9vw,8rem)]">
        <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(500px,1.18fr)] lg:gap-16">
                <header class="max-w-[540px]">
                    <h2 class="m-0 text-[clamp(2.1rem,4vw,3.65rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)] [text-wrap:balance]">¿Es falta de capacidad o falta de método?</h2>
                    <p class="mb-0 mt-6 text-[1.06rem] leading-[1.7] text-[var(--color-text-soft)]">
                        Un rendimiento bajo no siempre significa falta de esfuerzo. A veces el problema está en cómo se organiza, cómo comprende la información o cómo afronta el estudio.
                    </p>
                </header>
                <ul class="m-0 grid list-none gap-x-7 divide-y divide-[rgba(23,54,97,0.1)] p-0 sm:grid-cols-2 sm:divide-y-0">
                    {situations.map(({ icon: Icon, text }, index) => (
                        <li class:list={[
                            "flex min-h-[116px] items-start gap-4 border-[rgba(23,54,97,0.1)] py-6 text-[0.98rem] font-[650] leading-[1.45] text-[var(--color-primary-dark)]",
                            index % 2 === 0 ? "sm:border-r sm:pr-7" : "sm:pl-7",
                            index < 4 ? "sm:border-b" : "",
                        ]}>
                            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]" aria-hidden="true">
                                <Icon size={19} stroke-width={1.8} />
                            </span>
                            <span class="pt-2">{text}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <section class="bg-[#eef3f0] py-[clamp(4.75rem,9vw,8rem)]" id="como-trabajamos">
        <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
            <header class="max-w-[700px]">
                <h2 class="m-0 text-[clamp(2.1rem,4vw,3.65rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)] [text-wrap:balance]">Antes de intervenir, necesitamos entender qué está pasando</h2>
                <p class="mb-0 mt-6 max-w-[60ch] text-[1.06rem] leading-[1.7] text-[var(--color-text-soft)]">No se trata solo de reunir técnicas de estudio. El punto de partida es observar qué puede estar interfiriendo y cómo encaja cada pieza.</p>
            </header>
            <div class="mt-11 grid gap-5 md:grid-cols-3">
                {perspectives.map(({ icon: Icon, title, text }) => (
                    <article class="border-t-2 border-[var(--color-primary)] pt-6">
                        <span class="grid h-11 w-11 place-items-center rounded-full bg-white text-[var(--color-primary)] shadow-[0_12px_24px_-18px_rgba(23,54,97,0.35)]" aria-hidden="true">
                            <Icon size={21} stroke-width={1.8} />
                        </span>
                        <h3 class="mb-0 mt-6 text-[1.35rem] font-[750] leading-[1.2] tracking-[-0.025em] text-[var(--color-primary-dark)]">{title}</h3>
                        <p class="mb-0 mt-3 max-w-[34ch] text-[0.98rem] leading-[1.65] text-[var(--color-text-soft)]">{text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="bg-[var(--color-primary-dark)] py-[clamp(5rem,10vw,9rem)] text-white">
        <div class="mx-auto grid w-[min(100%-2.5rem,1100px)] gap-10 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:items-end">
            <h2 class="m-0 text-[clamp(2.1rem,4vw,3.65rem)] font-[700] leading-[1.04] tracking-[-0.04em] [text-wrap:balance]">No se trata de estudiar más</h2>
            <div>
                <p class="m-0 max-w-[15ch] text-[clamp(2.35rem,5vw,4.8rem)] font-[750] leading-[0.98] tracking-[-0.045em] text-[#d9e9df] [text-wrap:balance]">Se trata de aprender a estudiar mejor.</p>
                <p class="mb-0 mt-7 max-w-[57ch] text-[1.05rem] leading-[1.7] text-[#d7e0eb]">El objetivo es que vaya adquiriendo estrategias que pueda utilizar de forma autónoma: organizarse, priorizar, comprender, preparar exámenes y gestionar mejor su tiempo.</p>
            </div>
        </div>
    </section>

    <section class="bg-[#f7f5f0] py-[clamp(4.75rem,9vw,8rem)]">
        <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
            <header class="max-w-[620px]">
                <h2 class="m-0 text-[clamp(2.1rem,4vw,3.65rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)]">Qué podemos trabajar</h2>
            </header>
            <div class="mt-10 grid grid-cols-1 gap-3 md:grid-cols-12 md:gap-4">
                {areas.map(({ icon: Icon, title, span }, index) => (
                    <article class:list={[
                        "group flex min-h-[142px] items-end justify-between gap-5 rounded-[1.1rem] p-6 transition-[transform,background-color] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-1",
                        span,
                        index === 0 ? "bg-[var(--color-primary)] text-white md:min-h-[210px]" : "",
                        index === 1 ? "bg-[#d9e8df] text-[var(--color-primary-dark)] md:min-h-[210px]" : "",
                        index === 2 ? "bg-white text-[var(--color-primary-dark)]" : "",
                        index === 3 ? "bg-[#e5d0d2] text-[var(--color-primary-dark)]" : "",
                        index === 4 ? "bg-[var(--color-primary-dark)] text-white" : "",
                        index === 5 ? "bg-white text-[var(--color-primary-dark)]" : "",
                        index === 6 ? "bg-[#dfe9f3] text-[var(--color-primary-dark)]" : "",
                        index === 7 ? "bg-[#edf0e9] text-[var(--color-primary-dark)]" : "",
                    ]}>
                        <h3 class="m-0 max-w-[14ch] text-[clamp(1.18rem,1.8vw,1.55rem)] font-[750] leading-[1.15] tracking-[-0.025em]">{title}</h3>
                        <span class:list={[
                            "grid h-10 w-10 shrink-0 place-items-center rounded-full transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-105",
                            index === 0 || index === 4 ? "bg-white/15 text-white" : "bg-white/70 text-[var(--color-primary)]",
                        ]} aria-hidden="true">
                            <Icon size={19} stroke-width={1.8} />
                        </span>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="border-y border-[rgba(23,54,97,0.08)] bg-white py-[clamp(4.75rem,9vw,8rem)]">
        <div class="mx-auto w-[min(100%-2.5rem,1220px)]">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(460px,1.25fr)] lg:gap-16">
                <header class="max-w-[500px]">
                    <h2 class="m-0 text-[clamp(2.1rem,4vw,3.65rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)] [text-wrap:balance]">Cuando el rendimiento es solo la señal</h2>
                    <p class="mb-0 mt-6 text-[1.06rem] leading-[1.7] text-[var(--color-text-soft)]">En algunos casos las dificultades escolares pueden estar relacionadas con TDAH, dislexia, altas capacidades u otras necesidades específicas. Si aparecen señales que lo indiquen, puede ser necesario valorar algo más que el método de estudio.</p>
                </header>
                <nav class="grid gap-x-7 divide-y divide-[rgba(23,54,97,0.1)]" aria-label="Servicios relacionados">
                    {relatedServices.map((service) => (
                        <a href={service.href} class="group flex min-h-16 items-center justify-between gap-4 py-4 text-[1.08rem] font-[700] text-[var(--color-primary-dark)] transition-colors duration-200 hover:text-[var(--color-primary)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]">
                            <span>{service.title.replace("Tratamiento y evaluación de ", "").replace("Evaluación y diagnóstico psicopedagógico", "Evaluación y diagnóstico")}</span>
                            <ArrowUpRight size={19} stroke-width={1.8} class="shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true" />
                        </a>
                    ))}
                </nav>
            </div>
        </div>
    </section>

    <section class="bg-[#eef3f0] py-[clamp(4.75rem,9vw,8rem)]" id="faq">
        <div class="mx-auto w-[min(100%-2.5rem,900px)]">
            <header class="max-w-[620px]">
                <h2 class="m-0 text-[clamp(2.1rem,4vw,3.4rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)]">Preguntas frecuentes</h2>
            </header>
            <div class="mt-10 divide-y divide-[rgba(23,54,97,0.14)] border-y border-[rgba(23,54,97,0.14)]">
                {faqs.map((faq, index) => (
                    <details class="group" open={index === 0}>
                        <summary class="flex min-h-[72px] cursor-pointer list-none items-center justify-between gap-5 py-5 text-[1.05rem] font-[700] leading-[1.35] text-[var(--color-primary-dark)] [&::-webkit-details-marker]:hidden">
                            <span>{faq.question}</span>
                            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white text-[var(--color-primary)] transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-open:rotate-45" aria-hidden="true">+</span>
                        </summary>
                        <div class="max-w-[68ch] pb-6 text-[0.98rem] leading-[1.7] text-[var(--color-text-soft)]">
                            <p class="m-0">{faq.answer}</p>
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="bg-[#e5d0d2] py-[clamp(4.75rem,9vw,8rem)]" id="contacto">
        <div class="mx-auto grid w-[min(100%-2.5rem,1040px)] gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
            <div class="max-w-[690px]">
                <h2 class="m-0 text-[clamp(2.15rem,4.2vw,3.9rem)] font-[750] leading-[1.04] tracking-[-0.04em] text-[var(--color-primary-dark)] [text-wrap:balance]">Si estudiar se ha convertido en una lucha, empecemos por entender por qué.</h2>
                <p class="mb-0 mt-6 max-w-[58ch] text-[1.06rem] leading-[1.7] text-[#4d5561]">Cuéntame qué está ocurriendo y valoramos juntos cuál puede ser el siguiente paso.</p>
            </div>
            <div class="flex flex-col gap-3 md:items-end">
                <a href="/#contacto" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-[0.9rem] bg-[var(--color-primary-dark)] px-6 py-3 text-center text-[0.98rem] font-bold text-white transition-[background-color,transform] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] hover:bg-[var(--color-primary)] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary-dark)]">
                    Cuéntame vuestro caso
                    <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
                </a>
                <a href="tel:+34614992148" class="inline-flex min-h-11 items-center justify-center gap-2 px-2 py-2 text-[0.96rem] font-[700] text-[var(--color-primary-dark)] underline decoration-[rgba(23,54,97,0.35)] underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary-dark)]">
                    También puedes llamar al 614 99 21 48
                </a>
            </div>
        </div>
    </section>
</main>
