---
import {
    ArrowUpRight,
    BookOpenCheck,
    Brain,
    CircleAlert,
    ClipboardCheck,
    FileCheck,
    FileText,
    GraduationCap,
    HeartHandshake,
    Laptop,
    ListChecks,
    Timer,
} from "lucide-astro";
import { services } from "../../data/services";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceSignals from "./ServiceSignals.astro";
import ServiceAssessment from "./ServiceAssessment.astro";
import ServiceManifesto from "./ServiceManifesto.astro";
import ServiceAreas, { type AreaItem } from "./ServiceAreas.astro";
import RelatedServices, {
    type RelatedServiceItem,
} from "./RelatedServices.astro";
import ServiceFAQ, { type FAQItem } from "./ServiceFAQ.astro";
import ServiceCTA from "./ServiceCTA.astro";

const dyslexiaService = services.find((service) => service.id === "dislexia");

if (!dyslexiaService) {
    throw new Error(
        "No se ha encontrado el servicio de tratamiento y evaluación de dislexia.",
    );
}

const situations = [
    {
        icon: BookOpenCheck,
        text: "Lee muy despacio, se inventa palabras, confunde letras o se salta renglones.",
    },
    {
        icon: CircleAlert,
        text: "Se cansa rápido, se frustra y evita cualquier tarea que implique leer o escribir.",
    },
    {
        icon: FileText,
        text: "Comete faltas de ortografía continuas a pesar de memorizar y repasar las reglas.",
    },
    {
        icon: Brain,
        text: "Explica perfectamente un tema hablando, pero su escritura no refleja su capacidad real.",
    },
    {
        icon: Timer,
        text: "Tarda el triple en acabar una simple ficha y los deberes se alargan hasta la noche.",
    },
    {
        icon: HeartHandshake,
        text: "Suspende exámenes porque la lectura de los enunciados le juega malas pasadas o le falta tiempo.",
    },
];

const perspectives = [
    {
        number: "01",
        icon: ClipboardCheck,
        title: "Evaluación diferencial precisa",
        text: "Valoramos la evolución de la lectura y la escritura, las dificultades observadas y su repercusión escolar para orientar el diagnóstico y los apoyos que conviene considerar.",
    },
    {
        number: "02",
        icon: Brain,
        title: "Procesamiento fonológico y ruta visual",
        text: "Según las necesidades detectadas, el trabajo puede abordar la relación entre sonidos y letras, el reconocimiento de palabras y la comprensión de lo que lee.",
    },
    {
        number: "03",
        icon: GraduationCap,
        title: "Coordinación y visión de aula",
        text: "20 años en departamentos de orientación en Castellón nos permiten asesorar al colegio para aplicar adaptaciones de acceso efectivas.",
    },
];

const areas: AreaItem[] = [
    {
        icon: BookOpenCheck,
        title: "Conciencia fonológica y decodificación",
        description:
            "Trabajo sobre la relación entre sonidos y letras y la lectura de palabras, ajustado a las dificultades detectadas.",
        span: "md:col-span-7",
        bgVariant: "primary",
    },
    {
        icon: FileText,
        title: "Comprensión lectora eficaz",
        description:
            "Apoyo para comprender el significado del texto, identificar las ideas principales y relacionar la información.",
        span: "md:col-span-5",
        bgVariant: "sage",
    },
    {
        icon: Timer,
        title: "Velocidad y fluidez lectora",
        description:
            "Trabajo sobre el ritmo y la precisión lectora, respetando el nivel de partida y sin reducir el progreso a leer más deprisa.",
        span: "md:col-span-4",
        bgVariant: "white",
    },
    {
        icon: ClipboardCheck,
        title: "Expresión escrita y ortografía",
        description:
            "Apoyo en la organización de textos y en las dificultades ortográficas, teniendo en cuenta su etapa de aprendizaje.",
        span: "md:col-span-4",
        bgVariant: "dusty-rose",
    },
    {
        icon: FileCheck,
        title: "Adaptaciones escolares en el aula",
        description:
            "Recomendaciones para que el centro valore ajustes en los materiales, las tareas y la evaluación según las dificultades de lectura y escritura.",
        span: "md:col-span-4",
        bgVariant: "primary-dark",
    },
    {
        icon: ListChecks,
        title: "Estrategias ante exámenes",
        description:
            "Orientación para comprender los enunciados, organizar las respuestas y revisar el trabajo según las necesidades del alumno.",
        span: "md:col-span-5",
        bgVariant: "white",
    },
    {
        icon: Laptop,
        title: "Herramientas digitales de apoyo",
        description:
            "Orientación sobre recursos digitales que puedan facilitar el acceso a los textos y la realización de tareas, según sus necesidades y el contexto escolar.",
        span: "md:col-span-3",
        bgVariant: "blue-soft",
    },
    {
        icon: HeartHandshake,
        title: "Confianza y autoestima académica",
        description:
            "Acompañamiento para reconocer sus fortalezas, expresar la frustración y evitar que las dificultades lectoras definan cómo se valora.",
        span: "md:col-span-4",
        bgVariant: "sage-light",
    },
];

const relatedServicesList: RelatedServiceItem[] = [
    {
        description: "Valoración de las dificultades de aprendizaje",
        href: "/evaluacion-y-diagnostico/",
    },
    {
        description: "Técnicas de estudio, organización y método",
        href: "/mejora-del-rendimiento-escolar/",
    },
    {
        description: "Resultados y recomendaciones para compartir con el colegio",
        href: "/informes-psicopedagogicos/",
    },
];

const faqs: FAQItem[] = [
    {
        question:
            "¿A qué edad se puede detectar e iniciar el tratamiento de la dislexia?",
        answer: "Pueden observarse señales de dificultad durante el aprendizaje inicial de la lectura y la escritura. La valoración tiene en cuenta la edad, la enseñanza recibida y la evolución. No es necesario esperar a un curso concreto para consultar por dificultades persistentes y valorar qué apoyos pueden ser útiles.",
    },
    {
        question: "¿La dislexia se cura o desaparece con el tiempo?",
        answer: "La dislexia es una dificultad específica del aprendizaje, no una enfermedad que se cure con un tratamiento puntual. Sus manifestaciones pueden cambiar con el tiempo. El acompañamiento y los apoyos educativos buscan facilitar la lectura, la escritura y la participación escolar; la evolución es diferente en cada persona.",
    },
    {
        question: "¿En qué se diferencia esta intervención de las clases particulares?",
        answer: "Las clases particulares suelen centrarse en contenidos de una asignatura. La intervención psicopedagógica en dislexia aborda las dificultades de lectura y escritura y su repercusión en el aprendizaje, con objetivos ajustados al alumno. Ambos apoyos pueden responder a necesidades distintas.",
    },
    {
        question: "¿Qué adaptaciones puede y debe aplicar el colegio?",
        answer: "El centro valora las medidas según las necesidades del alumno y el procedimiento aplicable. Pueden considerarse materiales accesibles, apoyos para comprender los enunciados o ajustes en la evaluación. Conviene concretarlos con el equipo de orientación.",
    },
    {
        question: "¿Cómo afecta la dislexia a la autoestima de mi hijo?",
        answer: "Las dificultades persistentes pueden generar frustración o afectar a la confianza, aunque no todos los niños lo viven igual. Reconocer su esfuerzo, explicar lo que ocurre y ajustar las expectativas puede ayudar a acompañar ese malestar.",
    },
];
---

<main class="overflow-x-clip bg-[#f7f8f6] pt-[88px]" id="servicios">
    <!-- 1. ServiceIntro -->
    <ServiceIntro
        breadcrumbLabel={dyslexiaService.shortTitle}
        eyebrow={dyslexiaService.title}
        title="Cuando leer y escribir cuesta el triple de lo que debería"
        description="La dislexia puede dificultar la lectura y la escritura sin que ello implique falta de inteligencia o de esfuerzo. En PsicoInfantil Castellón valoramos las dificultades y su impacto escolar para orientar una reeducación psicopedagógica ajustada a las necesidades de cada niño o adolescente."
        image={dyslexiaService.heroImage}
        imageAlt={dyslexiaService.alt}
    />

    <!-- 2. ServiceSignals -->
    <ServiceSignals
        title="¿Su esfuerzo infinito no se traduce en una lectura fluida?"
        description="Es agotador ver cómo tu hijo, siendo curioso e inteligente, se bloquea ante un simple texto o confunde letras una y otra vez. Si sientes que la lectura y la escritura se han convertido en una barrera que le impide demostrar todo lo que sabe, revisa si estas señales te resultan familiares:"
        signals={situations}
    />

    <!-- 3. ServiceAssessment -->
    <ServiceAssessment
        id="como-trabajamos"
        title="Atacar la raíz neurocognitiva y metodológica del problema"
        description="El acompañamiento parte de las dificultades concretas de lectura y escritura. Los objetivos se ajustan a su nivel de aprendizaje y a las exigencias escolares, teniendo en cuenta también el esfuerzo y la frustración que puedan aparecer."
        perspectives={perspectives}
    />

    <!-- 4. ServiceManifesto -->
    <ServiceManifesto
        secondaryPhrase="No se trata de leer más."
        secondaryHighlight="más"
        mainPhrase="Se trata de aprender a procesar mejor."
        mainHighlight="procesar mejor"
        explanation="Leer más no siempre responde a la dificultad concreta. El acompañamiento necesita considerar el nivel lector, el tipo de errores y la comprensión, con objetivos realistas y respetando el esfuerzo que supone cada tarea."
    />

    <!-- 5. ServiceAreas -->
    <ServiceAreas
        title="¿Qué trabajamos en la reeducación de la dislexia?"
        areas={areas}
        description="La reeducación psicopedagógica puede abordar la precisión, la fluidez, la comprensión lectora y la escritura, junto con orientaciones para el entorno escolar."
    />

    <!-- 6. RelatedServices -->
    <RelatedServices
        title="Servicios complementarios para su progreso escolar"
        description="La evaluación permite identificar las dificultades de lectura y escritura. Las estrategias de estudio y un informe psicopedagógico pueden ayudar a coordinar los apoyos con el colegio."
        services={relatedServicesList}
    />

    <!-- 7. ServiceFAQ -->
    <ServiceFAQ title="Preguntas frecuentes sobre dislexia" faqs={faqs} />

    <!-- 8. ServiceCTA -->
    <ServiceCTA
        title="¿Sientes que su esfuerzo no se refleja en sus notas? Hablemos."
        titleUnderline="Hablemos"
        description="Cuéntame vuestra situación. Si ves que la lectura se ha convertido en una tortura o evita escribir por miedo a equivocarse, estoy aquí para ayudaros a que la dislexia deje de ser un muro y vuelva a disfrutar aprendiendo."
        primaryCtaText="Solicitar valoración"
        primaryCtaHref="#contacto"
        phoneText="También puedes llamar al 614 99 21 48"
        phoneHref="tel:+34614992148"
    />
</main>
