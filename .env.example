# Identificador público de GA4. Las variables se incorporan al ejecutar el build.
PUBLIC_GA_MEASUREMENT_ID=G-WJFYNXS3TV
# Mantener false hasta validar las opciones individuales de medición mejorada,
# los enlaces y la ausencia de datos proporcionados por usuarios. Ver docs/analytics.md.
PUBLIC_GA_PRIVACY_REVIEWED=false
# Mantener false hasta aprobar la ampliación de atribución (origen saneado de
# referrers permitidos y parámetros UTM controlados de Google Business Profile).
PUBLIC_GA_ATTRIBUTION_REVIEWED=false
