RewriteEngine On

# Canonical host placeholders are resolved from src/data/site.mjs during astro build.
# Redirect the temporary Astro service URLs to the existing public URLs.
RewriteRule ^servicios/rendimiento-escolar/?$ {{CANONICAL_ORIGIN}}/mejora-del-rendimiento-escolar/ [R=301,L,NE]
RewriteRule ^servicios/evaluacion-diagnostico/?$ {{CANONICAL_ORIGIN}}/evaluacion-y-diagnostico/ [R=301,L,NE]
RewriteRule ^servicios/tdah/?$ {{CANONICAL_ORIGIN}}/tratamiento-tdah/ [R=301,L,NE]
RewriteRule ^servicios/dislexia/?$ {{CANONICAL_ORIGIN}}/tratamiento-dislexia/ [R=301,L,NE]
RewriteRule ^servicios/altas-capacidades/?$ {{CANONICAL_ORIGIN}}/tratamiento-altas-capacidades/ [R=301,L,NE]
RewriteRule ^servicios/asesoramiento-padres/?$ {{CANONICAL_ORIGIN}}/asesoramiento-a-padres/ [R=301,L,NE]
RewriteRule ^servicios/orientacion-adolescentes/?$ {{CANONICAL_ORIGIN}}/orientacion-adolescentes/ [R=301,L,NE]
RewriteRule ^servicios/psicologia-juvenil/?$ {{CANONICAL_ORIGIN}}/orientacion-adolescentes/ [R=301,L,NE]
RewriteRule ^servicios/informes-psicopedagogicos/?$ {{CANONICAL_ORIGIN}}/informes-psicopedagogicos/ [R=301,L,NE]

# Forzar HTTPS y eliminar www en una sola redireccion 301
RewriteCond %{HTTP_HOST} ^www\.psicoinfantilcastellon\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://psicoinfantilcastellon.com%{REQUEST_URI} [R=301,L,NE]